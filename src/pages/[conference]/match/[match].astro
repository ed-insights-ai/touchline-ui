---
import { site } from "../../../site.config.ts";
import Page from "../../../layouts/Page.astro";
import {
  boxScoreGaps,
  hasScore,
  loadSeason,
  matchDetailOf,
  matchSlug,
  matchesHref,
  seasonHref,
  teamPageHref,
} from "../../../lib/derive.ts";
import { homeHref } from "../../../lib/derive.ts";
import type { Fixture, MatchDetail, Season } from "../../../lib/derive.ts";
import { identityLine } from "../../../lib/programmes.ts";
import MatchTimeline from "../../../components/MatchTimeline.astro";
import PlayLedger from "../../../components/PlayLedger.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { ledgerRows } from "../../../lib/plays.ts";
import {
  type MatchState,
  metaDescription,
} from "../../../lib/matchstate.ts";
import { cardPlayer, stripOf } from "../../../lib/timeline.ts";
import {
  clockTime,
  longDate,
  matchMinute,
  monShort,
  dayOfMonth,
  stampDate,
} from "../../../lib/format.ts";

export function getStaticPaths() {
  return site.conferences.flatMap((conference) => {
    let season: Season;
    try {
      season = loadSeason(conference);
    } catch {
      return [];
    }
    return season.fixtures.fixtures.map((f) => ({
      params: { conference, match: matchSlug(f.id) },
      props: { fixtureId: f.id },
    }));
  });
}

const { conference } = Astro.params;
const { fixtureId } = Astro.props;
const season = loadSeason(conference as string);
const names = season.names;
const fixture = season.fixtures.fixtures.find((f) => f.id === fixtureId) as Fixture;
const detail: MatchDetail | null = matchDetailOf(season, fixture.id);
const scored = hasScore(fixture);

// Which of the served sides is the fixture's home team. Without it the page
// cannot say who was at home, and says so rather than guessing.
const homeIndex = detail?.home_index;
const sides =
  detail && homeIndex !== undefined
    ? { home: detail.teams[homeIndex], away: detail.teams[1 - homeIndex], homeIndex }
    : null;

type State = MatchState;
const state: State =
  fixture.status === "postponed" || fixture.status === "cancelled"
    ? "off"
    : detail && sides
      ? "played"
      : scored
        ? "score-only"
        : fixture.status === "final"
          ? "silent-final"
          : fixture.date < season.asOf
            ? "silent-past"
            : "preview";

const BADGE: Record<State, { text: string; tone: "accent" | "alert" }> = {
  played: { text: "FULL TIME", tone: "accent" },
  "score-only": { text: "FULL TIME · BOX SCORE GAP", tone: "alert" },
  "silent-final": { text: "FINAL · SCORE GAP", tone: "alert" },
  "silent-past": { text: "PAST DATE · NO RESULT PUBLISHED", tone: "alert" },
  preview: { text: "SCHEDULED", tone: "accent" },
  off: { text: fixture.status.toUpperCase(), tone: "alert" },
};
const badge = BADGE[state];

// Named in full here because a match report is a page readers arrive at
// directly, from anywhere, with no idea what three letters stand for.
const conferenceName = (
  site.conferenceNames[season.key] ?? season.fixtures.conference
).toUpperCase();
const surname = (name: string): string => {
  const parts = name.trim().split(/\s+/);
  return parts.length > 1 ? parts.slice(1).join(" ") : name;
};

// ── Everything below exists only when a box score does ──────────────────────
const scoring = (detail?.scoring ?? []).map((g) => ({ ...g, minute: matchMinute(g.time) }));
// `name` is null where the source published no identity for the caution: the
// card stands, the person does not. It stays in `cards`, so the panel's count
// and the "+ n more" disclosure still carry it.
const cards = (detail?.cards ?? [])
  .map((c) => ({ ...c, minute: matchMinute(c.time), name: cardPlayer(c.player) }))
  .sort((a, b) => (a.minute ?? 0) - (b.minute ?? 0));
const CARDS_SHOWN = 4;

// The match in one line: built from the play-by-play where one was published,
// from the scoring and cautions summaries where not. Everything about which
// mark a play becomes — and which plays are counted rather than drawn — is
// lib/timeline.ts.
const strip = detail && sides ? stripOf(detail, sides.homeIndex) : null;
const stripHasInk =
  strip !== null &&
  (strip.actionCount > 0 || strip.subCount + strip.rosterCount > 0 || strip.notes.length > 0);

const STAT_ROWS = [
  { key: "shots", label: "SHOTS" },
  { key: "sog", label: "ON TARGET" },
  { key: "saves", label: "SAVES" },
  { key: "corners", label: "CORNERS" },
  { key: "fouls", label: "FOULS" },
  { key: "offsides", label: "OFFSIDES" },
] as const;

const stats = sides
  ? STAT_ROWS.flatMap((row) => {
      const h = sides.home?.[row.key];
      const a = sides.away?.[row.key];
      if (h === undefined && a === undefined) return [];
      return [{ label: row.label, home: h ?? 0, away: a ?? 0 }];
    })
  : [];
// One scale for the whole block, so a bar's length means the same thing in
// every row.
const statMax = Math.max(1, ...stats.flatMap((r) => [r.home, r.away]));

const periodCount = Math.max(sides?.home?.periods.length ?? 0, sides?.away?.periods.length ?? 0);

// The play-by-play, as published. A match whose source printed none simply has
// no section — there is nothing withheld here to name.
const plays = detail?.plays ?? [];
const ledger = detail ? ledgerRows(detail, homeIndex) : [];
// The abbreviation column is sized to the widest abbr this match actually
// carries: "RU" and "DELTA ST" are both published forms, and a wrapped abbr
// costs the ledger its single-line rhythm.
//
// Clamped at both ends. `ch` is the width of a ZERO, and these are uppercase
// letters, so the raw count under-measures — 4ch truncated "FHSU" to "FH…".
// The floor is the column's original width and the ceiling stops a side
// served with no abbreviation from pushing the play text off the row.
const abbrChars = Math.max(4, ...(detail?.teams ?? []).map((t) => (t.abbr ?? t.name ?? "").length));
// One abbreviation per side on this page, the site's own, in the legend and
// every panel alike. The box score's served abbreviation ("TAM" for a side the
// site calls TAMIU) survives only in the play-by-play, which is the published
// sequence verbatim.
const homeAbbr = names.abbr(fixture.home);
const awayAbbr = names.abbr(fixture.away);


// "Aug 30, 21:07 UTC" — the collect's own moment, not an ISO string.
const collectedStamp = `${monShort(season.collectedAt.slice(0, 10))} ${dayOfMonth(season.collectedAt.slice(0, 10))}, ${season.collectedAt.slice(11, 16)} UTC`;

const gaps = boxScoreGaps(season);
const gapReason = gaps.find((g) => g.fixtureId === fixture.id)?.reason;

const knownRows: { label: string; value: string }[] = [
  {
    label: "DATE",
    // On a preview the kickoff is the hero's own figure; the row does not say it twice.
    value:
      state === "preview"
        ? longDate(fixture.date)
        : `${longDate(fixture.date)} · ${clockTime(fixture.time) ?? "no kickoff time published"}`,
  },
  { label: "VENUE", value: fixture.venue ?? "not published" },
  ...(state === "preview"
    ? [] // the badge says SCHEDULED; a row saying it again is noise
    : [{
    label: "STATUS",
    value:
      state === "silent-final"
        ? "Marked final on the schedule page · no score, no box score"
        : state === "silent-past"
          ? "Still listed as scheduled, with the date behind us"
          : state === "score-only"
            ? `Result published · box score not collected${gapReason ? ` — ${gapReason}` : ""}`
            : `Listed as ${fixture.status}`,
  }]),
  {
    label: "SOURCE",
    value: `${fixture.source_url ? new URL(fixture.source_url).hostname : "source not recorded"} · schedule page · last collected ${collectedStamp}`,
  },
];

const explain: Record<State, string> = {
  played: "",
  "score-only":
    "The programme published the result but no box score Touchline could reach: a box score gap. The scoreline stands; the detail behind it does not exist here.",
  "silent-final":
    "The programme's schedule marked this match finished but never entered a result: a score gap. The silence is the site's own, and it stays on the record, named.",
  "silent-past":
    "The date has passed and the programme's schedule still lists this match as scheduled. No result, no postponement, no note — the page simply has not changed.",
  preview: "",
  off: `The programme marked this match ${fixture.status}. It stays on the record rather than disappearing from it.`,
};

// Only a side with a team page somewhere gets a link; the rest read as plain
// text, with no affordance promising a page that does not exist.
const homeLink = teamPageHref(season, fixture.home);
const awayLink = teamPageHref(season, fixture.away);
const HomeSide = homeLink ? "a" : "div";
const AwaySide = awayLink ? "a" : "div";

const homeIdentity = identityLine(fixture.home);
const awayIdentity = identityLine(fixture.away);
const homeName = names.name(fixture.home);
const awayName = names.name(fixture.away);
---
<Page
  title={`Touchline — ${homeName} v ${awayName}`}
  description={metaDescription(state, {
    home: homeName,
    away: awayName,
    score: scored ? `${fixture.home_score}–${fixture.away_score}` : null,
    date: `${longDate(fixture.date)}, ${season.fixtures.season}`,
    conference: site.conferenceNames[season.key] ?? season.fixtures.conference,
    hasPlays: plays.length > 0,
    status: fixture.status,
  })}
>
  <div class="tl-page match">
    <header class="mhead">
      <div class="mhead-left">
      <a class="back" href={seasonHref(season.key)}>← SEASON</a>
      {/* The Match Centre has its own masthead rather than the site header, so
          the persistent link is repeated here in that header's own register —
          without this it would be absent from 379 of the site's 416 pages,
          which are exactly the pages a reader is on when they want the rest of
          the calendar. No arrow: this is a lateral move, not a way back. */}
      <a class="back mhead-view" href={matchesHref(season.key)}>MATCHES</a>
      </div>
      <a class="wordmark" href={homeHref()}>
        <span class="wordmark-square"></span>
        <span class="wordmark-name mword">Touchline · Match Centre</span>
      </a>
      {/* The conference alone at the right: the date is the hero's and the
          kind of match is the page's badge and marks. The wordmark is centred
          on the page, not between its neighbours (owner, 2026-09-01). */}
      <div class="mmeta">{conferenceName}</div>
    </header>

    <section class={`hero${state === "played" ? "" : " hero-quiet"}${state === "preview" ? " hero-preview" : ""}`}>
      <h1 class="vh">
        {homeName} v {awayName}, {longDate(fixture.date)} — {badge.text}
      </h1>
      <div class={`badge badge-${badge.tone}`}>{badge.text}</div>
      <div class="scoreline">
        <HomeSide class="side side-home" href={homeLink}>
          <span class="side-name">{homeName.toUpperCase()}</span>
          <span class="side-sub">{homeIdentity ?? `${names.abbr(fixture.home)} · HOME`}</span>
        </HomeSide>
        {state === "preview" ? (
          <div class="kickoff num">
            {/* Where the score will go, the kickoff: the one figure a match
                still to come has. No dashes standing in for a result. */}
            <span class="kickoff-time">{clockTime(fixture.time) ?? "TBA"}</span>
            <span class="kickoff-label">KICKOFF</span>
          </div>
        ) : (
          <div class={`figures${scored ? "" : " figures-absent"}`}>
            <span class="figure figure-home">{scored ? fixture.home_score : "—"}</span>
            <span class="figure-dash">–</span>
            <span class="figure figure-away">{scored ? fixture.away_score : "—"}</span>
          </div>
        )}
        <AwaySide class="side side-away" href={awayLink}>
          <span class="side-name">{awayName.toUpperCase()}</span>
          <span class="side-sub">{awayIdentity ?? `${names.abbr(fixture.away)} · AWAY`}</span>
        </AwaySide>
      </div>

      {state === "played" && scoring.length > 0 && (
        <div class="scorers num">
          <div class="scorers-home">
            {scoring
              .filter((g) => g.team === sides?.homeIndex)
              .map((g) => (
                <div>
                  {g.minute}′ {surname(g.scorer)}
                  {g.assist && <span class="assist"> ({surname(g.assist)})</span>}
                </div>
              ))}
          </div>
          <div class="scorers-gap"></div>
          <div class="scorers-away">
            {scoring
              .filter((g) => g.team !== sides?.homeIndex)
              .map((g) => (
                <div>
                  {g.minute}′ {surname(g.scorer)}
                  {g.assist && <span class="assist"> ({surname(g.assist)})</span>}
                </div>
              ))}
          </div>
        </div>
      )}

      {state === "played" ? (
        <div class="hero-foot num">
          {[
            stampDate(fixture.date),
            detail?.stadium ?? fixture.venue,
            detail?.attendance !== undefined ? `ATT ${detail.attendance}` : null,
          ]
            .filter(Boolean)
            .join(" · ")
            .toUpperCase()}
        </div>
      ) : state === "preview" ? (
        <div class="hero-foot num">
          {/* The played page's own foot line: the date and the venue, quiet,
              and nothing else. A preview has no table and no footnote to
              carry (owner's ruling, 2026-09-01). */}
          {[stampDate(fixture.date), fixture.venue].filter(Boolean).join(" · ").toUpperCase()}
        </div>
      ) : (
        explain[state] && <p class="hero-explain serif-italic">{explain[state]}</p>
      )}
    </section>

    {state === "played" && strip && stripHasInk && (
      <MatchTimeline
        homeAbbr={homeAbbr}
        awayAbbr={awayAbbr}
        strip={strip}
      />
    )}

    {state !== "preview" && (
    <section class={`body${state === "played" ? "" : " body-solo"}`}>
      <div class="body-main">
        {state === "played" ? (
          <>
            <h2 class="sechead">TEAM STATISTICS</h2>
            <div class="stats num">
              {stats.map((r) => (
                <div class="stat-row">
                  <span class="stat-home">{r.home}</span>
                  <span class="bar-left">
                    <i class="bar bar-home" style={`width: ${(r.home / statMax) * 100}%`}></i>
                  </span>
                  <span class="stat-label">{r.label}</span>
                  <span class="bar-right">
                    <i class="bar bar-away" style={`width: ${(r.away / statMax) * 100}%`}></i>
                  </span>
                  <span class="stat-away">{r.away}</span>
                </div>
              ))}
            </div>
          </>
        ) : (
          <>
            <h2 class="sechead">WHAT IS KNOWN</h2>
            <div class="known num">
              {knownRows.map((r) => (
                <div class="known-row">
                  <span class="known-label">{r.label}</span>
                  <span class="known-value">{r.value}</span>
                </div>
              ))}
            </div>
          </>
        )}
      </div>

      <div class="body-side">
        {state === "played" ? (
          <>
            {periodCount > 0 && (
              <div class="panel num">
                <h2 class="sechead">SCORE BY PERIOD</h2>
                <div class="periods">
                  <div class="period-head">
                    <span></span>
                    {Array.from({ length: periodCount }, (_, i) => <span>{i + 1}</span>)}
                    <span>T</span>
                  </div>
                  {[sides?.home, sides?.away].map((t, i) => (
                    <div class={`period-row${i === 1 ? " quiet" : ""}`}>
                      <span class="period-team">{i === 0 ? homeAbbr : awayAbbr}</span>
                      {Array.from({ length: periodCount }, (_, p) => <span>{t?.periods[p] ?? 0}</span>)}
                      <span class="period-total">{t?.score ?? 0}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {(sides?.home?.keepers?.length || sides?.away?.keepers?.length) && (
              <div class="panel num">
                <h2 class="sechead">GOALKEEPERS</h2>
                <div class="lines">
                  {[
                    ...(sides?.home?.keepers ?? []).map((k) => ({ k, home: true, t: sides?.home })),
                    ...(sides?.away?.keepers ?? []).map((k) => ({ k, home: false, t: sides?.away })),
                  ].map(({ k, home, t }) => (
                    <div class={`line${home ? "" : " quiet"}`}>
                      <span>{surname(k.name)} <span class="tag">{home ? homeAbbr : awayAbbr}</span></span>
                      <span class="line-val">
                        {k.saves ?? 0} sv · {k.goals_against ?? 0} ga{k.minutes !== undefined ? ` · ${k.minutes}′` : ""}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {cards.length > 0 && (
              <div class="panel num">
                <h2 class="sechead">CAUTIONS</h2>
                <div class="lines">
                  {cards.slice(0, CARDS_SHOWN).map((c) => (
                    <div class={`line line-card${c.team === sides?.homeIndex ? "" : " quiet"}`}>
                      <i class={`key key-${c.type === "red" ? "red" : "card"}`}></i>
                      <span class="card-min">{c.minute}′</span>
                      <span>
                        {c.name ? surname(c.name) : <span class="card-unnamed">no name published</span>}{" "}
                        <span class="tag">{c.team === sides?.homeIndex ? homeAbbr : awayAbbr}</span>
                      </span>
                    </div>
                  ))}
                  {cards.length > CARDS_SHOWN && (
                    <details class="disclosure rest">
                      <summary class="line-more">+ {cards.length - CARDS_SHOWN} more</summary>
                      {cards.slice(CARDS_SHOWN).map((c) => (
                        <div class={`line line-card${c.team === sides?.homeIndex ? "" : " quiet"}`}>
                          <i class={`key key-${c.type === "red" ? "red" : "card"}`}></i>
                          <span class="card-min">{c.minute}′</span>
                          <span>
                            {c.name ? surname(c.name) : <span class="card-unnamed">no name published</span>}{" "}
                            <span class="tag">{c.team === sides?.homeIndex ? homeAbbr : awayAbbr}</span>
                          </span>
                        </div>
                      ))}
                    </details>
                  )}
                </div>
              </div>
            )}

            {detail?.officials?.length ? (
              <div class="panel">
                <h2 class="sechead">OFFICIALS</h2>
                <div class="lines">
                  {detail.officials.map((o) => (
                    <div class="line quiet">
                      <span>{o}</span>
                    </div>
                  ))}
                </div>
              </div>
            ) : null}
          </>
        ) : null}
      </div>
    </section>
    )}

    {ledger.length > 0 && (
      <PlayLedger rows={ledger} playCount={plays.length} abbrChars={abbrChars} />
    )}


    <SiteFooter seasons={[season]} />
  </div>
</Page>

<style>
  .match { min-height: 100vh; padding-bottom: 36px; }

  /* The wordmark reads as the masthead it is, not as a link, so it keeps ink
     on hover the way the site header’s does. */
  .mhead .wordmark { color: var(--ink); }
  .mhead {
    height: 54px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 22px;
    border-bottom: 1px solid var(--hairline);
  }
  .mhead-left { display: flex; align-items: center; justify-self: start; }
  .mhead .wordmark { justify-self: center; }
  .mmeta { justify-self: end; }
  .back { font-size: 12px; letter-spacing: 0.1em; color: var(--quiet); }
  .mhead-view { padding-left: 15px; margin-left: 15px; border-left: 1px solid var(--hairline); }
  .back:hover { color: var(--ink); }
  .mword { font-size: 19px; }
  .mmeta { font-size: 11px; letter-spacing: 0.14em; color: var(--quiet); }

  /* ── Hero ───────────────────────────────────────────────────────────────── */
  .hero {
    padding: 30px 0 24px;
    display: flex; flex-direction: column; align-items: center; gap: 13px;
  }
  .hero-quiet { padding: 34px 0 28px; gap: 14px; border-bottom: 1px solid var(--hairline); }
  /* A preview is the hero and nothing under it, so the footer's rule closes
     the page and the hero does not draw one of its own. */
  .hero-preview { border-bottom: none; padding-bottom: 40px; }
  .badge {
    font-size: 10.5px; letter-spacing: 0.24em; font-weight: 600;
    padding: 4px 12px; border-radius: 3px; border: 1px solid;
  }
  .badge-accent { color: var(--accent); border-color: var(--accent-border); }
  .badge-alert { color: var(--loss); border-color: var(--alert-border); }

  .scoreline { display: flex; align-items: center; gap: 48px; }
  .side { display: flex; flex-direction: column; gap: 6px; width: 380px; color: inherit; }
  .side-home { align-items: flex-end; text-align: right; }
  .side-name { font-size: 24px; font-weight: 600; letter-spacing: 0.04em; }
  .side-away .side-name { color: var(--muted-side); }
  .side-sub { font-size: 11.5px; letter-spacing: 0.1em; color: var(--quiet); text-transform: uppercase; }
  a.side:hover .side-name { color: var(--accent); }

  .figures {
    display: flex; align-items: baseline; gap: 20px;
    font-family: var(--serif); font-weight: 500; font-variant-numeric: tabular-nums;
  }
  .figure { font-size: 104px; line-height: 1; }
  .figure-home { color: var(--figure-strong); }
  .figure-away { color: var(--muted-mark); }
  /* Centred on the figures, not baseline-aligned with them: at a fifth of
     their size a baseline dash read as an underscore (owner, 2026-09-01). */
  .figure-dash { font-size: 40px; color: var(--outline-quiet); align-self: center; }
  .figures-absent .figure { font-size: 84px; color: var(--outline-quiet); }
  .figures-absent .figure-dash { color: var(--dash); }
  .kickoff { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 148px; }
  .kickoff-time { font-family: var(--serif); font-weight: 500; font-size: 40px; line-height: 1; color: var(--secondary); white-space: nowrap; }
  .kickoff-label { font-size: 10px; letter-spacing: 0.24em; font-weight: 600; color: var(--quiet); }

  .scorers { display: flex; gap: 64px; }
  .scorers-home { display: flex; flex-direction: column; gap: 4px; align-items: flex-end; width: 380px; font-size: 13px; color: var(--secondary); }
  .scorers-gap { width: 148px; }
  .scorers-away { display: flex; flex-direction: column; gap: 4px; width: 380px; font-size: 13px; color: var(--quiet); }
  .assist { color: var(--quiet); }
  .hero-foot { font-size: 12px; letter-spacing: 0.08em; color: var(--quiet); }
  .hero-explain {
    font-size: 15px; color: var(--secondary); max-width: 640px;
    text-align: center; line-height: 1.5; margin: 0;
  }

  .body {
    display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 56px;
    padding: 22px 0; flex: 1; min-height: 0;
  }
  /* With no box score there are no side panels, so the page stops reserving a
     column for them. WHAT IS KNOWN is a short label/value table and does not
     want the full measure either. */
  .body-solo { grid-template-columns: minmax(0, 1fr); }
  /* The column carries the cap, not the table inside it, so the rule under the
     heading ends where the rows end. */
  .body-solo .body-main { max-width: 620px; }
  .body-main, .body-side { display: flex; flex-direction: column; }
  .body-side { gap: 20px; }
  .panel { display: flex; flex-direction: column; gap: 8px; }

  .stats { display: flex; flex-direction: column; }
  .stat-row {
    display: grid; grid-template-columns: 44px 1fr 120px 1fr 44px;
    gap: 14px; align-items: center; padding: 9px 0;
    border-top: 1px solid var(--hairline-soft);
  }
  .stat-row:last-child { border-bottom: 1px solid var(--hairline-soft); }
  .stat-home { font-size: 14px; font-weight: 600; text-align: right; }
  .stat-away { font-size: 14px; font-weight: 600; }
  .stat-label { font-size: 10.5px; letter-spacing: 0.14em; color: var(--quiet); text-align: center; }
