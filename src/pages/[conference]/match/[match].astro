  a.stage-link.stage-ncaa:hover { background: var(--accent); color: var(--paper); }
  .hero-source { margin: -4px 0 0; }
  .hero-source a { color: var(--quiet); }
  .hero-source a:hover { color: var(--accent); }

  .timeline-wrap { position: relative; }
  /* On the caption line at the timeline's foot, opposite the hint. */
