---
import { site } from "../../../site.config.ts";
import Page from "../../../layouts/Page.astro";
import {
  aboutHref,
  boxScoreGaps,
  championshipHref,
  hasScore,
  isDisputed,
  isForfeit,
  lastLooked,
  loadSeason,
  markOf,
  matchDetailOf,
  matchSlug,
  teamPageHref,
} from "../../../lib/derive.ts";
import type { Fixture, MatchDetail, Season } from "../../../lib/derive.ts";
import { shortStamp } from "../../../lib/freshness.ts";
import { identityLine } from "../../../lib/programmes.ts";
import MatchLineups from "../../../components/MatchLineups.astro";
import MatchSides from "../../../components/MatchSides.astro";
import MatchTimeline from "../../../components/MatchTimeline.astro";
import PersonLink from "../../../components/PersonLink.astro";
import PlayLedger from "../../../components/PlayLedger.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { ledgerRows } from "../../../lib/plays.ts";
import {
  disputedNote,
  forfeitNote,
  type MatchState,
  metaDescription,
  oneSourceNote,
} from "../../../lib/matchstate.ts";
import {
  disputedFinals,
  matchIdentity,
  oneSidedFinals,
  postedSide,
  unpostedSides,
} from "../../../lib/division.ts";
import { homeSeasons } from "../../../lib/home.ts";
import { divisionPostseason } from "../../../lib/postseason-division.ts";
import { canonicalFixture, knownProgrammes, stageTag, tieAnchor } from "../../../lib/postseason.ts";
import {
  boxScoreHost,
  boxScorePublisher,
  entryOf,
  lineByName,
  lineupOf,
  meetingsOf,
  memberSeasonOf,
  type Named,
  routeOf,
  sheetIndex,
  sideSummary,
} from "../../../lib/preview.ts";
import { cardPlayer, stripOf } from "../../../lib/timeline.ts";
import { divisionMatchOf } from "../../../lib/kickoff-division.ts";
import { kickoffCall, kickoffNote } from "../../../lib/schedule.ts";
import {
  clockTime,
  longDate,
  matchMinute,
  stampDate,
  statusWord,
} from "../../../lib/format.ts";

export function getStaticPaths() {
  return site.conferences.flatMap((conference) => {
    let season: Season;
    try {
      season = loadSeason(conference);
    } catch {
      return [];
    }
    return season.fixtures.fixtures.map((f) => ({
      params: { conference, match: matchSlug(f.id) },
      props: { fixtureId: f.id },
    }));
  });
}

const { conference } = Astro.params;
const { fixtureId } = Astro.props;
const season = loadSeason(conference as string);
const names = season.names;
// A schedule that prefixes an opponent with its national ranking
// ("15-ashland") names a programme the site follows; read it as that
// programme, the way the bracket does (postseason.ts canonicalSlug), so this
// page never calls a collected side uncollected. The data stays as published.
const rawFixture = season.fixtures.fixtures.find((f) => f.id === fixtureId) as Fixture;
const fixture = canonicalFixture(rawFixture, knownProgrammes(homeSeasons()));
const detail: MatchDetail | null = matchDetailOf(season, fixture.id);
const scored = hasScore(fixture);

// Which of the served sides is the fixture's home team. Without it the page
// cannot say who was at home, and says so rather than guessing.
const homeIndex = detail?.home_index;
const sides =
  detail && homeIndex !== undefined
    ? { home: detail.teams[homeIndex], away: detail.teams[1 - homeIndex], homeIndex }
    : null;

type State = MatchState;
const state: State =
  fixture.status === "postponed" || fixture.status === "cancelled"
    ? "off"
    : detail && sides
      ? "played"
      : scored
        ? "score-only"
        : fixture.status === "final"
          ? "silent-final"
          : fixture.date < season.asOf
            ? "silent-past"
            : "preview";

const BADGE: Record<State, { text: string; tone: "accent" | "alert" }> = {
  played: { text: "FULL TIME", tone: "accent" },
  "score-only": { text: "FULL TIME · BOX SCORE GAP", tone: "alert" },
  "silent-final": { text: "FINAL · SCORE GAP", tone: "alert" },
  "silent-past": { text: "PAST DATE · NO RESULT PUBLISHED", tone: "alert" },
  preview: { text: "SCHEDULED", tone: "accent" },
  off: { text: statusWord(fixture.status).toUpperCase(), tone: "alert" },
};
const badge = BADGE[state];

const surname = (name: string): string => {
  const parts = name.trim().split(/\s+/);
  return parts.length > 1 ? parts.slice(1).join(" ") : name;
};

// ── Everything below exists only when a box score does ──────────────────────
const scoring = (detail?.scoring ?? []).map((g) => ({ ...g, minute: matchMinute(g.time) }));
// `name` is null where the source published no identity for the caution: the
// card stands, the person does not. It stays in `cards`, so the panel's count
// and the "+ n more" disclosure still carry it.
//
// A sending-off leads the panel, ahead of the cautions, so the one card that
// changed the match is never folded behind "+ n more" (council, round 2). The
// box score types a card yellow or red and nothing finer: a second yellow is
// not told apart from a first, so the panel does not try.
const isRed = (c: { type: string }): boolean => c.type === "red";
const cards = (detail?.cards ?? [])
  .map((c) => ({ ...c, minute: matchMinute(c.time), name: cardPlayer(c.player) }))
  .sort((a, b) => Number(isRed(b)) - Number(isRed(a)) || (a.minute ?? 0) - (b.minute ?? 0));
const reds = cards.filter(isRed);
const CARDS_SHOWN = Math.max(4, reds.length);

// The match in one line: built from the play-by-play where one was published,
// from the scoring and cautions summaries where not. Everything about which
// mark a play becomes — and which plays are counted rather than drawn — is
// lib/timeline.ts.
const strip = detail && sides ? stripOf(detail, sides.homeIndex) : null;
const stripHasInk =
  strip !== null &&
  (strip.actionCount > 0 || strip.subCount + strip.rosterCount > 0 || strip.notes.length > 0);

const STAT_ROWS = [
  { key: "shots", label: "SHOTS" },
  { key: "sog", label: "ON TARGET" },
  { key: "saves", label: "SAVES" },
  { key: "corners", label: "CORNERS" },
  { key: "fouls", label: "FOULS" },
  { key: "offsides", label: "OFFSIDES" },
] as const;

const stats = sides
  ? STAT_ROWS.flatMap((row) => {
      const h = sides.home?.[row.key];
      const a = sides.away?.[row.key];
      if (h === undefined && a === undefined) return [];
      return [{ label: row.label, home: h ?? 0, away: a ?? 0 }];
    })
  : [];
// One scale for the whole block, so a bar's length means the same thing in
// every row.
const statMax = Math.max(1, ...stats.flatMap((r) => [r.home, r.away]));

const periodCount = Math.max(sides?.home?.periods.length ?? 0, sides?.away?.periods.length ?? 0);

// The play-by-play, as published. A match whose source printed none simply has
// no section — there is nothing withheld here to name.
const plays = detail?.plays ?? [];
const ledger = detail ? ledgerRows(detail, homeIndex) : [];
// The abbreviation column is sized to the widest abbr this match actually
// carries: "RU" and "DELTA ST" are both published forms, and a wrapped abbr
// costs the ledger its single-line rhythm.
//
// Clamped at both ends. `ch` is the width of a ZERO, and these are uppercase
// letters, so the raw count under-measures — 4ch truncated "FHSU" to "FH…".
// The floor is the column's original width and the ceiling stops a side
// served with no abbreviation from pushing the play text off the row.
const abbrChars = Math.max(4, ...(detail?.teams ?? []).map((t) => (t.abbr ?? t.name ?? "").length));
// One abbreviation per side on this page, the site's own, in the legend and
// every panel alike. The box score's served abbreviation ("TAM" for a side the
// site calls TAMIU) survives only in the play-by-play, which is the published
// sequence verbatim.
const homeAbbr = names.abbr(fixture.home);
const awayAbbr = names.abbr(fixture.away);


// "Aug 30, 21:07 UTC" — the collect's own moment, not an ISO string.
const looked = lastLooked(season);
const collectedStamp = shortStamp(looked);

const gaps = boxScoreGaps(season);
const gapReason = gaps.find((g) => g.fixtureId === fixture.id)?.reason;

// A match between two of the conferences the site follows is in two files,
// and for a night one of them can hold the score while the other still lists
// the match as scheduled. The fold (lib/division.ts) takes the score; this
// page says, in the same quiet register as the gap notes, that it stands on
// one source — on both pages, because a reader on the unposted side is owed
// the fact that the score exists.
const twin = oneSidedFinals(homeSeasons()).find((m) => m.identity === matchIdentity(rawFixture));
const oneSource = twin
  ? oneSourceNote(twin.key === season.key && twin.fixture.id === fixture.id ? "posted" : "unposted", {
      posted: postedSide(twin).name,
      unposted: unpostedSides(twin)
        .map((u) => u.name)
        .join(" and "),
    })
  : null;

// A score that is not the whole result. A forfeit is the award, named under
// the figures with the side it went to; a disputed match is two sources
// printing two scores, both named with their sources. The mark beside the
// figures is the same word every other surface prints (derive.ts markOf).
const forfeit = isForfeit(fixture);
const disputed = isDisputed(season, fixture);
const mark = markOf(season, fixture);
const disputedTwin = disputed
  ? disputedFinals(homeSeasons()).find((m) => m.identity === matchIdentity(fixture))
  : undefined;
const resultNote = disputedTwin
  ? disputedNote({ home: names.name(fixture.home), away: names.name(fixture.away) }, disputedTwin.scores)
  : forfeit
    ? forfeitNote(names.name(fixture.forfeit === "home" ? fixture.home : fixture.away))
    : null;

// The kickoff. A match between two programmes the site follows is in two
// files, and the two schedule pages can print it at different times (each in
// its own local time, say). Then the host's page is printed — the home side's
// own record, none at a neutral ground — and the other is named beside it, as
// the tie sheet does (schedule.ts kickoffCall), so this page and the bracket
// never print two times for one match without saying why.
const kickoffDisagreement = (() => {
  const m = divisionMatchOf(matchIdentity(fixture));
  return m ? kickoffCall(m) : null;
})();
const kickoffClock = clockTime(
  kickoffDisagreement ? (kickoffDisagreement.printed.time ?? undefined) : fixture.time,
);
const kickoffSaid = kickoffDisagreement
  ? kickoffNote(kickoffDisagreement, (slug) => names.name(slug))
  : null;

// The SOURCE row's stamp is read from the build's freshness.js (`stamp`), not
// printed: it moves on every collect while the match does not, and printed it
// made this page a new file every day (SiteFooter `shared` says the same).
const knownRows: { label: string; value: string; stamp?: string }[] = [
  {
    label: "DATE",
    // On a preview the kickoff is the hero's own figure; the row does not say it twice.
    value:
      state === "preview"
        ? longDate(fixture.date)
        : `${longDate(fixture.date)} · ${kickoffClock ?? "no kickoff time published"}${
            kickoffSaid ? ` (${kickoffSaid.charAt(0).toLowerCase()}${kickoffSaid.slice(1, -1)})` : ""
          }`,
  },
  { label: "VENUE", value: fixture.venue ?? "not published" },
  ...(state === "preview"
    ? [] // the badge says SCHEDULED; a row saying it again is noise
    : [{
    label: "STATUS",
    value:
      state === "silent-final"
        ? "Marked final on the schedule page · no score, no box score"
        : state === "silent-past"
          ? "Still listed as scheduled, with the date behind us"
          : state === "score-only"
            ? forfeit
              ? "Result by forfeit · no box score, because no match was played"
              : `Result published · box score not collected${gapReason ? ` — ${gapReason}` : ""}`
            : `Listed as ${statusWord(fixture.status)}`,
  }]),
  {
    label: "SOURCE",
    value: `${fixture.source_url ? new URL(fixture.source_url).hostname : "source not recorded"} · schedule page · last collected `,
    stamp: collectedStamp,
  },
];

const explain: Record<State, string> = {
  played: "",
  // A forfeit has no box score to be missing; the note under the figures
  // says what the result is instead.
  "score-only": forfeit
    ? ""
    : "The program published the result but no box score Touchline could reach: a box score gap. The scoreline stands; the detail behind it does not exist here.",
  "silent-final":
    "The program's schedule marked this match finished but never entered a result: a score gap. The silence is the site's own, and it stays on the record, named.",
  "silent-past":
    "The date has passed and the program's schedule still lists this match as scheduled. No result, no postponement, no note — the page simply has not changed.",
  preview: "",
  off: `The program marked this match ${statusWord(fixture.status)}. It stays on the record rather than disappearing from it.`,
};

// Only a side with a team page somewhere gets a link; the rest read as plain
// text, with no affordance promising a page that does not exist.
const homeLink = teamPageHref(season, fixture.home);
const awayLink = teamPageHref(season, fixture.away);
const HomeSide = homeLink ? "a" : "div";
const AwaySide = awayLink ? "a" : "div";

const homeIdentity = identityLine(fixture.home);
const awayIdentity = identityLine(fixture.away);
const homeName = names.name(fixture.home);

// A postseason match names its round beside the badge, and a shootout is
// said in words under the score, which stays the draw. The tie is the fold
// of every record of this match, so a shootout another programme's page
// published still reaches this one; its counts are read by side, since the
// tie may be told from the other record's orientation. A tie whose records
// disagree claims nothing. Where a page printed a shootout and named no
// winner, the text prints as published and nobody is said to have won.
const postseason = divisionPostseason();
const tie = postseason.byIdentity.get(matchIdentity(fixture));
const stage = stageTag(postseason, matchIdentity(fixture));
const shootout = tie && !tie.disputed ? tie.shootout : null;
const pensOf = (slug: string): number | null =>
  shootout && tie ? (slug === tie.fixture.home ? shootout.home : shootout.away) : null;
const shootoutLine = (() => {
  if (!shootout) return null;
  const loser = shootout.winner === fixture.home ? fixture.away : fixture.home;
  return `${names.name(shootout.winner)} won ${pensOf(shootout.winner)}–${pensOf(loser)} on penalties`;
})();
const publishedShootout =
  !shootout && !tie?.disputed ? (tie?.resultPublished ?? fixture.result_published ?? null) : null;
const awayName = names.name(fixture.away);

// Every tie has a sheet on the championship page (championship.astro draws
// one per tie), so the round chip opens it.
const tieHref = tie ? `${championshipHref()}#${tieAnchor(tie)}` : null;

// ── The player sheets a name may link to ────────────────────────────────────
// A sheet exists only on a team page, and only for a player on that page's
// roster: the member season the team page is built from is the one searched,
// and anything it cannot find stays plain text.
const division = homeSeasons();
const rosterSheet = (slug: string) => {
  const ms = memberSeasonOf(division, slug);
  return ms && teamPageHref(season, slug) ? sheetIndex(slug, ms.rosters?.rosters[slug]?.players ?? []) : null;
};
const sheetLinker = (slug: string) => {
  const team = teamPageHref(season, slug);
  const find = rosterSheet(slug);
  return (who: Named): string | null => {
    const anchor = team && find ? find(who) : null;
    return anchor ? `${team}#${anchor}` : null;
  };
};
const homeSheet = sheetLinker(fixture.home);
const awaySheet = sheetLinker(fixture.away);
// A box-score side by its index, as the scoring and cautions name it.
const sheetOfTeam = (index: number | undefined) => (index === sides?.homeIndex ? homeSheet : awaySheet);
const scorerHref = (name: string, index: number | undefined): string | null =>
  sheetOfTeam(index)(lineByName(index === undefined ? undefined : detail?.teams[index], name) ?? { name });

// ── Played: who published the box score, and each side's lineup ─────────────
const publisher = detail ? boxScorePublisher(division, detail.source_url) : null;
const publishedHost = detail ? boxScoreHost(detail.source_url) : null;
const lineupSides =
  state === "played" && sides
    ? [
        { abbr: homeAbbr, name: homeName, home: true, lineup: lineupOf(sides.home), sheetHref: homeSheet },
        { abbr: awayAbbr, name: awayName, home: false, lineup: lineupOf(sides.away), sheetHref: awaySheet },
      ]
    : [];
const hasLineups = lineupSides.some(
  (l) => l.lineup.starters.length + l.lineup.substitutes.length + l.lineup.unmarked.length > 0,
);

// ── Preview: the sides so far ───────────────────────────────────────────────
const previewSides =
  state === "preview"
    ? [fixture.home, fixture.away].map((slug) => {
        const ms = memberSeasonOf(division, slug);
        return {
          slug,
          name: names.name(slug),
          // A neutral site names no home side, so the tag doesn't either;
          // the published order stays in the column order.
          where: fixture.neutral ? "NEUTRAL SITE" : slug === fixture.home ? "HOME" : "AWAY",
          href: teamPageHref(season, slug),
          summary: ms ? sideSummary(ms, slug) : null,
          route: routeOf(postseason, slug, fixture).map((r) => ({
            ...r,
            opponentName: r.tie.match.season.names.name(r.opponent),
          })),
          sheet: rosterSheet(slug),
          entry: entryOf(postseason, ms, slug, fixture),
        };
      })
    : [];
const meetings =
  state === "preview"
    ? meetingsOf(season, fixture.home, fixture.away, fixture).map((m) => ({
        fixture: m.fixture,
        href: m.href,
        mark: m.mark,
        home: names.name(m.fixture.home),
        away: names.name(m.fixture.away),
      }))
    : [];
---
<Page
  title={`Touchline — ${homeName} v ${awayName}`}
  description={metaDescription(state, {
    home: homeName,
    away: awayName,
    score: scored ? `${fixture.home_score}–${fixture.away_score}` : null,
    mark,
    date: `${longDate(fixture.date)}, ${season.fixtures.season}`,
    conference: site.conferenceNames[season.key] ?? season.fixtures.conference,
    hasPlays: plays.length > 0,
    status: fixture.status,
  })}
>
  <div class="tl-page match">
    {/* The shared header (tl-3rlo): the conference's full name, the two menus
        and the Overview / Matches nav, on the page a reader most often lands
        on from anywhere — the Match Centre used to draw its own masthead with
        a Season/Matches pair, and named the conference at the right. */}
    <SiteHeader season={season} />

    <section class={`hero${state === "played" ? "" : " hero-quiet"}${state === "preview" ? " hero-preview" : ""}`}>
      <h1 class="vh">
        {homeName} v {awayName}, {longDate(fixture.date)} — {badge.text}
      </h1>
      <div class={`badge badge-${badge.tone}`}>{badge.text}</div>
      {stage &&
        (tieHref ? (
          <a
            class:list={["stage", "stage-link", `stage-${stage.competition}`]}
            href={tieHref}
            aria-label={`${stage.text.trim()}: open the tie sheet`}
          >
            {stage.text.trim()}
          </a>
        ) : (
          <div class:list={["stage", `stage-${stage.competition}`]}>{stage.text.trim()}</div>
        ))}
      <div class="scoreline">
        <HomeSide class="side side-home" href={homeLink}>
          <span class="side-name">{homeName.toUpperCase()}</span>
          <span class="side-sub">{homeIdentity ?? `${names.abbr(fixture.home)}${fixture.neutral ? "" : " · HOME"}`}</span>
        </HomeSide>
        {state === "preview" ? (
          <div class="kickoff num">
            {/* Where the score will go, the kickoff: the one figure a match
                still to come has. No dashes standing in for a result. */}
            <span class="kickoff-time">{kickoffClock ?? "TBA"}</span>
            <span class="kickoff-label">KICKOFF</span>
          </div>
        ) : (
          <div class={`figures${scored ? "" : " figures-absent"}`}>
            <span class="figure figure-home">{scored ? fixture.home_score : "—"}</span>
            <span class="figure-dash">–</span>
            <span class="figure figure-away">{scored ? fixture.away_score : "—"}</span>
            {mark && <span class="figure-mark label">{mark}</span>}
          </div>
        )}
        <AwaySide class="side side-away" href={awayLink}>
          <span class="side-name">{awayName.toUpperCase()}</span>
          <span class="side-sub">{awayIdentity ?? `${names.abbr(fixture.away)}${fixture.neutral ? "" : " · AWAY"}`}</span>
        </AwaySide>
      </div>

      {state === "played" && (scoring.length > 0 || reds.length > 0) && (
        <div class="scorers num">
          <div class="scorers-home">
            {scoring
              .filter((g) => g.team === sides?.homeIndex)
              .map((g) => (
                <div>
                  {g.minute}′ <PersonLink href={scorerHref(g.scorer, g.team)}>{surname(g.scorer)}</PersonLink>
                  {g.assist && (
                    <span class="assist">
                      {" "}(<PersonLink href={scorerHref(g.assist, g.team)}>{surname(g.assist)}</PersonLink>)
                    </span>
                  )}
                </div>
              ))}
            {reds
              .filter((c) => c.team !== undefined && c.team === sides?.homeIndex)
              .map((c) => (
                <div class="sent-off">
                  <i class="key key-red" aria-hidden="true"></i>
                  <span>
                    {c.minute}′{" "}
                    {c.name ? (
                      <PersonLink href={scorerHref(c.name, c.team)}>{surname(c.name)}</PersonLink>
                    ) : (
                      <span class="card-unnamed">no name published</span>
                    )}
                    <span class="sent-off-word"> · sent off</span>
                  </span>
                </div>
              ))}
          </div>
          <div class="scorers-gap"></div>
          <div class="scorers-away">
            {scoring
              .filter((g) => g.team !== sides?.homeIndex)
              .map((g) => (
                <div>
                  {g.minute}′ <PersonLink href={scorerHref(g.scorer, g.team)}>{surname(g.scorer)}</PersonLink>
                  {g.assist && (
                    <span class="assist">
                      {" "}(<PersonLink href={scorerHref(g.assist, g.team)}>{surname(g.assist)}</PersonLink>)
                    </span>
                  )}
                </div>
              ))}
            {reds
              .filter((c) => c.team !== undefined && c.team !== sides?.homeIndex)
              .map((c) => (
                <div class="sent-off">
                  <i class="key key-red" aria-hidden="true"></i>
                  <span>
                    {c.minute}′{" "}
                    {c.name ? (
                      <PersonLink href={scorerHref(c.name, c.team)}>{surname(c.name)}</PersonLink>
                    ) : (
                      <span class="card-unnamed">no name published</span>
                    )}
                    <span class="sent-off-word"> · sent off</span>
                  </span>
                </div>
              ))}
          </div>
        </div>
      )}

      {state === "played" ? (
        <>
        <div class="hero-foot num">
          {[
            stampDate(fixture.date),
            detail?.stadium ?? fixture.venue,
            detail?.attendance !== undefined ? `ATT ${detail.attendance}` : null,
          ]
            .filter(Boolean)
            .join(" · ")
            .toUpperCase()}
        </div>
        {detail && (
          <p class="provenance hero-source">
            <a href={detail.source_url} rel="noopener external">
              {publisher
                ? `From ${publisher.name}'s published box score`
                : `From the box score published at ${publishedHost ?? "the program's site"}`}
              <span aria-hidden="true"> ↗</span>
            </a>
          </p>
        )}
        </>
      ) : state === "preview" ? (
        <>
        <div class="hero-foot num">
          {/* The played page's own foot line: the date and the venue, quiet,
              and nothing else. A preview has no table and no footnote to
              carry (owner's ruling, 2026-09-01). */}
          {[stampDate(fixture.date), fixture.venue].filter(Boolean).join(" · ").toUpperCase()}
        </div>
        {kickoffSaid && <p class="hero-explain serif-italic">{kickoffSaid}</p>}
        </>
      ) : (
        explain[state] && <p class="hero-explain serif-italic">{explain[state]}</p>
      )}
      {shootoutLine && <p class="shootout num">{shootoutLine.toUpperCase()}</p>}
      {publishedShootout && (
        <p class="hero-explain serif-italic">
          Decided on penalties. As published: "{publishedShootout}". The page names no winner, so
          Touchline does not say who went through.
        </p>
      )}
      {resultNote && <p class="hero-explain serif-italic">{resultNote}</p>}
      {oneSource && <p class="hero-explain serif-italic">{oneSource}</p>}
    </section>

    {state === "played" && strip && stripHasInk && (
      <div class="timeline-wrap">
        <MatchTimeline
          homeAbbr={homeAbbr}
          awayAbbr={awayAbbr}
          strip={strip}
        />
        {/* The timeline is the match at a glance; the published sequence it
            is drawn from sits folded at the foot of the page. The link jumps
            there without script and opens it with. */}
        {ledger.length > 0 && (
          <a class="read-events" href="#play-by-play" data-opens-ledger>
            Read the event list{" "}<span aria-hidden="true">↓</span>
          </a>
        )}
      </div>
    )}

    {state === "preview" && (
      <MatchSides sides={previewSides} meetings={meetings} tieHref={tieHref} />
    )}

    {state !== "preview" && (
    <section class={`body${state === "played" ? "" : " body-solo"}`}>
      <div class="body-main">
        {state === "played" ? (
          <>
            <div class="stats-block">
            <h2 class="sechead">TEAM STATISTICS</h2>
            <div class="stats num">
              {stats.map((r) => (
                <div class="stat-row">
                  <span class="stat-home">{r.home}</span>
                  <span class="bar-left">
                    <i class="bar bar-home" style={`width: ${(r.home / statMax) * 100}%`}></i>
                  </span>
                  <span class="stat-label">{r.label}</span>
                  <span class="bar-right">
                    <i class="bar bar-away" style={`width: ${(r.away / statMax) * 100}%`}></i>
                  </span>
                  <span class="stat-away">{r.away}</span>
                </div>
              ))}
            </div>
            </div>
            {hasLineups && (
              <div class="lineups-slot">
                <MatchLineups sides={lineupSides} />
              </div>
            )}
          </>
        ) : (
          <>
            <h2 class="sechead">WHAT IS KNOWN</h2>
            <div class="known num">
              {knownRows.map((r) => (
                <div class="known-row">
                  <span class="known-label">{r.label}</span>
                  <span class="known-value">{r.value}{r.stamp && (
                    <span data-conf={season.key} data-stamp="short"><noscript>{"on the "}<a href={`${aboutHref()}#collection`}>About page</a></noscript></span>
                  )}</span>
                </div>
              ))}
            </div>
          </>
        )}
      </div>

      <div class="body-side">
        {state === "played" ? (
          <>
            {periodCount > 0 && (
              <div class="panel num">
                <h2 class="sechead">SCORE BY PERIOD</h2>
                <div class="periods">
                  <div class="period-head">
                    <span></span>
                    {Array.from({ length: periodCount }, (_, i) => <span>{i + 1}</span>)}
                    <span>T</span>
                  </div>
                  {[sides?.home, sides?.away].map((t, i) => (
                    <div class={`period-row${i === 1 ? " quiet" : ""}`}>
                      <span class="period-team">{i === 0 ? homeAbbr : awayAbbr}</span>
                      {Array.from({ length: periodCount }, (_, p) => <span>{t?.periods[p] ?? 0}</span>)}
                      <span class="period-total">{t?.score ?? 0}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {(sides?.home?.keepers?.length || sides?.away?.keepers?.length) && (
              <div class="panel num">
                <h2 class="sechead">GOALKEEPERS</h2>
                <div class="lines">
                  {[
                    ...(sides?.home?.keepers ?? []).map((k) => ({ k, home: true, t: sides?.home })),
                    ...(sides?.away?.keepers ?? []).map((k) => ({ k, home: false, t: sides?.away })),
                  ].map(({ k, home, t }) => (
                    <div class={`line${home ? "" : " quiet"}`}>
                      <span>
                        <PersonLink href={(home ? homeSheet : awaySheet)(k)}>{surname(k.name)}</PersonLink>{" "}
                        <span class="tag">{home ? homeAbbr : awayAbbr}</span>
                      </span>
                      <span class="line-val">
                        {k.saves ?? 0} sv · {k.goals_against ?? 0} ga{k.minutes !== undefined ? ` · ${k.minutes}′` : ""}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {cards.length > 0 && (
              <div class="panel num">
                <h2 class="sechead">CARDS</h2>
                <div class="lines">
                  {cards.slice(0, CARDS_SHOWN).map((c) => (
                    <div class={`line line-card${c.team === sides?.homeIndex ? "" : " quiet"}`}>
                      <i class={`key key-${c.type === "red" ? "red" : "card"}`}></i>
                      <span class="card-min">{c.minute}′</span>
                      <span>
                        {c.name ? surname(c.name) : <span class="card-unnamed">no name published</span>}{" "}
                        <span class="tag">{c.team === sides?.homeIndex ? homeAbbr : awayAbbr}</span>
                      </span>
                    </div>
                  ))}
                  {cards.length > CARDS_SHOWN && (
                    <details class="disclosure rest">
                      <summary class="line-more">+ {cards.length - CARDS_SHOWN} more</summary>
                      {cards.slice(CARDS_SHOWN).map((c) => (
                        <div class={`line line-card${c.team === sides?.homeIndex ? "" : " quiet"}`}>
                          <i class={`key key-${c.type === "red" ? "red" : "card"}`}></i>
                          <span class="card-min">{c.minute}′</span>
                          <span>
                            {c.name ? surname(c.name) : <span class="card-unnamed">no name published</span>}{" "}
                            <span class="tag">{c.team === sides?.homeIndex ? homeAbbr : awayAbbr}</span>
                          </span>
                        </div>
                      ))}
                    </details>
                  )}
                </div>
              </div>
            )}

            {detail?.officials?.length ? (
              <div class="panel">
                <h2 class="sechead">OFFICIALS</h2>
                <div class="lines">
                  {detail.officials.map((o) => (
                    <div class="line quiet">
                      <span>{o}</span>
                    </div>
                  ))}
                </div>
              </div>
            ) : null}
          </>
        ) : null}
      </div>
    </section>
    )}

    {ledger.length > 0 && (
      <div id="play-by-play" class="ledger-anchor">
        <PlayLedger rows={ledger} playCount={plays.length} abbrChars={abbrChars} />
      </div>
    )}


    <SiteFooter seasons={[season]} shared />
  </div>
</Page>

<script>
  // Arriving at the play-by-play by its link (or its address) opens it. The
  // link works without this: it jumps to the folded list, which a tap opens.
  const ledger = () => document.querySelector<HTMLDetailsElement>("#play-by-play details");
  const openOnHash = () => {
    const d = ledger();
    if (d && location.hash === "#play-by-play") d.open = true;
  };
  for (const a of document.querySelectorAll("[data-opens-ledger]")) {
    a.addEventListener("click", () => {
      const d = ledger();
      if (d) d.open = true;
    });
  }
  addEventListener("hashchange", openOnHash);
  openOnHash();
</script>

<style>
  .match { min-height: 100vh; padding-bottom: 36px; }

