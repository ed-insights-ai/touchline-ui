---
import { site } from "../../site.config.ts";
import Page from "../../layouts/Page.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SeasonMasthead from "../../components/SeasonMasthead.astro";
import SeasonSpine from "../../components/SeasonSpine.astro";
import TheWeek from "../../components/TheWeek.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ConferenceTable from "../../components/ConferenceTable.astro";
import BasisPanel from "../../components/BasisPanel.astro";
import FormBadges from "../../components/FormBadges.astro";
import {
  boxScoreGaps,
  conferenceLeaders,
  conferenceOpensOn,
  formOf,
  hasScore,
  latestResults,
  lastResult,
  loadSeason,
  markOf,
  matchHref,
  matchesHref,
  playerClassOf,
  nextFixture,
  resolveFixtureRef,
  seasonCounts,
  overallTable,
  table,
  tableIsLive,
  teamHref,
  upcomingFixtures,
} from "../../lib/derive.ts";
import type { Fixture } from "../../lib/derive.ts";
import { matchLabel, oneSidedFinals, unpostedSides } from "../../lib/division.ts";
import { homeSeasons } from "../../lib/home.ts";
import {
  CHART_CAPTION,
  editorial,
  fallbackFindings,
  fallbackPattern,
  isStale,
  loadJournal,
  seasonStrip,
} from "../../lib/journal.ts";
import {
  clockTime,
  clockTimeBare,
  dayNumber,
  dowShort,
  initialLast,
  monShort,
  positionLine,
  shortDate,
  stampDate,
  toISO,
} from "../../lib/format.ts";

export function getStaticPaths() {
  return site.conferences.map((conference) => ({ params: { conference } }));
}

const { conference } = Astro.params;
const season = loadSeason(conference as string);
const names = season.names;
const journal = loadJournal(season);
const lede = editorial(season, journal);
const stale = isStale(journal, season);

const counts = seasonCounts(season);
const gaps = boxScoreGaps(season);
// Shared matches whose score only one programme's page has posted, this
// conference being party to them. The match belongs to both conferences, so
// each page lists it — the one that posted and the one that has not — beside
// the box score gaps, where the page already accounts for its silences.
const oneSided = oneSidedFinals(homeSeasons())
  .filter((m) => m.sightings.some((s) => s.key === season.key))
  .map((m) => ({
    label: matchLabel(m),
    note: `${unpostedSides(m)
      .map((u) => u.name)
      .join(" and ")}'s page has not posted it`,
  }));
const live = tableIsLive(season);
const opens = conferenceOpensOn(season);
// Before conference play opens the table ranks every countable match a member
// has played, against anyone, so it has a top and a bottom to read; from the
// first conference result on it is the conference table and nothing else.
const rows = live ? table(season) : overallTable(season);

// The figures strip beneath the lede is the page's own. A journal's
// summary_stat is parsed and ignored: three journals wrote three different
// ones on one morning, and none of them was a figure the page lacked.
const strip = seasonStrip(season);

// Featured matches: the journal names them; the data supplies every number.
const lastScored = lastResult(season);
const featuredLast = resolveFixtureRef(season, journal?.featured?.last_match?.fixture_ref) ?? lastScored;
const featuredNext = resolveFixtureRef(season, journal?.featured?.next_match?.fixture_ref) ?? nextFixture(season);

// Around the conference: the rest of the latest results day, then the next day
// of fixtures the featured pair does not already cover.
const otherResults = latestResults(season).filter((f) => f.id !== featuredLast?.id);
const afterNext = featuredNext ? toISO(dayNumber(featuredNext.date) + 1) : season.asOf;
const otherUpcoming = upcomingFixtures(season, afterNext);
const RESULTS_SHOWN = 4;
const UPCOMING_SHOWN = 2;

// With no journal, the section still has something true to show: the same
// chart, computed from the same fixtures, and the silences named.
const pattern = journal?.pattern ?? fallbackPattern(season);
const findings = journal?.findings ?? fallbackFindings(season);
const goalChart = pattern?.chart;
const watchlist =
  journal && journal.players_to_watch.length > 0
    ? journal.players_to_watch.map((p) => ({
        player: p.player,
        programme: p.programme,
        position: p.position ?? null,
        class: p.class ?? playerClassOf(season, p.programme, p.player),
        line: p.line ?? null,
      }))
    : conferenceLeaders(season);
const chartMax = goalChart ? Math.max(...Object.values(goalChart.values), 0) : 0;

const scoreline = (f: Fixture): string =>
  hasScore(f) ? `${f.home_score}–${f.away_score}` : "—";
/** The same scoreline with hair spaces, for the display sizes. */
const scorelineWide = (f: Fixture): string =>
  hasScore(f) ? `${f.home_score}\u2009–\u2009${f.away_score}` : "—";

// A card emphasises the side this conference's reader came for: the member,
// when only one side is a member, and otherwise the home side.
const emphasis = (f: Fixture): "home" | "away" =>
  names.isMember(f.home) === names.isMember(f.away)
    ? "home"
    : names.isMember(f.home)
      ? "home"
      : "away";

const daysUntil = (iso: string): number => dayNumber(iso) - dayNumber(season.asOf);
const nextLabel = (f: Fixture): string => {
  const d = daysUntil(f.date);
  const when = d === 0 ? "TONIGHT" : d === 1 ? "TOMORROW" : stampDate(f.date);
  const t = clockTime(f.time);
  return t ? `${when} · ${t}` : when;
};
---
<Page
  title={`Touchline — ${season.fixtures.conference} ${season.fixtures.season}`}
  description={lede.dek ?? lede.headline}
>
  <div class="tl-page">
    <SiteHeader season={season} />

    <SeasonMasthead
      kicker={lede.kicker}
      headline={lede.headline}
      dek={lede.dek}
      stamp={lede.stamp}
      counts={counts}
      gaps={gaps}
      oneSided={oneSided}
      strip={strip}
      stale={stale}
    />

    <SeasonSpine season={season} />

    {/* The "now" band, straight off the season line: the two nearest points
        on it — what just happened and what comes next — then this week's
        matches folded beneath them. The analysis, By the Numbers and The
        Table, reads after the news (owner's ruling, 2026-09-01). */}
    <section class="featured">
      {featuredLast && (
        <a class="card" href={matchHref(season.key, featuredLast.id)}>
          <div class="label">LAST MATCH · {stampDate(featuredLast.date)}</div>
          <div class="card-score num">
            <span class={emphasis(featuredLast) === "home" ? "side-lead" : "side-quiet"}>
              {names.name(featuredLast.home)}
            </span>
            <span class="score serif">{scorelineWide(featuredLast)}</span>
            {markOf(season, featuredLast) && (
              <span class="card-mark">{markOf(season, featuredLast)}</span>
            )}
            <span class={emphasis(featuredLast) === "away" ? "side-lead" : "side-quiet"}>
              {names.name(featuredLast.away)}
            </span>
          </div>
          {journal?.featured?.last_match?.line && (
            <div class="card-line">{journal.featured.last_match.line}</div>
          )}
          <div class="card-foot">
            <span class="card-venue">{featuredLast.venue ?? "Venue not published"}</span>
            <span class="grow"></span>
            <span class="card-cta">Match report →</span>
          </div>
        </a>
      )}
      {featuredNext && (
        <a class="card" href={matchHref(season.key, featuredNext.id)}>
          <div class="label">NEXT MATCH · {nextLabel(featuredNext)}</div>
          <div class="card-fixture num">
            <span class={emphasis(featuredNext) === "away" ? "side-lead" : "side-quiet"}>
              {names.name(featuredNext.away)}
            </span>
            <span class="at">at</span>
            <span class={emphasis(featuredNext) === "home" ? "side-lead" : "side-quiet"}>
              {names.name(featuredNext.home)}
            </span>
          </div>
          {journal?.featured?.next_match?.line && (
            <div class="card-line">{journal.featured.next_match.line}</div>
          )}
          <div class="card-foot">
            <span class="card-venue">{featuredNext.venue ?? "Venue not published"}</span>
            <span class="grow"></span>
            <span class="card-cta">Preview →</span>
          </div>
        </a>
      )}
    </section>

    {/* The week's docket sits with the featured pair, as the strip beneath
        the two cards: this week's matches by name, folded, and the road to
        all of them. */}
    <TheWeek season={season} matchesHref={matchesHref(season.key)} />

    <section class="split">
      <div class="col">
        {/* The newspaper's name for a chart and a handful of numeric facts.
            No evidence chips: a reader should not have to learn a grammar to
            read a list of facts (the owner's ruling, 2026-09-01). The labels
            stay in the journal for the validator; on the page every line
            still opens on the figures it rests on, marked by a caret. */}
        <h2 class="sechead">BY THE NUMBERS</h2>
        {pattern ? (
          <>
            <p class="pattern-text serif">{pattern.text}</p>
            {goalChart && (
              <figure class="chart">
                <div class="chart-scroll">
                <div class="chart-plot">
                  {Object.entries(goalChart.values).map(([slug, value]) => {
                    const isMax = slug === goalChart.highlight || value === chartMax;
                    const h = chartMax > 0 ? Math.round((value / chartMax) * 100) : 0;
                    return (
                      <div class="chart-col">
                        {(isMax || value === 0) && (
                          <div class={`chart-value num${isMax ? " is-max" : " is-zero"}`}>{value}</div>
                        )}
                        {value > 0 && (
                          <div
                            class={`chart-bar${isMax ? " is-max" : ""}`}
                            style={`height: ${h}px`}
                          ></div>
                        )}
                      </div>
                    );
                  })}
                </div>
                <div class="chart-axis">
                  {Object.entries(goalChart.values).map(([slug, value]) => (
                    <a
                      href={teamHref(season.key, slug)}
                      class={slug === goalChart.highlight ? "is-max" : undefined}
                    >
                      {names.abbr(slug)}
                      <span class="vh">
                        {" "}— {names.name(slug)}, {value} {value === 1 ? "goal" : "goals"}
                      </span>
                    </a>
                  ))}
                </div>
                </div>
                {/* The scope that used to sit above the sentence folds into
                    the caption, and the caption is the chart's disclosure. */}
                <figcaption class="provenance">
                  <details class="disclosure chart-basis">
                    <summary class="chart-caption">
                      <span>
                        {CHART_CAPTION} · {counts.played} scored{" "}
                        {counts.played === 1 ? "result" : "results"}
                        {lastScored && ` through ${shortDate(lastScored.date)}`}
                      </span>
                      <i class="caret" aria-hidden="true"></i>
                    </summary>
                    <BasisPanel basis={pattern.basis} resolveName={(slug) => names.name(slug)} />
                  </details>
                </figcaption>
              </figure>
            )}
          </>
        ) : (
          <p class="pattern-text serif">
            Nothing has been played yet. The pattern appears with the first result.
          </p>
        )}

        {findings.length > 0 && (
          <ul class="findings">
            {findings.map((f) => (
              <li>
                <details class="disclosure finding">
                  <summary class="finding-head">
                    <span class="finding-text">{f.text}</span>
                    <i class="caret" aria-hidden="true"></i>
                  </summary>
                  <BasisPanel basis={f.basis} resolveName={(slug) => names.name(slug)} />
                </details>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="col">
        <ConferenceTable season={season} rows={rows} live={live} />
      </div>
    </section>

    <section class="split">
      <div class="col">
        <h2 class="sechead">PLAYERS TO WATCH</h2>
        {watchlist.length > 0 ? (
          <div class="watch num">
            {watchlist.map((p) => {
              const line = positionLine(p.position ?? undefined);
              return (
                <a class="wrow hoverable" href={teamHref(season.key, p.programme)}>
                  <span class="wname">
                    <span class="wplayer">{initialLast(p.player)}</span>
                    {line && <span class={`pos pos-${line}`}>{line}</span>}
                    <span class="wmeta">
                      {names.abbr(p.programme)}{p.class ? ` · ${p.class}` : ""}
                    </span>
                  </span>
                  {p.line && <span class="wline">{p.line}</span>}
                  <span class="chev">›</span>
                </a>
              );
            })}
          </div>
        ) : (
          <p class="empty">No season statistics have been collected yet.</p>
        )}
        {!journal?.players_to_watch.length && watchlist.length > 0 && (
          <p class="provenance">Leading the conference on published season points.</p>
        )}
      </div>

      <div class="col">
        <h2 class="sechead">AROUND THE CONFERENCE</h2>
        <div class="around num">
          {otherResults.slice(0, RESULTS_SHOWN).map((f) => (
            <a class="arow hoverable" href={matchHref(season.key, f.id)}>
              <span class="astamp">FT</span>
              <span class="atext">
                {names.name(f.home)} {scoreline(f)} {names.name(f.away)}
                {markOf(season, f) && <span class="amark"> {markOf(season, f)}</span>}
              </span>
            </a>
          ))}
          {otherResults.length > RESULTS_SHOWN && (
            <div class="arow"><span class="astamp"></span><span class="atext quiet">
              + {otherResults.length - RESULTS_SHOWN} more on {stampDate(otherResults[0]!.date)}
            </span></div>
          )}
          {otherUpcoming.slice(0, UPCOMING_SHOWN).map((f) => (
            <a class="arow hoverable" href={matchHref(season.key, f.id)}>
              <span class="astamp">{dowShort(f.date).toUpperCase()}</span>
              <span class="atext quiet">
                {names.name(f.away)} at {names.name(f.home)}
                {f.time ? ` · ${clockTimeBare(f.time)}` : ""}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <SiteFooter seasons={[season]} />
  </div>
</Page>

<style>
  /* ── Masthead ───────────────────────────────────────────────────────────── */

  /* ── Two-column bands ───────────────────────────────────────────────────── */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    gap: 56px;
    padding: 28px 0;
    border-bottom: 1px solid var(--hairline);
  }
  /* The footer draws the page's closing rule; the last section must not draw
     one of its own 28px above it. (It had a band beneath it once.) */
  .split:last-of-type { border-bottom: none; }
  .col { display: flex; flex-direction: column; gap: 16px; min-width: 0; }

  /* ── By the numbers ─────────────────────────────────────────────────────── */
  /* A line that opens on its figures says so with a caret at its right edge,
     turned down while it is open. The same mark serves the chart's caption. */
  .caret {
    flex: none;
    width: 7px;
    height: 7px;
    margin-left: auto;
    border-right: 1.5px solid var(--chevron);
    border-bottom: 1.5px solid var(--chevron);
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
  }
  details[open] > summary > .caret { transform: rotate(45deg); }
  .chart-caption { display: flex; align-items: center; gap: 10px; }
  .chart-caption > span { flex: 1; min-width: 0; }
  .pattern-text {
    margin: 0;
    font-size: 24px;
    line-height: 1.25;
    max-width: 700px;
    text-wrap: pretty;
  }
  /* min-width: 0 is load-bearing. A flex or grid item defaults to
     min-width: auto, so without it the scroll container refuses to shrink
     below its contents and pushes the page sideways instead of scrolling. */
  .chart { margin: 0; min-width: 0; display: flex; flex-direction: column; gap: 7px; }
  /* The bars share one scale, so narrowing them would change what a height
     means. On a phone the chart keeps its scale and takes its own scrollbar. */
  .chart-scroll { min-width: 0; display: flex; flex-direction: column; gap: 7px; overflow-x: auto; }
  .chart-plot {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    height: 130px;
    border-bottom: 1px solid var(--ink);
    padding: 0 4px;
  }
  .chart-col { flex: 1; display: flex; flex-direction: column; gap: 4px; justify-content: flex-end; }
  .chart-value { font-size: 12px; font-weight: 600; text-align: center; }
  /* The spine's palette, not the accent's: grey for the field, a darker grey
     from the squad shape's ramp for the one bar to look at. Purple on this
     site means league dates and links, and seven purple bars spent that
     meaning on goals; solid ink threw the page's weight off (owner's rulings,
     2026-09-01). The leader's value and abbreviation are text, so they wear
     ink, not a series colour. */
  .chart-value.is-max { color: var(--ink); }
  .chart-value.is-zero { font-size: 11px; font-weight: 400; color: var(--quiet); }
  .chart-bar { background: var(--light-future); border-radius: 3px 3px 0 0; }
  .chart-bar.is-max { background: var(--tenure-jr); }
  .chart-axis { display: flex; gap: 14px; padding: 0 4px; font-size: 10.5px; }
  .chart-axis a { flex: 1; text-align: center; color: var(--quiet); }
  .chart-axis a.is-max { font-weight: 600; color: var(--ink); }
  .chart-axis a:hover { color: var(--accent); }

  .findings { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--hairline); }
  .findings li { border-top: 1px solid var(--hairline); padding: 10px 0; }
  .finding-head { display: flex; align-items: center; gap: 14px; }
  .finding:hover .finding-text { color: var(--ink); }
  .finding-text { font-size: 14px; line-height: 1.5; color: var(--ink-soft); }

  /* ── The table ──────────────────────────────────────────────────────────── */

  /* ── Featured ───────────────────────────────────────────────────────────── */
  .featured {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .card-score { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .card-score .side-quiet { font-size: 17px; color: var(--secondary); }
  .card-score .side-lead { font-size: 17px; font-weight: 600; }
  .card-score .score { font-size: 26px; }
  /* "by forfeit" or "disputed" beside the score, in the venue line's register. */
  .card-score .card-mark { font-size: 11.5px; color: var(--quiet); letter-spacing: 0.08em; }
  .amark { color: var(--quiet); font-size: 10.5px; letter-spacing: 0.08em; }
  .card-fixture { font-size: 17px; }
  .card-fixture .side-quiet { color: var(--ink-soft); }
  .card-fixture .at { color: var(--quiet); }
  .card-fixture .side-lead { font-weight: 600; }
  .card-line { font-size: 14px; line-height: 1.5; color: var(--secondary); }
  .card-foot { display: flex; align-items: baseline; }
  .card-venue { font-size: 11.5px; color: var(--quiet); }
  .card-cta { font-size: 12.5px; font-weight: 600; color: var(--accent); }

  /* ── Players / around ───────────────────────────────────────────────────── */
  .watch, .around { display: flex; flex-direction: column; }
  .wrow {
    display: grid;
    grid-template-columns: 1fr auto 18px;
    gap: 14px;
    padding: 11px 4px;
    border-bottom: 1px solid var(--hairline);
    align-items: center;
    color: inherit;
  }
  .wrow:last-child { border-bottom: none; }
  .wname { display: flex; align-items: center; gap: 10px; }
  .wplayer { font-size: 14px; font-weight: 600; }
  .wmeta { font-size: 11.5px; color: var(--quiet); }
  .wline { font-size: 14px; line-height: 1.5; color: var(--ink-soft); }
  .chev { color: var(--chevron); font-size: 14px; }
  .arow {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 4px;
    border-bottom: 1px solid var(--hairline);
    color: inherit;
  }
  .arow:last-child { border-bottom: none; }
  .astamp { font-size: 10.5px; font-weight: 600; color: var(--quiet); width: 30px; flex: none; }
  .atext { font-size: 13px; flex: 1; }
  .atext.quiet { color: var(--secondary); }
  .empty { margin: 0; font-size: 14px; line-height: 1.5; color: var(--quiet); }

  @media (max-width: 720px) {
    .chart-plot, .chart-axis { min-width: 34px; }
    .chart-scroll > * { min-width: max(100%, 340px); }
  }

  @media (max-width: 1180px) {
    .split { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .featured { grid-template-columns: minmax(0, 1fr); }
  }
</style>
