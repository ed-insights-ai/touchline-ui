---
// Matches — every match of the season, day by day.
//
// One grammar, not two lists: a row carries its kickoff until a score replaces
// it. The schedule and the record are the same object seen at different times,
// so nothing here can drift out of agreement with itself.
//
// Three states a row can be in, and each says which it is:
//   • a result — the winner's name carries the weight, the loser's goes quiet,
//     and in a draw neither does;
//   • a score gap — marked played, nothing published. An em-dash sits where
//     the score would, and it is counted BESIDE the played figure, never
//     folded into it;
//   • still to come — away at home, the kickoff the home programme published,
//     and the venue when the schedule names one.
import SiteFooter from "../../components/SiteFooter.astro";
import Page from "../../layouts/Page.astro";
import { hasScore, homeHref, matchHref, matchesHref, seasonHref, loadSeason, type Fixture } from "../../lib/derive.ts";
import { dayOfMonth, dowLong, monLong, monShort } from "../../lib/format.ts";
import {
  byDay,
  isSilentFinal,
  kickoff,
  matchesOf,
  scheduleCounts,
  weightOf,
} from "../../lib/schedule.ts";
import { site } from "../../site.config.ts";

export function getStaticPaths() {
  return site.conferences.map((conference) => ({ params: { conference } }));
}

const { conference } = Astro.params;
const season = loadSeason(conference as string);
const names = season.names;
const code = season.fixtures.conference;
const confName = site.conferenceNames[season.key] ?? code;

const matches = matchesOf(season);
const days = byDay(matches);
const c = scheduleCounts(season);

// The rule between what has happened and what has not. The collect date is the
// only "today" a static page can honestly claim, and it is the same one every
// other surface uses.
const today = season.asOf;
const past = days.filter((d) => d.date < today);
const todayGroup = days.find((d) => d.date === today) ?? null;
const future = days.filter((d) => d.date > today);

const dayLabel = (iso: string): string =>
  `${dowLong(iso).toUpperCase()}, ${monLong(iso).toUpperCase()} ${dayOfMonth(iso)}`;
const isResult = (f: Fixture): boolean => hasScore(f);
const shortDate = (iso: string): string => `${monShort(iso).toUpperCase()} ${dayOfMonth(iso)}`;
// The page's own figures, mechanical, in the masthead's strip: what the rail
// used to say in prose, less the method (owner's ruling, 2026-09-01). Every
// cell is a recomputed count; the absent ones are absent because they are zero.
const strip = [
  `${c.scored} OF ${c.matches} PLAYED`,
  `${c.dates} PLAYING ${c.dates === 1 ? "DATE" : "DATES"}` +
    (c.first && c.last ? `, ${shortDate(c.first)} – ${shortDate(c.last)}` : ""),
  c.league > 0 ? `${c.league} LEAGUE ${c.league === 1 ? "MATCH" : "MATCHES"}` : null,
  c.silent > 0 ? `${c.silent} SCORE ${c.silent === 1 ? "GAP" : "GAPS"}` : null,
  c.stillScheduled > 0 ? `${c.stillScheduled} STILL LISTED AS SCHEDULED` : null,
  c.exhibitions > 0 ? `${c.exhibitions} ${c.exhibitions === 1 ? "FRIENDLY" : "FRIENDLIES"} NOT LISTED` : null,
  c.placeholders > 0
    ? `${c.placeholders} NCAA PLACEHOLDER ${c.placeholders === 1 ? "ROW" : "ROWS"} NOT LISTED`
    : null,
].filter((cell): cell is string => cell !== null);
// A month index for the rail: one entry per month with matches, linking to the
// first day of that month, and TODAY. A long page needs a way to jump.
const monthKey = (iso: string): string => iso.slice(0, 7);
const months = [...new Map(days.map((d) => [monthKey(d.date), d])).entries()].map(([key, first]) => ({
  key,
  label: monShort(first.date).toUpperCase(),
  count: days.filter((d) => monthKey(d.date) === key).reduce((n, d) => n + d.matches.length, 0),
  firstDate: first.date,
}));
const anchorFor = (date: string): string | undefined => {
  const m = months.find((x) => x.firstDate === date);
  return m ? `m-${m.key}` : undefined;
};
const todayLabel = `TODAY \u00b7 ${dayLabel(today)}${todayGroup ? "" : " \u2014 NO MATCHES"}`;

const title = `Touchline — ${confName} Matches`;
const dek = `The complete ${season.fixtures.season} schedule and results, day by day.`;
---

<Page title={title} description={dek}>
  <div class="tl-page">
    <header class="mx-masthead">
      <div class="mx-left">
      <a class="mx-back" href={seasonHref(season.key)}>← SEASON</a>
      {/* The reader is here. This is the only header on the site where that is
          true of this link, so it is the only place aria-current can say so. */}
      <a class="mx-back mx-view" href={matchesHref(season.key)} aria-current="page">MATCHES</a>
      </div>
      <a class="wordmark mx-wordmark" href={homeHref()}>
        <span class="wordmark-square"></span>
        <span class="wordmark-name">Touchline</span>
        <span class="mx-wordmark-sub"> · Matches</span>
      </a>
      <div class="mx-context num">{code} · {site.division.toUpperCase()} · {season.fixtures.season}</div>
    </header>

    <div class="mx-lede">
      <h1 class="mx-h1 serif">Matches</h1>
      <p class="mx-dek serif-italic">{dek}</p>
      <div class="mx-strip num">
        {strip.map((cell) => <span class="cell">{cell}</span>)}
      </div>
    </div>

    <div class="mx-body">
      <div class="mx-ledger">
        {days.length === 0 ? (
          <p class="mx-empty">
            No match is published for this season yet. When the programmes post a schedule, it
            appears here.
          </p>
        ) : (
          <>
            {past.map((d) => (
              <section class="mx-day" id={anchorFor(d.date)}>
                <h2 class="mx-date">{dayLabel(d.date)}</h2>
                {d.matches.map((f) => (
                  <a
                    class={f.conference_game ? "mx-row mx-league hoverable" : "mx-row hoverable"}
                    href={matchHref(season.key, f.id)}
                  >
                    {isResult(f) ? (
                      <>
                        <span class={`mx-away mx-${weightOf(f, "away")}`}>
                          {f.conference_game && <span class="vh">League match. </span>}
                          {names.name(f.away)}
                        </span>
                        <span class="mx-score num">{f.away_score}–{f.home_score}</span>
                        <span class={`mx-home mx-${weightOf(f, "home")}`}>{names.name(f.home)}</span>
                      </>
                    ) : isSilentFinal(f) ? (
                      <>
                        <span class="mx-away mx-even">
                          {f.conference_game && <span class="vh">League match. </span>}
                          {names.name(f.away)}
                        </span>
                        <span class="mx-score mx-silent num">—</span>
                        <span class="mx-home mx-even">
                          {names.name(f.home)}
                          <span class="mx-silent-note"> final — no score published</span>
                        </span>
                      </>
                    ) : (
                      <>
                        <span class="mx-away mx-even">
                          {f.conference_game && <span class="vh">League match. </span>}
                          {names.name(f.away)}
                        </span>
                        <span class="mx-score mx-waiting num">—</span>
                        <span class="mx-home mx-even">
                          {names.name(f.home)}
                          <span class="mx-waiting-note"> still listed as scheduled</span>
                        </span>
                      </>
                    )}
                  </a>
                ))}
              </section>
            ))}

            <div class="mx-today" id="today">
              <span class="mx-today-rule"></span>
              <span class="mx-today-label">{todayLabel}
              </span>
              <span class="mx-today-rule"></span>
            </div>

            {todayGroup && (
              <section class="mx-day" id={anchorFor(todayGroup.date)}>
                {todayGroup.matches.map((f) => (
                  <a
                    class={f.conference_game ? "mx-row mx-row-upcoming mx-league hoverable" : "mx-row mx-row-upcoming hoverable"}
                    href={matchHref(season.key, f.id)}
                  >
                    <span class="mx-line">
                      {f.conference_game && <span class="vh">League match. </span>}
                      <span class="mx-side">{names.name(f.away)}</span>
                      <span class="mx-at"> at </span>
                      <span class="mx-side mx-strong">{names.name(f.home)}</span>
                      {f.venue && <span class="mx-venue"> · {f.venue}</span>}
                    </span>
                    <span class="mx-time num">{kickoff(f.time) ?? "—"}</span>
                  </a>
                ))}
              </section>
            )}

            {future.map((d) => (
              <section class="mx-day" id={anchorFor(d.date)}>
                <h2 class="mx-date">{dayLabel(d.date)}</h2>
                {d.matches.map((f) => (
                  <a
                    class={f.conference_game ? "mx-row mx-row-upcoming mx-league hoverable" : "mx-row mx-row-upcoming hoverable"}
                    href={matchHref(season.key, f.id)}
                  >
                    <span class="mx-line">
                      {f.conference_game && <span class="vh">League match. </span>}
                      <span class="mx-side">{names.name(f.away)}</span>
                      <span class="mx-at"> at </span>
                      <span class="mx-side mx-strong">{names.name(f.home)}</span>
                      {f.venue && <span class="mx-venue"> · {f.venue}</span>}
                    </span>
                    <span class="mx-time num">{kickoff(f.time) ?? "—"}</span>
                  </a>
                ))}
              </section>
            ))}
          </>
        )}
      </div>

      {/* The rail is an index, not an essay: the months with matches, each
          with its count, and TODAY, so a page of a hundred rows can be
          entered anywhere. What the rail used to explain in prose is now the
          strip under the title, as figures. */}
      <aside class="mx-rail">
        {days.length > 0 && (
          <nav class="mx-index" aria-label="Jump to a month">
            <div class="mx-index-head">ON THIS PAGE</div>
            {months.map((m) => (
              <a class="mx-index-row hoverable" href={`#m-${m.key}`}>
                <span class="mx-index-month">{m.label}</span>
                <span class="mx-index-count num">{m.count}</span>
              </a>
            ))}
            <a class="mx-index-row mx-index-today hoverable" href="#today">
              <span class="mx-index-month">TODAY</span>
              <span class="mx-index-count num">{shortDate(today)}</span>
            </a>
          </nav>
        )}
      </aside>
    </div>

    <SiteFooter seasons={[season]} />
  </div>
</Page>

<style>
  .mx-masthead {
    height: 58px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid var(--hairline);
  }
  .mx-left { display: flex; align-items: center; justify-self: start; }
  .mx-masthead .mx-wordmark { justify-self: center; }
  .mx-context { justify-self: end; }
  .mx-back { font-size: 11px; letter-spacing: 0.14em; font-weight: 600; color: var(--secondary); }
  .mx-back:hover { color: var(--accent); }
  .mx-view { padding-left: 14px; margin-left: 14px; border-left: 1px solid var(--hairline); }
  .mx-view[aria-current="page"] { color: var(--ink); }
  .mx-view[aria-current="page"]:hover { color: var(--ink); }
  /* The wordmark reads as the masthead it is, not as a link, so it keeps ink
     on hover the way the site header’s does. */
  .mx-masthead .mx-wordmark { color: var(--ink); }
  .mx-wordmark .wordmark-name { font-size: 19px; }
  .mx-wordmark-sub { font-family: var(--serif); font-style: italic; font-size: 19px; }
  .mx-context { font-size: 11px; letter-spacing: 0.1em; color: var(--quiet); }

  .mx-lede { padding: 28px 0 20px; border-bottom: 1px solid var(--hairline); }
  .mx-h1 { margin: 0; font-size: 38px; line-height: 1.1; }
  .mx-dek { margin: 10px 0 0; font-size: 14.5px; line-height: 1.5; color: var(--quiet); max-width: 720px; }
  /* The season masthead's strip, in the same type. */
  .mx-strip {
    display: flex;
    flex-wrap: wrap;
    margin-top: 12px;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: var(--secondary);
  }
  .cell { white-space: nowrap; }
  .cell + .cell::before { content: "·"; margin: 0 10px; color: var(--outline-quiet); }
  /* At phone widths a long cell wraps rather than pushing the page sideways. */
  @media (max-width: 480px) { .cell { white-space: normal; } }

  .mx-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    gap: 56px;
    padding: 22px 0 0;
  }
  .mx-ledger { min-width: 0; }
  /* Each day is a block, as the week's docket draws them: its label in ink
     over a rule darker than the row hairlines, and air before the next day. */
  .mx-day { display: flex; flex-direction: column; }
  .mx-day + .mx-day { margin-top: 24px; }
  .mx-day[id] { scroll-margin-top: 16px; }
  .mx-date {
    margin: 0;
    padding: 0 0 6px;
    font-size: 10px;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1px solid var(--tenure-rule);
  }
  .mx-date + .mx-row { border-top: none; }

  /* A result: away right-aligned into the score, home left-aligned out of it,
     so the scoreline reads as one object down the column. */
  .mx-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 78px minmax(0, 1fr);
    align-items: baseline;
    gap: 0;
    padding: 7px 0;
    border-top: 1px solid var(--hairline-soft);
    color: inherit;
    font-size: 13.5px;
  }
  /* A league match wears the league colour as a square hung in the margin, as
     the week's docket does: the text does not move, and purple keeps the one
     meaning it has on this site. */
  .mx-league::before {
    content: "";
    position: absolute;
    left: -16px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 1px;
    background: var(--accent);
  }
  .mx-away { text-align: right; }
  .mx-home { text-align: left; }
  .mx-score { text-align: center; font-weight: 600; }
  .mx-strong { font-weight: 600; color: var(--ink); }
  .mx-even { color: var(--ink); }
  /* The losing side's name. It is the only thing on the row that says which
     way the result went, so it steps down from the winner without stepping
     under the floor. */
  .mx-quiet { color: var(--quiet); }
  .mx-silent { color: var(--loss); }
  .mx-silent-note { font-size: 12px; color: var(--loss); letter-spacing: 0.02em; }
  /* A date gone by whose match the site still lists as scheduled is a different
     silence from a final with no score: nothing was ever claimed, so it is
     quiet rather than flagged. */
  .mx-waiting { color: var(--quiet); }
  .mx-waiting-note { font-size: 12px; color: var(--quiet); letter-spacing: 0.02em; }
  .mx-silent-word { color: var(--loss); font-weight: 600; }

  .mx-row-upcoming { grid-template-columns: minmax(0, 1fr) auto; }
  .mx-line { min-width: 0; }
  .mx-side { color: var(--quiet); }
  .mx-side.mx-strong { color: var(--ink); }
  .mx-at { color: var(--quiet); }
  .mx-venue { color: var(--quiet); font-size: 12px; }
  .mx-time { color: var(--quiet); font-size: 13px; }

  .mx-today { display: flex; align-items: center; gap: 12px; padding: 24px 0 4px; scroll-margin-top: 16px; }
  .mx-today-rule { flex: 1; height: 1px; background: var(--ink); }
  .mx-today-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  .mx-rail { min-width: 0; }
  .mx-index { position: sticky; top: 16px; display: flex; flex-direction: column; max-width: 220px; }
  .mx-index-head {
    padding: 0 0 6px;
    font-size: 10px;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1px solid var(--tenure-rule);
  }
  .mx-index-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 7px 4px;
    border-bottom: 1px solid var(--hairline-soft);
    color: inherit;
  }
  .mx-index-month { font-size: 11px; letter-spacing: 0.14em; font-weight: 600; color: var(--secondary); }
  .mx-index-count { font-size: 12.5px; color: var(--quiet); }
  .mx-index-today .mx-index-month { color: var(--ink); }
  .mx-index-row:hover .mx-index-month { color: var(--accent); }
  .mx-empty { margin: 0; font-size: 14px; line-height: 1.5; color: var(--quiet); max-width: 640px; }

  @media (max-width: 1180px) {
    /* One column: the index goes first, as a row of months across the top of
       the ledger, and stops sticking. */
    .mx-body { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .mx-rail { order: -1; }
    .mx-index { position: static; flex-direction: row; flex-wrap: wrap; max-width: none; gap: 0 18px; }
    .mx-index-head { flex-basis: 100%; border-bottom: none; padding-bottom: 2px; }
    .mx-index-row { border-bottom: none; padding: 4px 0; gap: 6px; }
  }
  @media (max-width: 720px) {
    .mx-masthead { height: auto; padding: 12px 0; grid-template-columns: 1fr; row-gap: 6px; }
    .mx-masthead .mx-wordmark, .mx-context { justify-self: start; }
    .mx-h1 { font-size: 30px; }
    .mx-row { grid-template-columns: minmax(0, 1fr) 62px minmax(0, 1fr); font-size: 12.5px; }
    .mx-row-upcoming { grid-template-columns: minmax(0, 1fr) auto; }
    .mx-today-label { font-size: 10px; letter-spacing: 0.1em; white-space: normal; }
  }
</style>
