---
import { site } from "../../../site.config.ts";
import Page from "../../../layouts/Page.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import FormBadges from "../../../components/FormBadges.astro";
import {
  conferenceOpenerOf,
  fixturesOf,
  programmeCounts,
  formOf,
  hasScore,
  isScored,
  leadKeeper,
  loadSeason,
  matchHref,
  recordOf,
  resultsOf,
  squadByLine,
  squadOf,
  squadShape,
  upcomingOf,
  flagHref,
} from "../../../lib/derive.ts";
import type { Fixture, Season } from "../../../lib/derive.ts";
import { identityLine } from "../../../lib/programmes.ts";
import { countOrigins, originOf } from "../../../lib/origin.ts";
import { returnedShare, tenureGrid } from "../../../lib/tenure.ts";
import EvidenceChip from "../../../components/EvidenceChip.astro";
import PlayerSheet from "../../../components/PlayerSheet.astro";
import SeasonStrip from "../../../components/SeasonStrip.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { playerCard } from "../../../lib/player.ts";
import {
  daysBetween,
  dowShort,
  initialLast,
  longDate,
  dayOfMonth,
  monLong,
  monShort,
  numericDate,
  rate3,
  spell,
} from "../../../lib/format.ts";

export function getStaticPaths() {
  return site.conferences.flatMap((conference) => {
    let season: Season;
    try {
      season = loadSeason(conference);
    } catch {
      return [];
    }
    return season.fixtures.programmes.map((p) => ({
      params: { conference, slug: p.slug },
      props: { programmeSlug: p.slug },
    }));
  });
}

const { conference } = Astro.params;
const { programmeSlug } = Astro.props;
const season = loadSeason(conference as string);
const names = season.names;
const slug = programmeSlug as string;

const programme = season.fixtures.programmes.find((p) => p.slug === slug);
const all = fixturesOf(season, slug);
const results = resultsOf(season, slug);
const record = recordOf(season, slug);
const shape = squadShape(season, slug);
const keeper = leadKeeper(season, slug);
const opener = conferenceOpenerOf(season, slug);
const upcoming = upcomingOf(season, slug);
const counts = programmeCounts(season, slug);
const cards = squadOf(season, slug).map((m) => ({
  member: m,
  card: playerCard(season, slug, m.player, m.stats, m.keeper),
}));
const cardFor = (name: string) => cards.find((c) => c.member.player.name === name)?.card;

const LINES = [
  { key: "FWD", label: "ATTACK", colour: "var(--pos-fwd)" },
  { key: "MID", label: "MIDFIELD", colour: "var(--pos-mid)" },
  { key: "DEF", label: "DEFENSE", colour: "var(--pos-def)" },
  { key: "GK", label: "GOALKEEPERS", colour: "var(--pos-gk)" },
] as const;
const SQUAD_SHOWN = 4;

// Where a squad member is from, read off the hometown the programme published.
// The flag is the only place this fact appears on a row — rows do not print
// hometowns — so the country's name travels with it for anyone who cannot see
// it, and the word "international" is never used: in football that word means
// a capped player, which is not what a hometown can tell anyone.
const nationOf = (m: { player: { hometown?: string } }) => {
  const origin = originOf(m.player.hometown);
  return origin.kind === "abroad" ? origin.nation : null;
};

// Counted over exactly the rows the four lines render, so the figure and the
// flags a reader can count by hand — including the ones folded behind
// "+ N more" — are the same population.
const rendered = LINES.flatMap((l) => squadByLine(season, slug, l.key));
const origins = countOrigins(rendered.map((m) => m.player.hometown));
const originResidue = [
  origins.unplaced > 0
    ? `${spell(origins.unplaced)} more ${origins.unplaced === 1 ? "publishes" : "publish"} a place this site does not name`
    : null,
  origins.absent > 0
    ? `${spell(origins.absent)} ${origins.absent === 1 ? "publishes" : "publish"} none at all`
    : null,
]
  .filter(Boolean)
  .join(" and ");
const originNote =
  origins.placed === 0
    ? "No published hometown on this roster names a place this site can place."
    : `${origins.abroad} of ${origins.placed} ${origins.placed === 1 ? "player carries" : "players carry"} a published hometown outside the United States.` +
      (originResidue
        ? ` ${originResidue.charAt(0).toUpperCase()}${originResidue.slice(1)}; they stand outside both sides of that count.`
        : "");

// The season strip: every fixture the programme published, in order, each cell
// carrying either its result or its date. Nothing is dropped for want of a score.
const strip = all.map((f) => {
  const home = f.home === slug;
  const opponent = home ? f.away : f.home;
  const scored = isScored(f) && hasScore(f);
  const gf = scored ? (home ? f.home_score : f.away_score) : null;
  const ga = scored ? (home ? f.away_score : f.home_score) : null;
  return {
    fixture: f,
    opponent,
    home,
    scored,
    result: gf === null || ga === null ? null : gf > ga ? "W" : gf < ga ? "L" : "D",
    line: gf === null || ga === null ? null : `${gf}–${ga}`,
    isOpener: opener?.id === f.id,
    silent: f.status === "final" && !scored,
  };
});

// ── The profile figures. Every one is recomputed here; the sentences beneath
// them are composed from the same numbers, never written around them.
const first = results[0];
const openerPanel = (() => {
  if (record.played === 0) {
    const next = all.find((f) => f.status === "scheduled");
    return {
      label: "NOT YET PLAYED",
      figure: "—",
      note: next
        ? `First match ${next.home === slug ? "at home to" : "away at"} ${names.name(next.home === slug ? next.away : next.home)}, ${monLong(next.date)} ${dayOfMonth(next.date)}.`
        : "No match has been published.",
    };
  }
  if (record.played === 1 && first) {
    const verb = first.result === "W" ? "Won" : first.result === "D" ? "Drew" : "Lost";
    const where = first.home ? "at home to" : "away at";
    return {
      label: "THE OPENER",
      figure: `${first.goalsFor}–${first.goalsAgainst}`,
      note: `${verb} ${where} ${names.name(first.opponent)}.`,
    };
  }
  return {
    label: "RECORD",
    figure: `${record.won}–${record.drawn}–${record.lost}`,
    note: `${spell(record.played)} played · ${record.goalsFor} scored · ${record.goalsAgainst} conceded.`,
  };
})();

const keeperNote = keeper
  ? `${keeper.name}: ${keeper.saves ?? 0} ${keeper.saves === 1 ? "save" : "saves"}, ${keeper.goals_against ?? 0} conceded, ${keeper.minutes ?? 0} minutes.`
  : "No goalkeeping line has been published.";

// The figure counts every match in the fortnight, so the note has to account
// for every one of them — a count that outruns what the page shows for it is
// the reader's first reason to stop trusting the other counts.
const NEXT_SHOWN = 3;
const nextNote = upcoming.length
  ? [
      upcoming
        .slice(0, NEXT_SHOWN)
        .map(
          (f) =>
            `${f.home === slug ? "" : "at "}${names.name(f.home === slug ? f.away : f.home)} ${dowShort(f.date)}`,
        )
        .join(", "),
      upcoming.length > NEXT_SHOWN ? `+ ${upcoming.length - NEXT_SHOWN} more` : null,
    ]
      .filter(Boolean)
      .join(", ")
  : "No match inside the fortnight.";

// ── The squad's shape, as tenure ───────────────────────────────────────────
// A number said how many came back; it could not say who. The grid draws one
// square per player, and this sentence is the figure it is a picture of.
const grid = tenureGrid(season, slug);
const share = grid.minutes && grid.minutes.total > 0 ? returnedShare(grid.minutes) : null;

const shapeReturn =
  grid.returning === null
    ? `${spell(grid.size)} on the roster. The season before was never collected, so nobody here is called new.`
    : `${grid.returning} of ${grid.size} ${grid.size === 1 ? "player returns" : "players return"}`;

const shapeMinutes =
  grid.returning === null
    ? null
    : share !== null
      ? `, holding ${(share * 100).toFixed(1)}% of last season's minutes.`
      : grid.minutesUncollected
        ? ". Last season's statistics were never collected, so how much of its football came back cannot be said."
        : ". No minutes were published for last season, so there is no share of them to take.";

// Minutes that were played and belong to no line drawn below. A prior roster
// that wrote "Right Back" where this year's writes "Defender" puts real
// football outside every row, and the page says so rather than quietly
// shrinking the season it is taking a share of.
const shapeOffLine =
  grid.offLine.players > 0
    ? ` Last season's roster listed ${spell(grid.offLine.players)} ${grid.offLine.players === 1 ? "player" : "players"} at a position this site cannot place on a line; those minutes are inside that total and inside none of the rows.`
    : "";

const shapeSentence = `${shapeReturn}${shapeMinutes ?? ""}${shapeOffLine}`;

// What a screen reader gets instead of fifty squares: the spread the ink is
// carrying, in words, once per row.
const TENURE_WORDS = { FR: "first years", SO: "sophomores", JR: "juniors", SR: "seniors", "5Y": "fifth years" } as const;
const spread = (squares: { tenure: { step: keyof typeof TENURE_WORDS | null } }[]): string => {
  if (squares.length === 0) return "none";
  const counts = new Map<string, number>();
  for (const sq of squares) {
    const word = sq.tenure.step ? TENURE_WORDS[sq.tenure.step] : "no published class year";
    counts.set(word, (counts.get(word) ?? 0) + 1);
  }
  return [...counts].map(([word, n]) => `${n} ${word}`).join(", ");
};

const stripNote = (() => {
  const spelled = spell(counts.played);
  const silentWord = spell(counts.silentFinals);
  const silent =
    counts.silentFinals > 0
      ? ` ${silentWord.charAt(0).toUpperCase()}${silentWord.slice(1)} silent ${
          counts.silentFinals === 1 ? "final" : "finals"
        }.`
      : "";
  const head = `${spelled.charAt(0).toUpperCase()}${spelled.slice(1)} played, ${spell(counts.total - counts.played - counts.silentFinals)} listed.${silent}`;
  if (!opener) return head;
  const oppSlug = opener.home === slug ? opener.away : opener.home;
  const where = opener.home === slug ? "at home to" : "at";
  return `${head} The conference opener is ${where} ${names.name(oppSlug)} on ${monLong(opener.date)} ${dayOfMonth(opener.date)}.`;
})();

const title = programme?.name ?? names.name(slug);
// Absent identity is a designed state: the meta line simply starts at the record.
const identity = identityLine(slug);
---
<Page title={`Touchline — ${title}`} description={`${title}, ${season.fixtures.season} season.`}>
  <div class="tl-page">
    <SiteHeader season={season} currentTeam={slug} />

    <section class="crest">
      <div class="crest-mark">{names.abbr(slug)}</div>
      <div class="crest-id">
        <h1 class="crest-name serif">{title}</h1>
        <div class="crest-meta num">
          {identity && `${identity} · `}<strong>{record.won}–{record.drawn}–{record.lost} overall</strong>
          {" · "}{counts.played} of {counts.total} played
          {opener && ` · conference opens ${monShort(opener.date)} ${dayOfMonth(opener.date)}`}
        </div>
      </div>
      <div class="grow"></div>
      <div class="crest-form">
        {record.played > 0 && (
          <div class="crest-form-row">
            <span class="label">{record.played === 1 ? "OPENER" : "FORM"}</span>
            <FormBadges form={formOf(season, slug)} large />
          </div>
        )}
        <div class="crest-tally num">
          GOALS <strong>{record.goalsFor}</strong> &nbsp;·&nbsp; CONCEDED <strong>{record.goalsAgainst}</strong>
          {shape.size > 0 && (
            <>
              &nbsp;·&nbsp; SQUAD <strong>{shape.size}</strong>
              {shape.returning !== null && (
                <span class="crest-split"> ({shape.returning} ret · {shape.fresh} new)</span>
              )}
            </>
          )}
        </div>
      </div>
    </section>

    <section class="band">
      <SeasonStrip
        cells={strip.map((c) => ({
          href: matchHref(season.key, c.fixture.id),
          detail: `${c.home ? "vs" : "at"} ${names.name(c.opponent)} · ${longDate(c.fixture.date)}`,
          opponent: names.abbr(c.opponent),
          line: c.line ?? (c.silent ? "—" : numericDate(c.fixture.date)),
          result: c.result as "W" | "D" | "L" | null,
          isOpener: c.isOpener,
          silent: c.silent,
        }))}
        note={stripNote}
      />
    </section>

    <section class="band">
      <h2 class="sechead">TEAM PROFILE</h2>
      <div class="profile">
        <div class="stat stat-wide">
          <div class="label">{openerPanel.label}</div>
          <div class="stat-figure serif num">{openerPanel.figure}</div>
          <div class="stat-note">{openerPanel.note}</div>
        </div>
        <div class="stat">
          <div class="label">GOALKEEPING</div>
          <div class="stat-figure stat-figure-sm serif num">
            {keeper ? (rate3(keeper.save_pct) ?? "—") : "—"}
          </div>
          <div class="stat-note">{keeperNote}</div>
        </div>
        <div class="stat">
          <div class="label">NEXT UP</div>
          <div class="stat-figure stat-figure-sm serif num">{upcoming.length}</div>
          <div class="stat-note">{nextNote}</div>
        </div>
      </div>
    </section>

    {/* No roster, no shape. The SQUAD section below names that absence once,
        in the programme's own words; saying it twice on one page is noise
        rather than more honesty. */}
    {grid.size > 0 && (
    <section class="band">
      <h2 class="sechead">SQUAD SHAPE</h2>
      <p class="shape-lede">
        <EvidenceChip label="derived" />
        <span class="shape-said">{shapeSentence}</span>
      </p>
      <div class="shape">
        {grid.rows.map((row) => {
          const pct = returnedShare(row.minutes);
          return (
            <div class="shape-row">
              <div class="shape-line">
                <span class="shape-label">{row.label}</span>
                <span class="shape-count num">
                  {row.returners.length} ret · {row.newcomers.length} new
                </span>
              </div>
              <div class="shape-squares">
                <span class="vh">
                  {row.label}: {spread(row.returners)} returning; {spread(row.newcomers)} new.
                </span>
                {row.returners.map((sq) => (
                  <span class="sq" title={sq.title}>
                    <span class={`sq-box${sq.tenure.step ? ` sq-${sq.tenure.step.toLowerCase()}` : " sq-open"}`}></span>
                    {sq.nation && <span class="sq-dot"></span>}
                  </span>
                ))}
                {row.returners.length > 0 && row.newcomers.length > 0 && (
                  <span class="shape-rule"></span>
                )}
                {row.newcomers.map((sq) => (
                  <span class="sq" title={sq.title}>
                    <span class={`sq-box${sq.tenure.step ? ` sq-${sq.tenure.step.toLowerCase()}` : " sq-open"}`}></span>
                    {sq.nation && <span class="sq-dot"></span>}
                  </span>
                ))}
              </div>
              <div class="shape-minutes">
                {/* No track at all where there is nothing to take a share of.
                    An empty track beside an em-dash reads as nought per cent,
                    which is the one thing the em-dash is there not to say. */}
                {pct !== null && (
                  <span class="shape-track">
                    <span class="shape-fill" style={`width: ${(pct * 100).toFixed(1)}%`}></span>
                  </span>
                )}
                <span class="shape-pct num">{pct === null ? "—" : `${Math.round(pct * 100)}%`}</span>
              </div>
            </div>
          );
        })}
      </div>
      <p class="shape-caption serif-italic">
        Each square is a player, inked by how long they have been here — palest for
        a first year, darkest for a fifth. Returners sit left of the rule and
        newcomers right; a dot beneath a square marks a published hometown outside
        the United States, and a hollow square is a class year the roster never
        printed. The figure at the right is the share of last season's minutes at
        that line still on this roster.
      </p>
    </section>
    )}

    <section class="band band-last" id="squad">
      <h2 class="sechead">SQUAD</h2>
      {shape.size === 0 ? (
        <p class="empty">No roster has been collected for this programme.</p>
      ) : (
        <div class="squad">
          {LINES.map((l) => {
            const members = squadByLine(season, slug, l.key);
            const lead = members[0];
            return (
              <div class="squad-line">
                <div class="squad-head">
                  <span class="squad-dot" style={`background: ${l.colour}`}></span>
                  <span class="squad-label">{l.label}</span>
                  <span class="grow"></span>
                  <span class="squad-count num">{members.length}</span>
                </div>
                <div class="squad-list">
                  {members.slice(0, SQUAD_SHOWN).map((m) => {
                    const from = nationOf(m);
                    return (
                      <a class="squad-row" href={`#${cardFor(m.player.name)?.anchor ?? ""}`}>
                        <span
                          class={`squad-name${m === lead && m.contribution > 0 ? " is-lead" : ""}`}
                        >
                          {initialLast(m.player.name)}
                        </span>
                        {from && (
                          <span class="squad-origin" title={`${from.name} · by published hometown`}>
                            <img class="squad-flag" src={flagHref(from.iso)} alt="" decoding="async" />
                            <span class="vh">{from.name}</span>
                          </span>
                        )}
                        {m.isNew && <span class="squad-new">NEW</span>}
                        {m.contribution > 0 && (
                          <span class="squad-stat num">
                            {m.contribution} {m.keeper ? "SV" : "SH"}
                          </span>
                        )}
                      </a>
                    );
                  })}
                  {members.length > SQUAD_SHOWN && (
                    <details class="squad-rest">
                      <summary class="squad-more">+ {members.length - SQUAD_SHOWN} more</summary>
                      {members.slice(SQUAD_SHOWN).map((m) => {
                        const from = nationOf(m);
                        return (
                          <a class="squad-row" href={`#${cardFor(m.player.name)?.anchor ?? ""}`}>
                            <span class="squad-name">{initialLast(m.player.name)}</span>
                            {from && (
                              <span
                                class="squad-origin"
                                title={`${from.name} · by published hometown`}
                              >
                                <img
                                  class="squad-flag"
                                  src={flagHref(from.iso)}
                                  alt=""
                                  decoding="async"
                                />
                                <span class="vh">{from.name}</span>
                              </span>
                            )}
                            {m.isNew && <span class="squad-new">NEW</span>}
                            {m.contribution > 0 && (
                              <span class="squad-stat num">
                                {m.contribution} {m.keeper ? "SV" : "SH"}
                              </span>
                            )}
                          </a>
                        );
                      })}
                    </details>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}
      {shape.size > 0 && <p class="squad-origin-note">{originNote}</p>}
    </section>

    {cards.map(({ card }) => <PlayerSheet card={card} />)}

    <SiteFooter season={season} />
  </div>
</Page>

<style>
  .crest {
    padding: 30px 0 26px;
    display: flex;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid var(--hairline);
    flex-wrap: wrap;
  }
  .crest-mark {
    width: 72px; height: 72px;
    border-radius: 10px;
    background: var(--accent-wash);
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; font-weight: 600; color: var(--accent);
    letter-spacing: 0.02em;
    flex: none;
  }
  .crest-id { display: flex; flex-direction: column; gap: 5px; }
  .crest-name { margin: 0; font-size: 40px; line-height: 1; }
  .crest-meta { font-size: 13px; color: var(--secondary); }
  .crest-meta strong { color: var(--ink); font-weight: 600; }
  .crest-form { display: flex; flex-direction: column; gap: 8px; align-items: flex-end; }
  .crest-form-row { display: flex; gap: 10px; align-items: center; }
  .crest-form-row .label { margin-right: 6px; }
  .crest-tally { font-size: 12.5px; color: var(--secondary); }
  .crest-tally strong { color: var(--ink); font-weight: 600; }
  .crest-split { color: var(--faint); }

  .band {
    padding: 26px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-bottom: 1px solid var(--hairline);
  }
  .band-last { border-bottom: none; padding-bottom: 0; }

  /* ── The season strip ───────────────────────────────────────────────────── */

  /* ── Profile ────────────────────────────────────────────────────────────── */
  .profile { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; }
  .stat { display: flex; flex-direction: column; gap: 6px; }
  .stat-figure { font-size: 40px; line-height: 1; }
  .stat-figure-sm { font-size: 32px; }
  .stat-note { font-size: 12px; color: var(--secondary); line-height: 1.5; }
  .stat-wide .stat-note { font-size: 12.5px; max-width: 340px; }

  /* ── Squad shape ────────────────────────────────────────────────────────── */
  /* The figure this grid is a picture of, said in words first: a reader who
     takes nothing else from the band should still leave with the sentence. */
  .shape-lede {
    margin: 0 0 20px;
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px;
  }
  .shape-said { font-size: 13.5px; line-height: 1.55; max-width: 780px; }
  .shape { display: flex; flex-direction: column; }
  .shape-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) 160px;
    align-items: center;
    gap: 20px;
    padding: 11px 0;
    border-top: 1px solid var(--hairline-soft);
  }
  .shape-row:first-child { border-top: 0; }
  .shape-line { display: flex; flex-direction: column; gap: 3px; }
  .shape-label { font-size: 11px; letter-spacing: 0.16em; font-weight: 600; color: var(--secondary); }
  .shape-count { font-size: 11.5px; color: var(--quiet); }
  .shape-squares { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 6px; }
  /* A fixed height whether or not the dot is there, so a row of squares sits
     on one line and does not shuffle when one player is from abroad. */
  .sq { display: flex; flex-direction: column; align-items: center; gap: 2px; height: 20px; }
  .sq-box { width: 14px; height: 14px; border-radius: 3px; background: var(--tenure-fr); }
  .sq-fr { background: var(--tenure-fr); }
  .sq-so { background: var(--tenure-so); }
  .sq-jr { background: var(--tenure-jr); }
  .sq-sr { background: var(--tenure-sr); }
  .sq-5y { background: var(--tenure-5y); }
  /* No fill at all, not the palest fill: a class year the roster never printed
     is an absence, and the lightest step already means something else. */
  .sq-open { background: none; border: 1px solid var(--faint); }
  .sq-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--secondary); }
  .shape-rule { width: 1px; height: 22px; background: var(--tenure-rule); margin: 0 5px; align-self: flex-start; }
  .shape-minutes { display: flex; align-items: center; justify-content: flex-end; gap: 12px; }
  .shape-track {
    width: 110px; height: 5px; border-radius: 3px;
    background: var(--hairline); overflow: hidden;
  }
  .shape-fill { display: block; height: 100%; background: var(--ink); }
  .shape-pct { font-size: 12.5px; color: var(--ink-soft); min-width: 34px; text-align: right; }
  .shape-caption {
    margin: 18px 0 0;
