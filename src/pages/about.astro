---
// About & method. A reading page: serif prose under ruled heads, no cards, no
// chrome. The definitions here are not a glossary appended to the product —
// they are the product's thesis restated in the words a reader needs, and the
// last clause of each is where the honesty lives.
import EvidenceChip from "../components/EvidenceChip.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Page from "../layouts/Page.astro";
import { homeHref, loadSeason } from "../lib/derive.ts";
import type { Season } from "../lib/derive.ts";
import { dayOfMonth, monShort } from "../lib/format.ts";
import { site } from "../site.config.ts";

// Only conferences the data home actually carries are described — a
// conference that failed to collect is not claimed.
const seasons: Season[] = site.conferences.flatMap((key) => {
  try {
    return [loadSeason(key)];
  } catch {
    return [];
  }
});
const named = seasons.map((s) => site.conferenceNames[s.key] ?? s.fixtures.conference);
const conferenceList =
  named.length <= 1
    ? (named[0] ?? "")
    : `${named.slice(0, -1).join(", ")} and ${named[named.length - 1]}`;

const stamp = (iso: string): string =>
  `${monShort(iso.slice(0, 10))} ${dayOfMonth(iso.slice(0, 10))}, ${iso.slice(11, 16)} UTC`;

const GRAMMAR = [
  { label: "observed", gloss: "a fact a programme published, as collected." },
  { label: "derived", gloss: "computed exactly from published values — the arithmetic is shown." },
  { label: "signal", gloss: "a pattern in the data whose cause is unverified." },
  { label: "projected", gloss: "forward-looking; the season will answer it." },
  { label: "context", gloss: "biography, not a finding." },
] as const;
---

<Page
  title="Touchline — About & method"
  description="What Touchline is, where its numbers come from, and what each word on it means."
>
  <div class="tl-page about">
    <header class="ahead">
      <a class="wordmark" href={homeHref()}>
        <span class="wordmark-square"></span>
        <span class="wordmark-name">Touchline</span>
      </a>
      <div class="grow"></div>
      <a class="back" href={homeHref()}>← HOME</a>
    </header>

    <section class="lede">
      <h1 class="atitle serif">About &amp; method</h1>
      <p class="intro">
        Touchline is a season journal for {site.division}, following the{" "}
        {conferenceList}. It is <strong>independent and unofficial</strong>: it has no
        connection to any conference, programme or governing body. Everything on it comes
        from the programmes' own published pages — and what they did not publish is shown
        as what it is.
      </p>
    </section>

    <section class="band">
      <h2 class="sechead">WHAT THE WORDS MEAN</h2>
      <div class="terms">
        <div class="term">
          <div class="term-name">PLAYED</div>
          <p class="term-text">
            A match marked final whose score was published. Touchline counts nothing it
            cannot show.
          </p>
        </div>
        <div class="term">
          <div class="term-name">SILENT FINAL</div>
          <p class="term-text">
            A match a programme's site marked finished without ever publishing a score.
            The silence is the site's own; it stays on the record, named, and every
            collect asks again.
          </p>
        </div>
        <div class="term">
          <div class="term-name">GAP</div>
          <p class="term-text">
            A match whose result Touchline holds but whose detail — the box score behind
            it — the collector could not reach. Never a friendly, never a silent
            final: a gap is the one absence nothing else on the page names.
          </p>
        </div>
        <div class="term">
          <div class="term-name">A SHARED MATCH</div>
          <p class="term-text">
            A match between programmes in two of the conferences Touchline follows
            belongs to both. It appears in each conference's own accounting, and the
            division counts it once — so adding the conference figures together gives a
            larger number than the division's, and neither of them is wrong.
          </p>
        </div>
        <div class="term">
          <div class="term-name">FRIENDLY</div>
          <p class="term-text">
            A match played outside the record everywhere: no wins, no goals, no counts.
            Named where it appears, counted nowhere. The {site.season} collection is the
            first to mark them, so on earlier seasons Touchline cannot tell a friendly
            from a match that counted — and does not guess which was which.
          </p>
        </div>
      </div>
    </section>

    <section class="band">
      <h2 class="sechead">HOW MUCH IS KNOWN</h2>
      <p class="para">
        Every claim on this site wears a mark saying how far it is from the published
        page it came from. The marks are fixed per kind of claim, never chosen to suit
        one.
      </p>
      <dl class="grammar">
        {GRAMMAR.map((g) => (
          <div class="grammar-row">
            <dt><EvidenceChip label={g.label} /></dt>
            <dd>{g.gloss}</dd>
          </div>
        ))}
      </dl>
      <p class="para">
        Where a claim carries figures, the chip opens onto them: the numbers the sentence
        rests on, and the layer they were read from.
      </p>
    </section>

    <section class="band">
      <h2 class="sechead">WHAT IS CHECKED</h2>
      <p class="para">
        Every finding is recomputed against the collected data before publish — anything
        unverifiable is dropped, not softened, and every number in prose must answer to a
        figure that was checked.
      </p>
    </section>

    <section class="band">
      <h2 class="sechead">WHERE IT COMES FROM</h2>
      <p class="para">
        A collector reads each programme's own schedule, roster, statistics and box-score
        pages, {site.cadence}, and writes what it finds to a file. This site is built from
        those files and one hand-kept reference — each programme's nickname and city, the
        only facts here no collector produced. No estimates, no third-party feeds.
      </p>
      <div class="stamps num">
        {seasons.map((s) => (
          <div class="stamp-row">
            <span class="stamp-conf">{site.conferenceNames[s.key] ?? s.fixtures.conference}</span>
            <span class="stamp-when">last collected {stamp(s.collectedAt)}</span>
          </div>
        ))}
      </div>
    </section>

    <SiteFooter seasons={seasons} />
  </div>
</Page>

<style>
  .about { min-height: 100vh; }
  .ahead {
    height: 58px;
    display: flex; align-items: center; gap: 22px;
    border-bottom: 1px solid var(--hairline);
  }
  .ahead .wordmark { color: var(--ink); }
  .grow { flex: 1; }
  .back { font-size: 12px; letter-spacing: 0.1em; color: var(--secondary); }
  .back:hover { color: var(--ink); }

  .lede { padding: 40px 0 30px; max-width: 720px; }
  .atitle { margin: 0 0 16px; font-size: 42px; line-height: 1.1; letter-spacing: -0.005em; }
  .intro {
    margin: 0; font-size: 17px; line-height: 1.6; color: var(--ink-soft);
    font-family: var(--serif); font-weight: 400; text-wrap: pretty;
  }
  .intro strong { font-weight: 600; }

  /* Bands separate with a top rule, and the last one does NOT close with a
     bottom one: .site-footer's own border-top is the page's closing rule, and
     drawing both put two hairlines 28px apart. */
  .band { padding: 26px 0; border-top: 1px solid var(--hairline); max-width: 720px; }
  .band .sechead { margin-bottom: 18px; display: inline-block; }

  .terms { display: flex; flex-direction: column; gap: 20px; }
  .term-name {
    font-size: 10.5px; letter-spacing: 0.18em; font-weight: 600; color: var(--accent);
    margin-bottom: 5px;
  }
  .term-text {
    margin: 0; font-family: var(--serif); font-size: 15.5px; line-height: 1.55;
    color: var(--ink-soft); text-wrap: pretty;
  }

  .para {
    margin: 0 0 16px; font-family: var(--serif); font-weight: 400;
    font-size: 15.5px; line-height: 1.55; color: var(--ink-soft); text-wrap: pretty;
  }
  .para:last-child { margin-bottom: 0; }

  .grammar { margin: 0 0 16px; display: flex; flex-direction: column; gap: 9px; }
  .grammar-row { display: flex; align-items: baseline; gap: 14px; }
  .grammar-row dt { flex: none; min-width: 124px; }
  .grammar-row dd {
    margin: 0; font-family: var(--serif); font-size: 14.5px; line-height: 1.5;
    color: var(--ink-soft);
  }

  .stamps { display: flex; flex-direction: column; gap: 5px; margin-top: 4px; }
  .stamp-row { display: flex; gap: 12px; font-size: 12.5px; flex-wrap: wrap; }
  .stamp-conf { color: var(--ink); min-width: 190px; }
  .stamp-when { color: var(--quiet); }

  @media (max-width: 720px) {
    .atitle { font-size: 32px; }
    .intro { font-size: 15.5px; }
    .grammar-row { flex-direction: column; gap: 5px; }
    .stamp-conf { min-width: 0; }
  }
</style>
