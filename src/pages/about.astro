---
// About & method. A reading page: serif prose under ruled heads, no cards, no
// chrome. The definitions here are not a glossary appended to the product —
// they are the product's thesis restated in the words a reader needs, and the
// last clause of each is where the honesty lives.
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StageChip from "../components/StageChip.astro";
import Page from "../layouts/Page.astro";
import { aboutTiersHref, lastLooked, loadSeason } from "../lib/derive.ts";
import type { Season } from "../lib/derive.ts";
import { dayOfMonth, monShort, spell } from "../lib/format.ts";
import { laggingOf, newestLook } from "../lib/freshness.ts";
import { footprintOf } from "../lib/geo.ts";
import { unplacedLines } from "../lib/home.ts";
import {
  PHASE_BEFORE,
  PHASE_DECIDED,
  PHASE_LIVE,
  PHASE_TOURNAMENT,
} from "../lib/journal.ts";
import { activeTiers } from "../lib/player-tier.ts";
import { divisionPostseason } from "../lib/postseason-division.ts";
import { chipFrom, type StageChip as Chip } from "../lib/stage.ts";
import { site } from "../site.config.ts";

// Only conferences the data home actually carries are described — a
// conference that failed to collect is not claimed.
const seasons: Season[] = site.conferences.flatMap((key) => {
  try {
    return [loadSeason(key)];
  } catch {
    return [];
  }
});
const nameOf = (s: Season): string => site.conferenceNames[s.key] ?? s.fixtures.conference;
// The members the home page's map draws no dot for, by name and by reason,
// in the same words the map itself uses (lib/home.ts unplacedLines).
const offMap = unplacedLines(
  seasons.flatMap(
    (s) =>
      footprintOf(
        s.key,
        s.fixtures.conference,
        site.conferenceNames[s.key] ?? s.fixtures.conference,
        s.fixtures.programmes.map((p) => ({ slug: p.slug, name: p.name })),
      ).unplaced,
  ),
);
// The opening sentence counts the conferences and points at the list; it
// used to name all of them, which at nineteen was a paragraph of proper nouns
// before the reader learned what the site is. The list below names each one
// beside the day it was last collected.
const only = seasons.length === 1 ? nameOf(seasons[0] as Season) : null;

// Every conference's stamp, and a quiet flag on any more than a day behind
// the newest: the footer names the laggards and links here (lib/freshness.ts).
const newest = newestLook(seasons);
const lagDays = new Map(laggingOf(seasons, nameOf).map((l) => [l.key, l.days]));
const behind = (days: number): string =>
  days === 0 ? "more than a day behind" : `${days} ${days === 1 ? "day" : "days"} behind`;

// The round chips, keyed by real ones: the first placed tie of each kind the
// season holds, so the example is a chip some page prints, never an invented
// one. Before any postseason there is nothing to key, and the entry says so in
// words alone.
const postseason = divisionPostseason();
const sampleChips: Chip[] = [
  ...new Map(
    [...postseason.byIdentity.keys()]
      .map((id) => chipFrom(postseason, id))
      .filter((c): c is Chip => c !== null && c.label !== "")
      .map((c) => [c.competition, c] as const),
  ).values(),
].sort((a, b) => (a.competition === b.competition ? 0 : a.competition === "conference" ? -1 : 1));

// The page's own index: the sections, in order, each an anchor below.
const sections = [
  { id: "words", label: "What the words mean" },
  { id: "evidence", label: "How to read the evidence" },
  { id: "checked", label: "What is checked" },
  { id: "source", label: "Where it comes from" },
] as const;
// And the method page for player tiers, which exists only while the tiers are
// on (tiers.config.ts). The entry sits against the list before it in the
// markup so that, with them off, this page is the page it was.
const tiersOn = activeTiers() !== null;

const stamp = (iso: string): string =>
  `${monShort(iso.slice(0, 10))} ${dayOfMonth(iso.slice(0, 10))}, ${iso.slice(11, 16)} UTC`;

---

<Page
  title="Touchline — About & method"
  description="What Touchline is, where its numbers come from, and what each word on it means."
>
  <div class="tl-page about">
    {/* The shared header (tl-3rlo): the wordmark is the way home, and the
        conference menu is the way anywhere else. */}
    <SiteHeader />

    <section class="lede">
      <div class="akicker num">TOUCHLINE · {site.division.toUpperCase()}</div>
      <h1 class="atitle serif">About &amp; method</h1>
      <p class="intro">
        Touchline is a season journal for {site.division}, following{" "}
        {only ? `the ${only}` : (
          <>{spell(seasons.length)} conferences, <a class="intro-link" href="#collection">listed below</a></>
        )}. It is <strong>independent and unofficial</strong>: it has no
        connection to any conference, program or governing body. Everything on it comes
        from the programs' own published pages — and what they did not publish is shown
        as what it is.
      </p>
      <nav class="toc" aria-label="On this page">
        {sections.map((x) => <a class="toc-link" href={`#${x.id}`}>{x.label}</a>)}{tiersOn && <a class="toc-link" href={aboutTiersHref()}>Tiers</a>}
      </nav>
    </section>

    <section class="band" id="words">
      <h2 class="sechead">WHAT THE WORDS MEAN</h2>
      <div class="terms">
        <div class="term">
          <div class="term-name">PLAYED</div>
          <p class="term-text">
            A match marked final whose score was published. Touchline counts nothing it
            cannot show.
          </p>
        </div>
        <div class="term">
          <div class="term-name">A RECORD, W–D–L</div>
          <p class="term-text">
            Wins, draws and losses, always in that order: <span class="nw">15–3–2</span> is fifteen wins, three
            draws and two losses. A conference table adds points, three for a win and one
            for a draw, and counts only matches between its own members.
          </p>
        </div>
        <div class="term">
          <div class="term-name">SETTLED ON PENALTIES</div>
          <p class="term-text">
            A match level at the end of play and decided by a shootout counts as a draw in
            every record and table. The score stays the drawn one, the shootout is printed
            beside it — <span class="nw">1–1 (4–3 pens)</span> — and it decides only who goes through.
          </p>
        </div>
        <div class="term">
          <div class="term-name">ROUND CHIPS</div>
          <p class="term-text">
            {sampleChips.length > 0 && (
              <span class="term-chips">{sampleChips.map((c) => <StageChip chip={c} />)}</span>
            )}
            A postseason match wears its tournament and round: outlined for a conference
            tournament, filled for the NCAA's. R1, R2 and so on number the rounds from the
            first; QF, SF and FINAL are the quarterfinal, semifinal and final. A tie
            whose round the published results cannot place wears its tournament alone. In
            a season-strip cell too narrow for the whole chip, the round stands alone.
          </p>
        </div>
        <div class="term">
          <div class="term-name">WHERE A SEASON STANDS</div>
          <dl class="phases">
            <div class="phase">
              <dt class="num">{PHASE_BEFORE}</dt>
              <dd>No conference result yet. The table ranks every match played, against anyone, and says so.</dd>
            </div>
            <div class="phase">
              <dt class="num">{PHASE_LIVE}</dt>
              <dd>The conference has a league result, and the table is the conference table.</dd>
            </div>
            <div class="phase">
              <dt class="num">{PHASE_TOURNAMENT}</dt>
              <dd>The conference tournament has a collected match and its final is still to come. The regular-season table is final.</dd>
            </div>
            <div class="phase">
              <dt class="num">{PHASE_DECIDED}</dt>
              <dd>
                The tournament's final has been played. It says the tournament is over, not
                who won it: where no published result names a winner, Touchline names none.
              </dd>
            </div>
          </dl>
        </div>
        <div class="term">
          <div class="term-name">SCORE GAP</div>
          <p class="term-text">
            A match a program's site marked finished without ever publishing a score.
            The silence is the site's own; it stays on the record, named, and every
            collect asks again.
          </p>
        </div>
        <div class="term">
          <div class="term-name">BOX SCORE GAP</div>
          <p class="term-text">
            A match whose result Touchline holds but whose detail — the box score behind
            it — the collector could not reach. Never a friendly, never a score gap: a
            box score gap is the one absence nothing else on the page names.
          </p>
        </div>
        <div class="term">
          <div class="term-name">A SHARED MATCH</div>
          <p class="term-text">
            A match between programs in two of the conferences Touchline follows
            belongs to both. It appears in each conference's own accounting, and the
            division counts it once — so adding the conference figures together gives a
            larger number than the division's, and neither of them is wrong. When only
            one of the two programs has posted the score, Touchline takes it and says
            so: a final on one side only, named on the match page and in each
            conference's accounting until the other page catches up.
          </p>
        </div>
        <div class="term">
          <div class="term-name">V, A NEUTRAL SITE</div>
          <p class="term-text">
            A small “v” beside a score, or between two names where “at” would stand: the
            published schedule lists the match at a neutral site. Home and away stay as the
            schedule printed them, so a Match Centre may still name one side the home side.
          </p>
        </div>
        <div class="term">
          <div class="term-name">FRIENDLY</div>
          <p class="term-text">
            A match played outside the record everywhere: no wins, no goals, no counts.
            Named where it appears, counted nowhere. The {site.season} collection is the
            first to mark them, so on earlier seasons Touchline cannot tell a friendly
            from a match that counted — and does not guess which was which.
          </p>
        </div>
        <div class="term">
          <div class="term-name">LEAGUE MATCH</div>
          <p class="term-text">
            A match between two members of the same conference that counts toward its
            table. Wherever one appears — on the season line, in the week's docket, on
            the matches page — it wears the site's purple, which means nothing else.
          </p>
        </div>
        <div class="term">
          <div class="term-name">STILL LISTED AS SCHEDULED</div>
          <p class="term-text">
            A date that has passed while the program's schedule still calls the match
            scheduled: no result, no postponement, no note. A different absence from a
            score gap, and counted apart from it.
          </p>
        </div>
        <div class="term">
          <div class="term-name">THE TABLE BEFORE CONFERENCE PLAY</div>
          <p class="term-text">
            Until the first conference result, the table ranks every match a member has
            played, against anyone, and says so. From that result on it is the conference
            table, with the record across all matches kept beneath each side.
          </p>
        </div>
        <div class="term">
          <div class="term-name">MATCHWEEK</div>
          <p class="term-text">
            A Monday-to-Sunday week with at least one match in it. The season line counts
            them, and the week's docket prints the same days.
          </p>
        </div>
      </div>
    </section>

    {/* The two evidence chips the site prints, and only those: the
        championship page and its tie sheets mark which of their figures were
        published and which were worked out from what was. The other grades
        in the design system's grammar appear nowhere on a reader surface, so
        they are not defined here — a key to marks nobody meets is a grammar
        to learn for nothing (owner, 2026-09-01). */}
    <section class="band" id="evidence">
      <h2 class="sechead">HOW TO READ THE EVIDENCE</h2>
      <p class="para">
        Where a page has to say how far a figure stands from the page it came from — the
        championship's bracket and its tie sheets — it carries one of two marks.
      </p>
      <dl class="grades">
        <div class="grade">
          <dt><span class="chip chip-observed">OBSERVED ●●●</span></dt>
          <dd>
            Published. A score, a date or a name exactly as a program's own page printed
            it; Touchline copied it and computed nothing.
          </dd>
        </div>
        <div class="grade">
          <dt><span class="chip chip-derived">DERIVED ●●○</span></dt>
          <dd>
            Worked out exactly from published values — which round a tie was, who went
            through — and shown with what it was worked out from. Anyone holding the same
            pages gets the same answer. Never an estimate.
          </dd>
        </div>
      </dl>
    </section>

    <section class="band" id="checked">
      <h2 class="sechead">WHAT IS CHECKED</h2>
      <p class="para">
        Every figure on this site is recomputed from the published pages it came from
        before it is printed. A sentence that fails the recount is dropped, not softened,
        and every number in prose answers to a figure that was checked. Where a sentence
        carries figures, it opens onto them: the numbers it rests on, and the layer they
        were read from.
      </p>
    </section>

    <section class="band" id="source">
      <h2 class="sechead">WHERE IT COMES FROM</h2>
      <p class="para">
        A collector reads each program's own schedule, roster, statistics and box score
        pages, {site.cadence}, and writes what it finds to a file. This site is built from
        those files and one hand-kept reference — each program's nickname and city, the
        only facts here no collector produced. No estimates, no third-party feeds.
      </p>
      {offMap.length > 0 && (
        <p class="para">
          The home page's map draws the lower 48 states. {offMap.join(" ")}
        </p>
      )}
      <h3 class="stamps-head" id="collection">LAST COLLECTED</h3>
      <dl class="stamps num">
        {seasons.map((s) => {
          const lag = lagDays.get(s.key);
          return (
            <div class:list={["stamp-row", { "is-behind": lag !== undefined }]}>
              <dt class="stamp-conf">{nameOf(s)}</dt>
              <dd class="stamp-when">
                {stamp(lastLooked(s))}
                {lag !== undefined && newest && (
                  <span class="stamp-lag"><span class="stamp-sep"> · </span>{behind(lag)}</span>
                )}
              </dd>
            </div>
          );
        })}
      </dl>
    </section>

    <SiteFooter seasons={seasons} />
  </div>
</Page>

<style>
  .about { min-height: 100vh; }
  @media (pointer: coarse) {
    .toc-link { display: inline-flex; align-items: center; min-height: 44px; padding: 0; }
  }
  .lede { padding: 40px 0 30px; max-width: 720px; }
  /* The masthead's kicker, in its type: every page opens on a dateline. */
  .akicker { margin-bottom: 14px; font-size: 11px; letter-spacing: 0.2em; color: var(--accent); font-weight: 600; }
  .atitle { margin: 0 0 16px; font-size: 42px; line-height: 1.1; letter-spacing: -0.005em; }
  .intro {
    margin: 0; font-size: 17px; line-height: 1.6; color: var(--ink-soft);
    font-family: var(--serif); font-weight: 400; text-wrap: pretty;
  }
  .intro strong { font-weight: 600; }
  .intro-link { color: inherit; border-bottom: 1px solid var(--outline-quiet); }
  .intro-link:hover { color: var(--accent-hover); border-bottom-color: var(--accent-hover); }

  /* Bands separate with a top rule, and the last one does NOT close with a
     bottom one: .site-footer's own border-top is the page's closing rule, and
     drawing both put two hairlines 28px apart. */
  .band { padding: 26px 0; border-top: 1px solid var(--hairline); max-width: 720px; }
  .band .sechead { margin-bottom: 18px; display: inline-block; }

  .terms { display: flex; flex-direction: column; gap: 20px; }
  .term-name {
    font-size: 10.5px; letter-spacing: 0.18em; font-weight: 600; color: var(--accent);
    margin-bottom: 5px;
  }
  .term-text {
    margin: 0; font-family: var(--serif); font-size: 15.5px; line-height: 1.55;
    color: var(--ink-soft); text-wrap: pretty;
  }

  .nw { white-space: nowrap; }
  /* The round chips, the site's own, ahead of the sentence that keys them. */
  .term-chips { display: inline-flex; gap: 6px; margin-right: 8px; vertical-align: 2px; }
  /* The phase words, printed as the kickers and the home's rows print them,
     each over its meaning. */
  .phases { display: flex; flex-direction: column; gap: 10px; margin: 2px 0 0; }
  .phase dt { font-size: 10.5px; letter-spacing: 0.12em; font-weight: 600; color: var(--secondary); }
  .phase dd {
    margin: 2px 0 0; font-family: var(--serif); font-size: 15.5px; line-height: 1.55;
    color: var(--ink-soft); text-wrap: pretty;
  }

  .para {
    margin: 0 0 16px; font-family: var(--serif); font-weight: 400;
    font-size: 15.5px; line-height: 1.55; color: var(--ink-soft); text-wrap: pretty;
  }
  .para:last-child { margin-bottom: 0; }

  /* The page's index: one quiet line of section names under the intro. */
  .toc { display: flex; flex-wrap: wrap; gap: 4px 20px; margin-top: 22px; }
  .toc-link {
    font-size: 11px; letter-spacing: 0.14em; font-weight: 600; text-transform: uppercase;
    color: var(--secondary); padding: 2px 0;
  }
  .toc-link:hover { color: var(--accent-hover); }
  .toc-link:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
  .band[id], .stamps-head { scroll-margin-top: 16px; }

  /* The evidence key: the site's own chips, each beside its definition. */
  .grades { display: flex; flex-direction: column; gap: 14px; margin: 4px 0 0; }
  .grade { display: grid; grid-template-columns: 128px minmax(0, 1fr); column-gap: 16px; align-items: baseline; }
  .grade dt { margin: 0; }
  .grade dd {
    margin: 0; font-family: var(--serif); font-size: 15.5px; line-height: 1.55;
    color: var(--ink-soft); text-wrap: pretty;
  }

  /* Every conference's stamp, two aligned columns on hairlines: the name, and
     when it was last collected. One more than a day behind the newest is
     flagged in the caution colour, quietly — a word, not a badge. */
  .stamps-head {
    margin: 22px 0 6px; font-size: 10.5px; letter-spacing: 0.18em; font-weight: 600;
    color: var(--ink);
  }
  .stamps { display: grid; grid-template-columns: max-content minmax(0, 1fr); margin: 0; }
  .stamp-row { display: contents; }
  .stamp-conf, .stamp-when {
    margin: 0; padding: 6px 0; border-top: 1px solid var(--hairline-soft); font-size: 12.5px;
  }
  .stamp-conf { color: var(--ink); padding-right: 28px; }
  .stamp-when { color: var(--quiet); }
  .stamp-lag { color: var(--draw); font-weight: 600; }

  @media (max-width: 720px) {
    .atitle { font-size: 32px; }
    .intro { font-size: 15.5px; }
    .grade { grid-template-columns: minmax(0, 1fr); row-gap: 6px; }
    /* The name takes what the stamp leaves and wraps; the stamp never does,
       and a lag flag drops beneath it rather than splitting it. */
    .stamps { grid-template-columns: minmax(0, 1fr) max-content; }
    .stamp-conf { padding-right: 16px; }
    .stamp-when { white-space: nowrap; text-align: right; }
    .stamp-lag { display: block; }
    .stamp-sep { display: none; }
  }
</style>
