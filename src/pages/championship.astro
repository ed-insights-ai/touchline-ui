---
// The championship: the NCAA Division II bracket and the conference
// tournaments that feed it. A light page, because it explains time.
//
// Everything here is read from the fixtures' published stage (contract
// changelog 2026-11-08) and folded across the configured conferences' files
// by lib/postseason.ts. The final's result is OBSERVED; the route through the
// bracket (which round a tie was, who went through where no record names a
// winner) is DERIVED from the results, and the masthead says which is which.
// No bracket document is collected yet, so there are no seeds, no published
// region names and no "winner of" slots: regions are headed by the ground
// that hosted their quarterfinal, and nothing is drawn that the results have
// not joined.
import Bracket from "../components/Bracket.astro";
import Masthead from "../components/Masthead.astro";
import FieldStrip from "../components/FieldStrip.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TieBox from "../components/TieBox.astro";
import TieSheet from "../components/TieSheet.astro";
import TitleMark from "../components/TitleMark.astro";
import Page from "../layouts/Page.astro";
import { hasScore, matchHref } from "../lib/derive.ts";
import { clockTime, dayOfMonth, dowLong, dowShort, monShort, spell, statusWord } from "../lib/format.ts";
import { homeSeasons } from "../lib/home.ts";
import {
  shownKickoffOf,
  regionsOf,
  roundNameOf,
  routeOf,
  sameDayNote,
  type Tie,
  tieAnchor,
  verdictLine,
  verdictOf,
} from "../lib/postseason.ts";
import { divisionPostseason } from "../lib/postseason-division.ts";
import { currentDivision, site } from "../site.config.ts";

const p = divisionPostseason();
const ncaa = p.ncaa;
const seasons = homeSeasons();
const configured = site.conferences.length;
const day = (iso: string): string => `${dowShort(iso)} ${monShort(iso)} ${dayOfMonth(iso)}`;
const name = (t: Tie, slug: string): string => t.match.season.names.name(slug);

const final = ncaa.final;
// Decided is the final played with a published score; a champion is named
// only where a record says who won it (the score, or a collected shootout).
// A final drawn with no shootout collected is decided and names no one.
const verdict = verdictOf(ncaa);
const decided = ncaa.decided;
const champion = verdict.kind === "won" ? verdict.champion.slug : null;
const field = new Set(ncaa.ties.flatMap((t) => [t.fixture.home, t.fixture.away]));
const conferencesIn = new Set([...field].map((slug) => p.conferenceOf.get(slug)).filter(Boolean));
const played = ncaa.ties.filter((t) => t.fixture.status === "final" && hasScore(t.fixture)).length;
const pens = ncaa.ties.filter((t) => t.shootout !== null).length;

// The champion's route: every tie they played, in order.
const route = champion ? ncaa.ties.filter((t) => t.fixture.home === champion || t.fixture.away === champion) : [];
const goals = route.reduce(
  (acc, t) => {
    if (!hasScore(t.fixture) || !champion) return acc;
    const home = t.fixture.home === champion;
    acc.for += home ? t.fixture.home_score : t.fixture.away_score;
    acc.against += home ? t.fixture.away_score : t.fixture.home_score;
    return acc;
  },
  { for: 0, against: 0 },
);
// The round being played next: the earliest placed round with a collected
// tie still to play. While the championship is under way the headline names
// it and its day, so a reader learns first what is on and when; how much is
// collected is the provenance line's to say, once.
// Only a tie still on the schedule counts: a postponed or cancelled one is
// not what is on next.
const toPlay = ncaa.ties.filter(
  (t) => t.round > 0 && (t.fixture.status === "scheduled" || t.fixture.status === "live") && !t.disputed,
);
const nextRound = toPlay.length > 0 ? Math.min(...toPlay.map((t) => t.round)) : null;
const nextTies = nextRound === null ? [] : ncaa.ties.filter((t) => t.round === nextRound);
const kickoffTime = (t: Tie): string => shownKickoffOf(t).time ?? "99:99";
const nextToPlay = toPlay
  .filter((t) => t.round === nextRound)
  .sort((a, b) => a.fixture.date.localeCompare(b.fixture.date) || kickoffTime(a).localeCompare(kickoffTime(b)));
const nextLabel = nextTies[0]?.label ?? "";
const ROUND_HEAD: Record<string, string> = {
  R1: "First round",
  R2: "Second round",
  R3: "Third round",
  QF: "Quarterfinals",
  SF: "Semifinals",
  FINAL: "The final",
};
const ROUND_ADJ: Record<string, string> = {
  R1: "first-round",
  R2: "second-round",
  R3: "third-round",
  QF: "quarterfinal",
  SF: "semifinal",
  FINAL: "final",
};
const nextHead = ROUND_HEAD[nextLabel] ?? roundNameOf(nextLabel);
const nextDates = [...new Set(nextToPlay.map((t) => t.fixture.date))].sort();
const nextWhen = (long: boolean): string => {
  const a = nextDates[0];
  const b = nextDates.at(-1);
  if (!a || !b) return "";
  if (a === b) return long ? `${dowLong(a)}, ${monShort(a)} ${dayOfMonth(a)}` : day(a);
  return `${monShort(a)} ${dayOfMonth(a)}–${a.slice(5, 7) === b.slice(5, 7) ? dayOfMonth(b) : `${monShort(b)} ${dayOfMonth(b)}`}`;
};
const cap = (s: string): string => s.charAt(0).toUpperCase() + s.slice(1);

// A side's road to its next tie, in one sentence from its latest tie before
// it: who it beat and by what, as published. A shootout is a draw and says
// so; a side through only because it appears in the next round says that.
// Every side gets a line: one with no earlier tie collected says so, and one
// whose earlier tie has no settled result says that, never the same thing.
const nextAdj = ROUND_ADJ[nextLabel] ?? "next";
const routeLine = (prev: Tie, slug: string): string => {
  const f = prev.fixture;
  const home = f.home === slug;
  const me = name(prev, slug);
  const them = name(prev, home ? f.away : f.home);
  const when = `${monShort(f.date)} ${dayOfMonth(f.date)}`;
  if (prev.disputed || f.status !== "final" || !hasScore(f) || prev.through?.slug !== slug) {
    return `${me} v ${them} on ${when}: no settled result on the record.`;
  }
  const mine = home ? f.home_score : f.away_score;
  const theirs = home ? f.away_score : f.home_score;
  const so = prev.shootout;
  if (prev.through.by === "shootout" && so) {
    const a = home ? so.home : so.away;
    const b = home ? so.away : so.home;
    return `${me} and ${them} drew ${mine}–${theirs} on ${when}; ${me} went through on penalties, ${a}–${b}, as published.`;
  }
  if (prev.through.by === "next round") {
    return `${me} v ${them}, ${mine}–${theirs} on ${when}; ${me} went through, known only from this ${nextAdj} tie.`;
  }
  return `${me} beat ${them} ${mine}–${theirs} on ${when}.`;
};
// The kickoff the bracket shows too (shownKickoffOf): where the printed
// record has no time, the record it comes from is named; where the records
// print different times, that is said.
const kickoffShown = (t: Tie): { time: string | null; note: string | null } => {
  const k = shownKickoffOf(t);
  const whose = (v: { by: string | null; source: string | null }): string =>
    v.by ? `${name(t, v.by)}'s schedule` : (v.source ?? "another record");
  const notes = [k.from ? `Time from ${whose(k.from)}.` : "", k.split ? "Schedules list different times." : ""];
  return { time: clockTime(k.time ?? undefined) ?? null, note: notes.filter(Boolean).join(" ") || null };
};
// The semifinals and the final have their own cards (#finals); the list is
// for the rounds before them.
const nextCards =
  decided || nextLabel === "SF" || nextLabel === "FINAL"
    ? []
    : nextToPlay.map((t) => {
        const sidesOf = [t.fixture.home, t.fixture.away];
        const prevs = sidesOf.map((slug) => routeOf(ncaa, t, slug).at(-1) ?? null);
        const lines = prevs.every((x) => x === null)
          ? ["No earlier tie is collected for either side."]
          : sidesOf.map((slug, i) => {
              const prev = prevs[i];
              return prev ? routeLine(prev, slug) : `No earlier tie is collected for ${name(t, slug)}.`;
            });
        return { tie: t, ...kickoffShown(t), lines };
      });

const ROUND_WORD: Record<string, string> = {
  R1: "the first round",
  R2: "the second round",
  R3: "the third round",
  QF: "the quarterfinals",
};

const headline = (() => {
  if (champion && final) return `${name(final, champion)} are national champions`;
  if (decided && final) return "The NCAA final is played";
  if (ncaa.ties.length === 0) return "The NCAA field is not yet collected";
  if (nextRound !== null && nextLabel && nextDates.length > 0) return `${nextHead}: ${nextWhen(true)}`;
  return "The NCAA championship is under way";
})();
const dek = (() => {
  if (champion && final) {
    const other = final.fixture.home === champion ? final.fixture.away : final.fixture.home;
    const cs = final.fixture.home === champion ? final.fixture.home_score : final.fixture.away_score;
    const os = final.fixture.home === champion ? final.fixture.away_score : final.fixture.home_score;
    const at = final.fixture.venue ? ` at ${final.fixture.venue}` : "";
    const entered = route[0]?.label ? ROUND_WORD[route[0].label] : null;
    const wins = route.filter((t) => t.through?.slug === champion).length;
    const record = `${spell(wins)} ${wins === 1 ? "win" : "wins"} from ${spell(route.length)} ${route.length === 1 ? "match" : "matches"}`;
    // A final won on penalties is a draw: the dek says so, and gives the
    // shootout as published.
    const so = final.shootout;
    const how =
      verdict.kind === "won" && verdict.champion.by === "shootout" && so
        ? `They drew ${cs}–${os} with ${name(final, other)}${at} on ${day(final.fixture.date)} and won on penalties, ${final.fixture.home === champion ? so.home : so.away}–${final.fixture.home === champion ? so.away : so.home}, as published`
        : `They beat ${name(final, other)} ${cs}–${os}${at} on ${day(final.fixture.date)}`;
    return `${how}: ${record}${entered ? `, having entered in ${entered}` : ""}. They scored ${spell(goals.for)} and conceded ${spell(goals.against)} on the way.`;
  }
  if (decided && final) {
    const f = final.fixture;
    const line = verdictLine(ncaa, (slug) => name(final, slug));
    return `${name(final, f.home)} and ${name(final, f.away)} played the final on ${day(f.date)}, ${f.home_score}–${f.away_score}. ${line.note ?? ""}`.trim();
  }
  if (ncaa.ties.length === 0) {
    return "No collected schedule lists an NCAA tie with an opponent yet. The conference tournaments that decide most of the field are below, as their results come in.";
  }
  if (nextRound !== null && nextLabel) {
    const n = nextTies.length;
    // A tie whose records disagree counts in no other column (TieSheet says
    // so), so every tie lands in exactly one count and the counts sum to n.
    const settledOf = nextTies.filter((t) => !t.disputed);
    const done = settledOf.filter((t) => t.fixture.status === "final").length;
    const ahead = nextToPlay.length;
    const adj = ROUND_ADJ[nextLabel] ?? roundNameOf(nextLabel).toLowerCase();
    // Each tie counted by its status as the record has it: a postponed or
    // cancelled tie is said to be so, never folded into "to play".
    const tally = [
      [done, "played"],
      [ahead, "to play"],
      [settledOf.filter((t) => t.fixture.status === "postponed").length, "postponed"],
      [settledOf.filter((t) => t.fixture.status === "cancelled").length, statusWord("cancelled")],
      [n - settledOf.length, "with records that disagree"],
    ] as const;
    const first =
      ahead === n
        ? `${cap(spell(n))} ${adj} ${n === 1 ? "tie is" : "ties are"} collected, ${n === 1 ? "still" : "all still"} to play.`
        : done + ahead === n
          ? `${cap(spell(done))} of the ${spell(n)} ${adj} ties collected ${done === 1 ? "is" : "are"} played.`
          : `${cap(spell(n))} ${adj} ${n === 1 ? "tie is" : "ties are"} collected: ${tally
              .filter(([c]) => c > 0)
              .map(([c, w]) => `${spell(c)} ${w}`)
              .join(", ")}.`;
    return `${first} The bracket below is drawn from the results alone.`;
  }
  return `${played} of ${ncaa.ties.length} collected ties played. The bracket below is drawn from those results alone.`;
})();

const sfs = ncaa.ties.filter((t) => t.label === "SF");
const finalsCards = [
  ...(sfs[0] ? [{ tie: sfs[0], cls: "sf1", lab: "Semifinal" }] : []),
  ...(sfs[1] ? [{ tie: sfs[1], cls: "sf2", lab: "Semifinal" }] : []),
  ...(final ? [{ tie: final, cls: "final", lab: "Final" }] : []),
];

// Conference tournaments, in configuration order of their first code.
const order = new Map(seasons.map((s, i) => [s.fixtures.conference, i]));
const conferences = [...p.conference].sort(
  (a, b) => (order.get(a.codes[0] ?? "") ?? 99) - (order.get(b.codes[0] ?? "") ?? 99),
);

// Every programme with a tie, for the path tracer: one empty anchor each, and
// one generated rule each, so #path-x lights x's rows and nothing else dims.
const traced = [...new Set([...p.byIdentity.values()].flatMap((t) => [t.fixture.home, t.fixture.away]))].sort();
const pathCss = traced
  .map(
    (slug) =>
      `.champ:has(#path-${slug}:target) .p-${slug}{border-left-color:var(--accent);background:var(--accent-wash)}` +
      `.champ:has(#path-${slug}:target) .p-${slug} .n,.champ:has(#path-${slug}:target) .p-${slug} .g{color:var(--ink)}`,
  )
  .join("\n");
const allTies = [...p.byIdentity.values()];

// The page's sections, in order, for the jump row under the masthead: only
// the ones this build draws.
const jumps = [
  ...(finalsCards.length > 0 ? [{ href: "#finals", label: "The finals" }] : []),
  ...(ncaa.ties.length > 0 ? [{ href: "#bracket", label: "The bracket" }] : []),
  ...(ncaa.ties.length > 0 ? [{ href: "#field", label: "The field" }] : []),
  { href: "#conference-tournaments", label: "Conference tournaments" },
];
const hasRegions = regionsOf(ncaa).length > 0;
// The legend keys only the marks this bracket draws.
const anyPens = ncaa.ties.some((t) => t.shootout !== null);
const anyAdv = ncaa.ties.some((t) => t.through?.evidence === "DERIVED");
// Ties the graph could not place: before regions, the bracket draws them in
// a column beside the tree, and its note says so only when there are some.
const unjoined = !hasRegions && ncaa.ties.some((t) => t.round === 0);
// The conference tournaments collected, against the conferences configured:
// a joint tournament counts each of its codes.
const codesIn = new Set(p.conference.flatMap((t) => t.codes)).size;
const noCodes: ReadonlyMap<string, string> = new Map();

// Ties set apart: records that give one side two ties on one day and that no
// record settles (lib/postseason.ts sameDayGroups). They count nowhere above;
// each is named here so the count's silence about it is said, not hidden.
const apartGroups = [...new Set(ncaa.apart.map((t) => t.sameDay))].flatMap((sd) => {
  const ties = ncaa.apart.filter((t) => t.sameDay === sd);
  const first = ties[0];
  if (!sd || !first) return [];
  return [
    {
      links: ties.map((t) => ({
        href: `#${tieAnchor(t)}`,
        label: `${day(t.fixture.date)} · ${name(t, t.fixture.home)} v ${name(t, t.fixture.away)}`,
      })),
      note: sameDayNote(sd, (slug) => name(first, slug)),
    },
  ];
});
---

<Page
  title="Touchline — The championship"
  description={`The NCAA ${currentDivision.name} ${site.gender === "women" ? "women's" : "men's"} soccer championship and the conference tournaments, drawn from the published results.`}
>
  <div class="tl-page champ" id="top">
    {/* The header and the masthead sit flush, as on every page; the page's
        30px rhythm starts beneath them. */}
    <div>
    <SiteHeader />
    {ncaa.ties.length === 0 && (
      <div class="path-anchors" aria-hidden="true">
        {traced.map((slug) => <span id={`path-${slug}`}></span>)}
      </div>
    )}

    <Masthead
      kicker={`NCAA ${currentDivision.name.toUpperCase()} CHAMPIONSHIP${decided && final ? ` · DECIDED · ${monShort(final.fixture.date).toUpperCase()} ${dayOfMonth(final.fixture.date)}` : ""}`}
      headline={headline}
      title={headline}
      dek={dek}
      strip={ncaa.ties.length > 0
        ? [
            `${played} played`,
            `${field.size} programs`,
            `${conferencesIn.size} of ${configured} conferences in the field`,
            ...(pens > 0 ? [`${pens} ${pens === 1 ? "tie" : "ties"} settled on penalties`] : []),
          ]
        : []}
    >
      {ncaa.ties.length > 0 && (
        <div class="ev">
          {decided && <span class="chip chip-observed">OBSERVED ●●●</span>}
          {decided && final && <span class="prov">The final, from its published score, {day(final.fixture.date)}.</span>}
          <span class="chip chip-derived">DERIVED ●●○</span>
          <span class="prov">
            The route and the rounds, recomputed from the {ncaa.ties.length} {ncaa.ties.length === 1 ? "tie" : "ties"} collected, {played} of them played.
          </span>
        </div>
      )}
      {jumps.length > 1 && (
        <nav class="jumps" slot="after" aria-label="On this page">
          {jumps.map((j) => <a href={j.href}>{j.label}</a>)}
        </nav>
      )}
    </Masthead>
    </div>

    {finalsCards.length > 0 && (
      <section class="block" id="finals">
        <h2 class="sechead">THE FINALS</h2>
        <div class="finals">
          {finalsCards.map(({ tie, cls, lab }) => {
            const f = tie.fixture;
            const sides = [f.home, f.away].map((slug) => ({
              slug,
              goals: hasScore(f) ? (slug === f.home ? f.home_score : f.away_score) : null,
              pens: tie.shootout ? (slug === f.home ? tie.shootout.home : tie.shootout.away) : null,
              state: tie.through ? (tie.through.slug === slug ? "w" : "l") : "",
            }));
            return (
              <a class:list={["mcard", cls]} href={matchHref(tie.match.key, f.id)}>
                <span class="lab"><span>{lab}</span><span>{day(f.date)}</span></span>
                {sides.map((s) => (
                  <span class:list={["side", s.state]}>
                    <span class="n">
                      {cls === "final" && champion === s.slug && <TitleMark kind="trophy" />}
                      {name(tie, s.slug)}<small>{p.conferenceOf.get(s.slug) ?? ""}</small>
                    </span>
                    <span class="g num">{s.goals ?? ""}{s.pens !== null && <span class="pk">({s.pens})</span>}</span>
                  </span>
                ))}
                <span class="foot"><span>{f.venue ?? ""}</span><b>Match Center →</b></span>
              </a>
            );
          })}
          {sfs.length === 2 && !final && (
            <div class="mcard final pending">
              <span class="lab"><span>Final</span><span>To be played</span></span>
              <span class="meet">The two semifinal winners meet.</span>
            </div>
          )}
        </div>
      </section>
    )}

    {nextCards.length > 0 && (
      <section class="block next" aria-label={`${nextHead}, ${nextWhen(true)}`}>
        <h2 class="sechead">{nextHead.toUpperCase()} · {nextWhen(false).toUpperCase()}</h2>
        <div class="nlist">
          {nextCards.map(({ tie, time, note, lines }) => (
            <a class="ncard" href={`#${tieAnchor(tie)}`}>
              <span class="nwhen"><span>{day(tie.fixture.date)}</span>{time && <b class="num">{time}</b>}</span>
              {note && <span class="nnote">{note}</span>}
              {[tie.fixture.home, tie.fixture.away].map((slug) => (
                <span class="nside">{name(tie, slug)}<small>{p.conferenceOf.get(slug) ?? ""}</small></span>
              ))}
              <span class="nroute">{lines.map((l) => <span>{l}</span>)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {ncaa.ties.length > 0 && (
      <section class="block" id="bracket">
        <div class="path-anchors" aria-hidden="true">
          {traced.map((slug) => <span id={`path-${slug}`}></span>)}
        </div>
        <h2 class="sechead">THE BRACKET</h2>
        <div class="legend">
          {played > 0 && <span class="sw"><b class="num">2</b>&nbsp;went through</span>}
          {played > 0 && <span class="sw"><span class="faint">1</span>&nbsp;went out</span>}
          {anyPens && <span class="sw"><span class="num">1<span class="pk">(4)</span></span>&nbsp;penalties, as published; the match is a draw</span>}
          {anyAdv && (
            <span class="sw"><span class="adv">ADV</span><span class="advdot" aria-hidden="true"></span>&nbsp;went through, known only from the next round</span>
          )}
          <span class="sw"><span class="bar"></span>&nbsp;traced path</span>
        </div>
        <Bracket tournament={ncaa} conferenceOf={p.conferenceOf} />
        <p class="provenance">
          {hasRegions
            ? "Regions are headed by the ground that hosted their quarterfinal, a fact from the fixtures."
            : unjoined
              ? "Each tie is joined to its winner's next collected tie; ties the results have not yet joined sit beside the tree, not paired."
              : "Each tie is joined to its winner's next collected tie."}{" "}
          No bracket document is collected, so there are no seeds or published region names. Select any tie.
        </p>
      </section>
    )}

    {ncaa.ties.length > 0 && (
      <section class="block" id="field">
        <h2 class="sechead">THE FIELD</h2>
        <FieldStrip tournament={ncaa} conferenceOf={p.conferenceOf} />
        {apartGroups.map((g) => (
          <p class="apart">
            <span class="chip chip-context">Set apart</span>
            <span>
              Not counted above:{" "}
              {g.links.map((a, i) => (
                <>{i > 0 && " and "}<a href={a.href}>{a.label}</a></>
              ))}. {g.note}
            </span>
          </p>
        ))}
      </section>
    )}

    <section class="block" id="conference-tournaments">
      <h2 class="sechead">THE CONFERENCE TOURNAMENTS</h2>
      {conferences.length === 0 ? (
        <p class="empty">No conference tournament match is collected yet.</p>
      ) : (
        <>
          <p class="prov">{codesIn} of {configured} conferences with a tournament match collected.</p>
          {/* A phone reads the champions first, one line each; the scores
              fold beneath them. Wide, the fold is open and its summary hidden,
              so the grid reads as it always has. */}
          <ul class="champ-list">
            {conferences.map((t) => {
              const v = verdictOf(t);
              const nameIn = (slug: string): string => (t.final ?? (t.ties[0] as Tie)).match.season.names.name(slug);
              const who = v.kind === "won" ? nameIn(v.champion.slug) : null;
              // No champion: the tile's own head says why (no final yet, a
              // drawn final, a shootout no side can be matched to).
              const why = who ? "" : verdictLine(t, nameIn).head;
              return (
                <li>
                  <b>{t.codes.join("/")}</b>
                  {who ? (
                    <span class="cl-who"><TitleMark kind="ribbon" />{who}</span>
                  ) : (
                    <span class="cl-none">{why}</span>
                  )}
                </li>
              );
            })}
          </ul>
          <details class="tfold" open>
            <summary>
              <span class="show">Show every tournament's scores</span><span class="hide">Hide the scores</span>
              <svg class="chevron" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 L5 6.5 L8 3.5" /></svg>
            </summary>
            <div class="tourneys">
              {conferences.map((t) => {
                const latest = [...t.ties].sort((a, b) => b.round - a.round || b.fixture.date.localeCompare(a.fixture.date));
                const shown = t.final ? [t.final] : latest.slice(0, 2);
                // Decided is the final played; a champion is named only where a
                // record says who won (lib/postseason.ts verdictLine).
                const line = verdictLine(t, (slug) => (t.final ?? (t.ties[0] as Tie)).match.season.names.name(slug));
                const won = verdictOf(t).kind === "won";
                return (
                  <div class="tourney">
                    <div class="thead">
                      <b>{t.codes.join("/")}</b>
                      <span class="th-who">{won && <TitleMark kind="ribbon" />}{line.head}</span>
                    </div>
                    {/* One conference's tournament: its code is the heading's,
                        so the rows do not repeat it. */}
                    {shown.map((tie) => <TieBox tie={tie} conferenceOf={t.codes.length > 1 ? p.conferenceOf : noCodes} />)}
                    {line.note && <p class="tnote">{line.note}</p>}
                  </div>
                );
              })}
            </div>
          </details>
        </>
      )}
      <p class="provenance">
        A tournament's rounds are counted back from its latest match: each tie is one round before the next tie
        either side played. A tournament whose results do not join up is listed without a final.
      </p>
    </section>

    {allTies.map((tie) => {
      const tournament = p.tournamentOf.get(tie.identity);
      return tournament ? (
        <TieSheet
          tie={tie}
          tournament={tournament}
          conferenceOf={p.conferenceOf}
          seasonOf={p.seasonOf}
          back={tie.competition === "ncaa" ? "#bracket" : "#conference-tournaments"}
        />
      ) : null;
    })}

    <SiteFooter seasons={seasons} />
  </div>
</Page>

<style is:inline set:html={pathCss}></style>

<script>
  // A phone reads the champions list first, so the tournaments' scores start
  // folded there. Without script the fold stays open: the wide reading.
  // Widened past a phone's width, the fold opens again, since the wide page
  // draws no champions list above it.
  const narrow = matchMedia("(max-width: 560px)");
  const folds = Array.from(document.querySelectorAll<HTMLDetailsElement>(".tfold"));
  if (narrow.matches) for (const d of folds) d.open = false;
  narrow.addEventListener("change", (e) => {
    if (!e.matches) for (const d of folds) d.open = true;
  });
</script>

