---
// The national read: every configured conference on one page, side by side.
//
// There is no cross-conference competition, so this page computes no combined
// table. What it shows is what the collect actually holds: last night's
// published finals in one ledger — one row per MATCH, folded across the files
// that collected it — each conference's own counts and opener,
// and the current headline of each season journal, verbatim, linking to the
// season page that carries it. The masthead is derived — a kicker, a dek and a
// counts strip, assembled deterministically from counts and opener dates,
// never a model call. Its headline altitude stays empty until one writes it.
//
// Every count here comes through the same functions as the season pages'
// mastheads, so the two surfaces cannot disagree; the tests recount both from
// the fixture lists and make them meet.
import HomeConferences from "../components/HomeConferences.astro";
import LedgerRow from "../components/LedgerRow.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Masthead from "../components/Masthead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Page from "../layouts/Page.astro";
import { championshipHref, seasonHref } from "../lib/derive.ts";
import { divisionCounts } from "../lib/division.ts";
import {
  dayOfMonth,
  dowLong,
  monLong,
  monShort,
  spell,
} from "../lib/format.ts";
import { type ConferenceFootprint, footprintOf } from "../lib/geo.ts";
import {
  type BandColumn,
  type CardView,
  championshipLine,
  conferenceOfProgramme,
  headlineProgrammeOf,
  homeBands,
  homeColumns,
  homeLayout,
  homeSeasons,
  lastNightLedger,
  lastNightOf,
  lastNightOpen,
  mostImminentKey,
  nationalAsOf,
  ncaaNextDay,
  nationalDescription,
  nationalMasthead,
  opensLine,
} from "../lib/home.ts";
import { editorial, loadJournal, loadNationalJournal } from "../lib/journal.ts";
import { conferenceEntries, ledgerSummary, splitLedger } from "../lib/nav.ts";
import { divisionPostseason } from "../lib/postseason-division.ts";
import { site } from "../site.config.ts";

const seasons = homeSeasons();
const columns = homeColumns(seasons);
const imminent = mostImminentKey(columns);
// The division's figures are counts of MATCHES, not the sum of the columns: a
// match between two of these conferences is in both files, and the sum held it
// twice (tui-2l6). The cards below still print their own conference's count,
// which is right, and the About page carries the sentence a reader who adds
// the three of them up is owed.
const national = divisionCounts(seasons);

const asOf = nationalAsOf(seasons);
// The division's journal writes the headline and the dek and nothing else.
// Absent, or emptied by the validator, the masthead is exactly what it was
// before one existed — the page never waits on a model call.
const journal = loadNationalJournal(site.season, site.gender);
const lede = nationalMasthead(columns, asOf, national, journal);
// A share card and a search result meet these facts with no cards and no strip
// beneath them, so the description keeps the full prose the masthead stopped
// printing — and keeps it stable, because it identifies the page as much as it
// summarises it.
const description = nationalDescription(columns, national);
const lastNight = lastNightOf(asOf);
const ledger = lastNightLedger(seasons, lastNight);
// The ledger's code column is sized for its widest truthful cell: the two
// longest codes the site follows, joined the way the row joins them. Read
// from the files, never typed: the thirteenth conference (GLIAC, printed
// beside G-MAC) outgrew a fixed width and ran into the away side at 390.
const codeLengths = seasons.map((s) => s.fixtures.conference.length).sort((a, b) => b - a);
const lconfChars = (codeLengths[0] ?? 0) + (codeLengths[1] ?? 0) + " · ".length;
const leftOpen = lastNightOpen(seasons, lastNight);
// The ledger keeps its place and its first rows; the rest fold behind a
// native disclosure whose summary counts the whole night (tl-tav2). The cap
// is config (site.homeLedgerCap) and the count is the folded set's length,
// so the summary can never claim a result the ledger does not hold.
const { open: ledgerOpen, folded: ledgerFolded } = splitLedger(ledger, site.homeLedgerCap);
// Once the collect holds an NCAA tie, one quiet line under the night points
// at the championship, with the page's own played count (lib/home.ts
// championshipLine counts it the way championship.astro does). Before the
// field is collected there is no line, and nothing says why: the header's
// championship tab is absent then too.
const champLine = championshipLine(divisionPostseason().ncaa);

// Under the night's results, the NCAA's day ahead: today's ties when any is
// still to play today, else the next date that has one (lib/home.ts
// ncaaNextDay). The rows are the ledger's own row, carrying the round in the
// code cell and the published kickoff where the score will go, each linking to
// its Match Centre. Capped at the ledger's own cap; the rest are on the
// championship page, and the line says how many, so nothing is hidden behind
// a count the reader cannot follow.
const ncaaDay = ncaaNextDay(divisionPostseason().ncaa, asOf);
const dayRows = ncaaDay ? ncaaDay.matches.slice(0, site.homeLedgerCap) : [];
const dayMore = ncaaDay ? ncaaDay.matches.length - dayRows.length : 0;
const dayLabel = (iso: string): string =>
  `${dowLong(iso).toUpperCase()} ${monShort(iso).toUpperCase()} ${dayOfMonth(iso)}`;

// The find-your-conference strip under the masthead: every collected
// conference in navigation order, the abbreviation printed and the full name
// on the title, each a direct link to its overview. The same list the header's
// menu offers (lib/nav.ts), so the two cannot disagree.
const strip = conferenceEntries(seasons);

// The line each card carries, and the day it last changed.
//
// It used to be the season journal's headline, verbatim. One string cannot
// obey two surface contracts: on the season page the headline heads a page
// that prints the counts and the table beneath it, and here it sits under the
// conference code, the full name, the opens-date and the played count — so
// all three headlines restated the card's own figures back at it.
//
// The wire is the journal's slot for this surface. A journal that has not
// written one falls back to the headline, exactly as before, which is what
// keeps the change safe while old journal files are still on disk. The date
// tag rides only on a wire: nothing knows when a headline last changed.
const cards = new Map(
  columns.map((c) => {
    const journal = loadJournal(c.season);
    const wire = journal?.wire;
    return [
      c.key,
      {
        line: wire?.line ?? editorial(c.season, journal).headline,
        // A stamp only when the wire is older than the data it sits on: on
        // the day it was written, the page's own date already says so (the
        // same rule as the season and national mastheads, owner 2026-09-01).
        updated: wire?.updated && wire.updated !== c.season.asOf ? wire.updated : null,
      },
    ];
  }),
);
const cardStamp = (key: string): string | null => {
  const iso = cards.get(key)?.updated;
  // "WRITTEN", not "UPDATED": what is old is the sentence, not the figures
  // beside it, which were collected today — the season masthead's own
  // correction (journal.ts headlineWrittenStamp), in the card's fewer words.
  return iso ? `WRITTEN ${monShort(iso).toUpperCase()} ${dayOfMonth(iso)}` : null;
};

const night = dowLong(lastNight);
const sentenceCase = (text: string): string => text.charAt(0).toUpperCase() + text.slice(1);

// LAST NIGHT has three states and speaks in two of them. A night that
// published nothing says so where the ledger would have been. A night that
// left something without a score discloses it, because a reader cannot see an
// absence in a list. A night where every result came through ends at the
// results: stating a zero belongs where a count is claimed, and annotating the
// absence of a problem is not the same thing.
//
// "Matches", not "finals". Two thirds of the fixtures in this set were never
// marked final by their own source — they are the unscored, not the silent —
// and naming them finals would publish a status nobody published.
const openLine =
  leftOpen.length > 0
    ? `${sentenceCase(spell(leftOpen.length))} ${
        leftOpen.length === 1 ? "match" : "matches"
      } from ${night} ${leftOpen.length === 1 ? "stands" : "stand"} without a published score.`
    : null;

// What each card prints, in kickoff order. The card takes a view, not a
// Season, so the layout below can be exercised on a synthetic set; the view
// also carries what a band head needs (live, opener, kickoff).
const views: (CardView & BandColumn)[] = columns.map((c) => ({
  key: c.key,
  code: c.code,
  name: c.name,
  opens: opensLine(c),
  imminent: c.key === imminent && !c.live,
  played: c.counts.played,
  total: c.counts.total,
  line: cards.get(c.key)?.line ?? null,
  stamp: cardStamp(c.key),
  href: seasonHref(c.key),
  live: c.live,
  opensOn: c.opensOn,
  kickoff: c.kickoff,
  phase: c.phase,
}));
// N columns from config — the count is the conference list's, never a literal.
// Up to the configured cap that is one column each; past it the same cards
// flow into region bands (site.homeColumnCap, lib/home.ts).
const layout = homeLayout(columns.length);
const bands = homeBands(views);

// The conference the division's headline is about, resolved and never
// matched: the journal's basis names the programme, the member index names
// the followed conference that lists it, and the band that holds that
// conference opens at rest (lib/home.ts openBandIndex). A headline about a
// programme no followed season lists resolves to nothing, and the section
// falls back to the imminent band.
const headlineProgramme = headlineProgrammeOf(journal);
const conferenceOf = (slug: string): string | null => conferenceOfProgramme(seasons, slug);
const headlineKey = headlineProgramme === null ? null : conferenceOf(headlineProgramme);
const headlineColumn = columns.find((c) => c.key === headlineKey);
const headline =
  headlineProgramme !== null && headlineColumn
    ? {
        key: headlineColumn.key,
        code: headlineColumn.code,
        programme:
          headlineColumn.season.fixtures.programmes.find((p) => p.slug === headlineProgramme)
            ?.name ?? headlineColumn.season.names.name(headlineProgramme),
      }
    : null;

// Where each conference plays, for the map beside the bands.
const footprints: ConferenceFootprint[] = columns.map((c) =>
  footprintOf(
    c.key,
    c.code,
    c.name,
    c.season.fixtures.programmes.map((p) => ({ slug: p.slug, name: p.name })),
  ),
);
---
<Page title="Touchline — The Season Scorebook" description={description}>
  <div class="tl-page">
    <SiteHeader />
    {/* The site's one masthead, the same four altitudes every story page
        opens on. The home's own additions: the book's name opposite the
        dateline, and the conference codes beneath the figures, so a reader
        who came for one conference can leave for it before the ledger (the
        ledger is the thesis, and it kept the conferences three screens down
        at 390, tl-tav2). With no national journal the headline altitude stays
        empty; the floor manufactures no story out of numbers the cards
        already print. A journal's dek is a story and reads in serif; the
        floor's is the openers in order, which is information, in sans. */}
    <Masthead
      kicker={lede.kicker}
      headline={lede.headline}
      title="The Season Scorebook"
      dek={lede.dek}
      dekSerif={!!lede.headline}
      stamp={lede.stamp}
      strip={lede.strip}
    >
      <span slot="meta">THE SEASON SCOREBOOK</span>
      <nav slot="after" class="conf-strip num" aria-label="Find your conference">
        {strip.map((c) => (
          <a class="conf-chip" href={seasonHref(c.key)} title={c.name}>{c.abbr}</a>
        ))}
      </nav>
    </Masthead>

    <section class="lastnight">
      <div class="ln-head">
        <h2 class="sechead-plain">LAST NIGHT</h2>
        <div class="grow"></div>
        <div class="ln-date num">{dowLong(lastNight).toUpperCase()} {monShort(lastNight).toUpperCase()} {dayOfMonth(lastNight)}</div>
      </div>
      {ledger.length > 0 ? (
        <>
          <div class="ledger num" style={`--lconf-ch: ${lconfChars}`}>
            {ledgerOpen.map((r) => <LedgerRow r={r} />)}
          </div>
          {ledgerFolded.length > 0 && (
            <details class="ledger-more">
              <summary class="ledger-sum num">{ledgerSummary(ledger.length)}</summary>
              <div class="ledger num" style={`--lconf-ch: ${lconfChars}`}>
                {ledgerFolded.map((r) => <LedgerRow r={r} />)}
              </div>
            </details>
          )}
        </>
      ) : (
        <p class="ln-empty">
          No final with a published score from {dowLong(lastNight)}, {monLong(lastNight)}{" "}
          {dayOfMonth(lastNight)}. The absence is the record; nothing is hidden behind it.
        </p>
      )}
      {openLine && <p class="ln-open">{openLine}</p>}
      {ncaaDay && dayRows.length > 0 && (
        <div class="ln-day">
          <div class="ln-head">
            <h3 class="sechead-plain">{ncaaDay.isToday ? "TODAY" : "NEXT PLAYING DAY"}</h3>
            <div class="grow"></div>
            <div class="ln-date num">
              {dayLabel(ncaaDay.date)} · {ncaaDay.matches.length} NCAA {ncaaDay.matches.length === 1 ? "TIE" : "TIES"}
            </div>
          </div>
          <div class="ledger num" style={`--lconf-ch: ${lconfChars}`}>
            {dayRows.map((r) => <LedgerRow r={r} />)}
          </div>
          {dayMore > 0 && (
            <a class="ln-more" href={championshipHref()}>
              and {dayMore} more on the championship page&nbsp;<span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      )}
      {champLine && (
        <a class="ln-champ num" href={championshipHref()}>{champLine}&nbsp;<span aria-hidden="true">→</span></a>
      )}
    </section>

    <HomeConferences
      cards={views}
      layout={layout}
      bands={bands}
      footprints={footprints}
      headlineProgramme={headlineProgramme}
      conferenceOf={conferenceOf}
      headline={headline}
      divisionConferences={site.divisionConferences}
    />

    <SiteFooter seasons={seasons} />
  </div>
</Page>

<style>
  /* ── Find your conference ───────────────────────────────────────────────── */
  /* One quiet line of codes under the figures, wrapping as a phone needs. A
     code is a link and reads as one on hover only; the line is a way out,
     not a headline. */
  .conf-strip { display: flex; flex-wrap: wrap; gap: 4px 4px; margin: 4px 0 0 -8px; font-size: 11px; letter-spacing: 0.14em; font-weight: 600; }
  .conf-chip { padding: 2px 8px; color: var(--secondary); white-space: nowrap; }
  .conf-chip:hover { color: var(--ink); }
  .conf-chip:focus-visible { outline: 1px solid var(--accent); outline-offset: 1px; }

  /* ── Last night ─────────────────────────────────────────────────────────── */
  .lastnight {
    padding: 18px 0 22px;
    border-bottom: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ln-head { display: flex; align-items: baseline; }
  .sechead-plain { margin: 0; font-size: 11px; letter-spacing: 0.2em; font-weight: 600; }
  .ln-date { font-size: 11px; letter-spacing: 0.1em; color: var(--quiet); }
  .ledger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 56px;
  }
  /* The rows are LedgerRow.astro's; the fold is the page's. The disclosure
     is a native <details>: no script, and the rows inside are the same rows.
     The summary reads in the section head's register and sits on the rule
     the last open row drew. */
  .ledger-more { margin: 0; }
  .ledger-sum {
    list-style: none;
    cursor: pointer;
    padding: 12px 4px 4px;
    font-size: 11px;
    letter-spacing: 0.14em;
    font-weight: 600;
    color: var(--secondary);
  }
  .ledger-sum::-webkit-details-marker { display: none; }
  .ledger-sum::before {
    content: "+";
    display: inline-block;
    width: 14px;
    color: var(--quiet);
  }
  .ledger-more[open] > .ledger-sum::before { content: "–"; }
  .ledger-sum:hover { color: var(--ink); }
  .ledger-sum:focus-visible { outline: 1px solid var(--accent); outline-offset: 3px; }
  .ln-empty {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 14px;
    color: var(--secondary);
  }
  .ln-open { margin: 0; font-size: 14px; line-height: 1.5; color: var(--quiet); }
  /* The NCAA's day ahead: the section head's register again, one step in,
     over the ledger's own rows. Air above it so it reads as the next thing,
     not the night's overflow. */
  .ln-day { display: flex; flex-direction: column; gap: 10px; margin-top: 12px; }
  .ln-day h3 { color: var(--ink); }
  .ln-more {
    align-self: flex-start;
    padding: 2px 4px;
    font-size: 13px;
    color: var(--secondary);
  }
  .ln-more:hover { color: var(--accent-hover); }
  .ln-more:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
  /* The championship's pointer: one quiet line in the ledger's sans, the
     section head's tracking, secondary until hovered. A way on, not a story. */
  .ln-champ {
    align-self: flex-start;
    padding: 2px 4px;
    font-size: 11px;
    letter-spacing: 0.14em;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--secondary);
  }
  .ln-champ:hover { color: var(--accent-hover); }
  .ln-champ:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
  @media (pointer: coarse) {
    .ln-champ, .ln-more { display: inline-flex; align-items: center; min-height: 44px; padding: 0 4px; }
  }

  /* The conferences — the columns under the cap, the map-led section past
     it: ConferenceCard.astro, HomeConferences.astro, HomeMap.astro,
     HomeBands.astro. */

  /* ── Narrow ─────────────────────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .ledger { grid-template-columns: minmax(0, 1fr); }
  }
</style>
