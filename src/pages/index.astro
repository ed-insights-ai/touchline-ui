---
// The national read: every configured conference on one page, side by side.
//
// There is no cross-conference competition, so this page computes no combined
// table. What it shows is what the collect actually holds: last night's
// published finals in one ledger — one row per MATCH, folded across the files
// that collected it — each conference's own counts and opener,
// and the current headline of each season journal, verbatim, linking to the
// season page that carries it. The masthead is derived — a kicker, a dek and a
// counts strip, assembled deterministically from counts and opener dates,
// never a model call. Its headline altitude stays empty until one writes it.
//
// Every count here comes through the same functions as the season pages'
// mastheads, so the two surfaces cannot disagree; the tests recount both from
// the fixture lists and make them meet.
import FootprintBand from "../components/FootprintBand.astro";
import HomeConferences from "../components/HomeConferences.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Page from "../layouts/Page.astro";
import { hasScore, matchHref, seasonHref } from "../lib/derive.ts";
import { type DivisionMatch, divisionCounts } from "../lib/division.ts";
import type { Fixture } from "../lib/derive.ts";
import {
  dayOfMonth,
  dowLong,
  monLong,
  monShort,
  spell,
} from "../lib/format.ts";
import {
  type BandColumn,
  type CardView,
  homeBands,
  homeColumns,
  homeLayout,
  homeSeasons,
  lastNightLedger,
  lastNightOf,
  lastNightOpen,
  mostImminentKey,
  nationalAsOf,
  nationalDescription,
  nationalMasthead,
  opensLine,
} from "../lib/home.ts";
import { editorial, loadJournal, loadNationalJournal } from "../lib/journal.ts";
import { site } from "../site.config.ts";

const seasons = homeSeasons();
const columns = homeColumns(seasons);
const imminent = mostImminentKey(columns);
// The division's figures are counts of MATCHES, not the sum of the columns: a
// match between two of these conferences is in both files, and the sum held it
// twice (tui-2l6). The cards below still print their own conference's count,
// which is right, and the About page carries the sentence a reader who adds
// the three of them up is owed.
const national = divisionCounts(seasons);

const asOf = nationalAsOf(seasons);
// The division's journal writes the headline and the dek and nothing else.
// Absent, or emptied by the validator, the masthead is exactly what it was
// before one existed — the page never waits on a model call.
const lede = nationalMasthead(
  columns,
  asOf,
  national,
  loadNationalJournal(site.season, site.gender),
);
// A share card and a search result meet these facts with no cards and no strip
// beneath them, so the description keeps the full prose the masthead stopped
// printing — and keeps it stable, because it identifies the page as much as it
// summarises it.
const description = nationalDescription(columns, national);
const lastNight = lastNightOf(asOf);
const ledger = lastNightLedger(seasons, lastNight);
const leftOpen = lastNightOpen(seasons, lastNight);

// The line each card carries, and the day it last changed.
//
// It used to be the season journal's headline, verbatim. One string cannot
// obey two surface contracts: on the season page the headline heads a page
// that prints the counts and the table beneath it, and here it sits under the
// conference code, the full name, the opens-date and the played count — so
// all three headlines restated the card's own figures back at it.
//
// The wire is the journal's slot for this surface. A journal that has not
// written one falls back to the headline, exactly as before, which is what
// keeps the change safe while old journal files are still on disk. The date
// tag rides only on a wire: nothing knows when a headline last changed.
const cards = new Map(
  columns.map((c) => {
    const journal = loadJournal(c.season);
    const wire = journal?.wire;
    return [
      c.key,
      {
        line: wire?.line ?? editorial(c.season, journal).headline,
        // A stamp only when the wire is older than the data it sits on: on
        // the day it was written, the page's own date already says so (the
        // same rule as the season and national mastheads, owner 2026-09-01).
        updated: wire?.updated && wire.updated !== c.season.asOf ? wire.updated : null,
      },
    ];
  }),
);
const cardStamp = (key: string): string | null => {
  const iso = cards.get(key)?.updated;
  return iso ? `UPDATED ${monShort(iso).toUpperCase()} ${dayOfMonth(iso)}` : null;
};

// Winner side at weight 600, loser quiet, draws neutral.
const sideClass = (f: Fixture, side: "home" | "away"): string => {
  if (!hasScore(f) || f.home_score === f.away_score) return "lside";
  const winner = f.home_score > f.away_score ? "home" : "away";
  return side === winner ? "lside lwin" : "lside lquiet";
};

// A ledger row reads away · score · home, which is a claim about where the
// match was played. A neutral-site match (two records, each site calling
// itself home) has no home side to claim, so its row is set in the order the
// fold's identity uses — the two slugs sorted — with the score in that order
// and a "v" where the home sense would have been. Both sides are printed
// with the same weight rule; only the sense is withheld.
interface LedgerSide {
  slug: string;
  score: number | undefined;
  cls: string;
}
const ledgerSides = (r: DivisionMatch): { left: LedgerSide; right: LedgerSide } => {
  const f = r.fixture;
  if (!r.neutral) {
    return {
      left: { slug: f.away, score: f.away_score, cls: `${sideClass(f, "away")} l-away` },
      right: { slug: f.home, score: f.home_score, cls: sideClass(f, "home") },
    };
  }
  const [a, b] = [f.home, f.away].sort();
  const sideOf = (slug: string): "home" | "away" => (slug === f.home ? "home" : "away");
  const scoreOf = (slug: string): number | undefined =>
    slug === f.home ? f.home_score : f.away_score;
  return {
    left: { slug: a as string, score: scoreOf(a as string), cls: `${sideClass(f, sideOf(a as string))} l-away` },
    right: { slug: b as string, score: scoreOf(b as string), cls: sideClass(f, sideOf(b as string)) },
  };
};

const night = dowLong(lastNight);
const sentenceCase = (text: string): string => text.charAt(0).toUpperCase() + text.slice(1);

// LAST NIGHT has three states and speaks in two of them. A night that
// published nothing says so where the ledger would have been. A night that
// left something without a score discloses it, because a reader cannot see an
// absence in a list. A night where every result came through ends at the
// results: stating a zero belongs where a count is claimed, and annotating the
// absence of a problem is not the same thing.
//
// "Matches", not "finals". Two thirds of the fixtures in this set were never
// marked final by their own source — they are the unscored, not the silent —
// and naming them finals would publish a status nobody published.
const openLine =
  leftOpen.length > 0
    ? `${sentenceCase(spell(leftOpen.length))} ${
        leftOpen.length === 1 ? "match" : "matches"
      } from ${night} ${leftOpen.length === 1 ? "stands" : "stand"} without a published score.`
    : null;

// What each card prints, in kickoff order. The card takes a view, not a
// Season, so the layout below can be exercised on a synthetic set; the view
// also carries what a band head needs (live, opener, kickoff).
const views: (CardView & BandColumn)[] = columns.map((c) => ({
  key: c.key,
  code: c.code,
  name: c.name,
  opens: opensLine(c),
  imminent: c.key === imminent && !c.live,
  played: c.counts.played,
  total: c.counts.total,
  line: cards.get(c.key)?.line ?? null,
  stamp: cardStamp(c.key),
  href: seasonHref(c.key),
  live: c.live,
  opensOn: c.opensOn,
  kickoff: c.kickoff,
}));
// N columns from config — the count is the conference list's, never a literal.
// Up to the configured cap that is one column each; past it the same cards
// flow into region bands (site.homeColumnCap, lib/home.ts).
const layout = homeLayout(columns.length);
const bands = homeBands(views);
---
<Page title="Touchline — The Season Scorebook" description={description}>
  <div class="tl-page">
    <header class="nat-masthead">
      {/* The root is the top of the site; its own wordmark points nowhere. */}
      <h1 class="wordmark nat-wordmark">
        <span class="wordmark-square"></span>
        <span class="wordmark-name">Touchline</span>
      </h1>
      <div class="nat-book">THE SEASON SCOREBOOK</div>
    </header>

    {/* Four altitudes, each answerable to a different surface: the scope and
        the date, the division's story, the figures that stand it up, and the
        counts. With no national journal the headline altitude stays empty —
        the floor manufactures no story out of numbers the cards already
        print — and the page reads as it did before one was written. */}
    <section class="nat-lede">
      <div class="nat-kicker num">{lede.kicker}</div>
      {lede.headline && <h2 class="nat-headline serif">{lede.headline}</h2>}
      {/* A journal's dek is the story's opening paragraph and reads in serif;
          the floor's is the openers in order, which is information, and
          stays in sans. Only a journal writes a headline, so that is the tell. */}
      {lede.dek && <p class={lede.headline ? "nat-dek nat-lede serif" : "nat-dek"}>{lede.dek}</p>}
      {lede.stamp && <div class="nat-stamp num">{lede.stamp}</div>}
      <div class="nat-strip num">
        {lede.strip.map((cell) => <span class="nat-cell">{cell}</span>)}
      </div>
    </section>

    <section class="lastnight">
      <div class="ln-head">
        <h2 class="sechead-plain">LAST NIGHT</h2>
        <div class="grow"></div>
        <div class="ln-date num">{dowLong(lastNight).toUpperCase()} {monShort(lastNight).toUpperCase()} {dayOfMonth(lastNight)}</div>
      </div>
      {ledger.length > 0 ? (
        <div class="ledger num">
          {ledger.map((r) => (
            <a class="lrow hoverable" href={matchHref(r.key, r.fixture.id)}>
              <span class="lconf">{r.codes.join(" · ")}</span>
              {(() => {
                const { left, right } = ledgerSides(r);
                return (
                  <>
                    <span class={left.cls}>{r.season.names.name(left.slug)}</span>
                    <span class="lscore">
                      {hasScore(r.fixture) ? `${left.score}–${right.score}` : "—"}
                      {r.neutral && <span class="lneutral"> v</span>}
                    </span>
                    <span class={right.cls}>{r.season.names.name(right.slug)}</span>
                  </>
                );
              })()}
            </a>
          ))}
        </div>
      ) : (
        <p class="ln-empty">
          No final with a published score from {dowLong(lastNight)}, {monLong(lastNight)}{" "}
          {dayOfMonth(lastNight)}. The absence is the record; nothing is hidden behind it.
        </p>
      )}
      {openLine && <p class="ln-open">{openLine}</p>}
    </section>

    <HomeConferences cards={views} layout={layout} bands={bands} />

    <FootprintBand columns={columns} divisionConferences={site.divisionConferences} />

    <SiteFooter seasons={seasons} />
  </div>
</Page>

<style>
  /* ── Masthead identity ──────────────────────────────────────────────────── */
  .nat-masthead {
    padding: 44px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }
  .nat-wordmark { margin: 0; color: var(--ink); }
  .nat-wordmark .wordmark-name { font-size: 34px; }
  .nat-book {
    font-size: 11px;
    letter-spacing: 0.34em;
    font-weight: 600;
    color: var(--ink-soft);
  }
  /* ── The masthead's four altitudes ──────────────────────────────────────── */
  .nat-lede {
    margin: 28px auto 32px;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }
  /* Accent, like the season page's kicker: the same element doing the same
     job — scope and date over a story — and the one line of ink that separates
     the dateline from the identity above it. */
  .nat-kicker { font-size: 11px; letter-spacing: 0.2em; font-weight: 600; color: var(--accent); }
  .nat-headline {
    margin: 0;
    font-size: 38px;
    line-height: 1.1;
    letter-spacing: -0.005em;
    /* Balanced rather than pretty: this line is short enough that the last
       word alone on a second line is the failure mode, not a ragged edge. */
    text-wrap: balance;
  }
  /* Sans, not serif: the house rule is serif means story and sans means
     information, and until a journal writes a story this is the openers in
     order — information. */
  .nat-dek {
    margin: 0;
    max-width: 720px;
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--secondary);
    text-wrap: pretty;
  }
  /* When the headline last changed. It stands until something more newsworthy
     displaces it or it stops being true, so a reader meeting a sentence that
     did not move today is owed the day it last did. */
  .nat-lede { max-width: none; font-size: 18px; line-height: 1.45; color: var(--ink-soft); text-wrap: balance; }
  .nat-stamp { font-size: 10px; letter-spacing: 0.12em; color: var(--quiet); }
  .nat-strip { font-size: 11px; letter-spacing: 0.1em; color: var(--quiet); }
  /* Punctuation standing in for the gap between two figures — nothing a
     reader has to read, which is the only type this rung of the ladder sets. */
  .nat-cell + .nat-cell::before { content: "·"; margin: 0 9px; color: var(--outline-quiet); }

  /* ── Last night ─────────────────────────────────────────────────────────── */
  .lastnight {
    padding: 18px 0 22px;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ln-head { display: flex; align-items: baseline; }
  .sechead-plain { margin: 0; font-size: 11px; letter-spacing: 0.2em; font-weight: 600; }
  .ln-date { font-size: 11px; letter-spacing: 0.1em; color: var(--quiet); }
  .ledger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 56px;
  }
  .lrow {
    display: grid;
    /* Wide enough for two codes. A non-conference match between two of these
       conferences was collected by both, and the row says so rather than
       picking one — the column is sized for the truthful cell, not the
       common one, because a fixed grid that fits only one code would wrap it. */
    grid-template-columns: 68px minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 8px 4px;
    border-bottom: 1px solid var(--hairline-soft);
    color: inherit;
    font-size: 13.5px;
  }
  .lconf {
    font-size: 10px;
    letter-spacing: 0.12em;
    font-weight: 600;
    color: var(--quiet);
    white-space: nowrap;
  }
  .lside { min-width: 0; }
  .l-away { text-align: right; }
  /* The neutral mark: quiet, and the only thing that tells a neutral row apart. */
  .lneutral { color: var(--quiet); font-size: 10px; letter-spacing: 0.08em; }
  .lwin { font-weight: 600; }
  .lquiet { color: var(--secondary); }
  .lscore { font-weight: 600; }
  .ln-empty {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 14px;
    color: var(--secondary);
  }
  .ln-open { margin: 0; font-size: 14px; line-height: 1.5; color: var(--quiet); }

  /* The conference cards and their layout: ConferenceCard.astro and
     HomeConferences.astro. */

  /* ── Narrow ─────────────────────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .ledger { grid-template-columns: minmax(0, 1fr); }
    .nat-masthead { padding-top: 28px; }
    .nat-headline { font-size: 28px; }
    .nat-dek { font-size: 15.5px; }
  }
</style>
