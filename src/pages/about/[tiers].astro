    .tm .para a, .tm .list a { color: inherit; border-bottom: 1px solid var(--outline-quiet); }
    .tm .para a:hover, .tm .list a:hover { color: var(--accent-hover); border-bottom-color: var(--accent-hover); }

    /* Prominent editorial callout (e.g. "Not an overall player rating"). */
    .tm .callout {
