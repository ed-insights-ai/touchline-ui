      border: 1px solid var(--hairline); border-radius: 6px;
      display: flex; flex-direction: column; gap: 4px;
    }
    .tm .flow-num {
      font-size: 10px; letter-spacing: 0.16em; font-weight: 600;
      text-transform: uppercase; color: var(--accent);
    }
    .tm .flow-name { font-size: 14px; font-weight: 600; color: var(--ink); }
    .tm .flow-desc { font-family: var(--serif); font-size: 13.5px; line-height: 1.45; color: var(--ink-soft); }

    /* Side-by-side illustrative comparison cards. */
    .tm .compare-grid {
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px;
      margin: 14px 0 10px;
    }
    .tm .compare-card {
      padding: 14px 16px; background: var(--card);
      border: 1px solid var(--hairline); border-radius: 6px;
      display: flex; flex-direction: column; gap: 4px;
    }
    .tm .compare-kicker {
      font-size: 10.5px; letter-spacing: 0.14em; font-weight: 600;
      text-transform: uppercase; color: var(--secondary);
    }
    .tm .compare-figure {
      font-family: var(--serif); font-size: 30px; font-weight: 500;
      line-height: 1.15; color: var(--ink); font-variant-numeric: tabular-nums;
      margin: 4px 0 2px;
    }
    .tm .compare-figure-accent { color: var(--accent); }
    .tm .compare-label { font-size: 12.5px; font-weight: 600; color: var(--ink); }
    .tm .compare-meta { font-size: 12.5px; color: var(--secondary); line-height: 1.45; }
    .tm .caption {
      margin: 0 0 14px; font-family: var(--serif); font-style: italic;
      font-size: 13.5px; color: var(--secondary);
    }

    /* Tables: ruled sans, tabular figures, safe on narrow screens. */
    .tm .table-wrap { overflow-x: auto; margin: 12px 0 16px; }
    .tm .table-wrap:last-child { margin-bottom: 0; }
    .tm .who { width: 100%; border-collapse: collapse; margin: 0; font-size: 13px; line-height: 1.48; }
    .tm .who th, .tm .who td {
      text-align: left; vertical-align: top; padding: 9px 14px 9px 0;
      border-top: 1px solid var(--hairline-soft);
    }
    .tm .who thead th {
      border-top: 0; padding-top: 0;
      font-size: 10.5px; letter-spacing: 0.14em; font-weight: 600; color: var(--secondary);
      text-transform: uppercase;
    }
    .tm .who tbody th { width: 136px; font-weight: 600; color: var(--ink); }
    .tm .who td { color: var(--ink-soft); }

    /* Progressive disclosure for formulas (Level 2) and full technical chapters (Level 3). */
    .tm .tech-disclosure {
      margin: 12px 0 16px;
      border: 1px solid var(--hairline);
      border-radius: 6px;
      background: var(--card);
      scroll-margin-top: 16px;
    }
    .tm .tech-disclosure + .tech-disclosure { margin-top: 10px; }
    .tm .tech-disclosure > summary {
      list-style: none; cursor: pointer;
      display: flex; align-items: center; justify-content: space-between; gap: 14px;
      padding: 12px 16px;
      font-family: var(--sans); font-size: 13.5px; font-weight: 600; color: var(--ink);
    }
    .tm .tech-disclosure > summary::-webkit-details-marker { display: none; }
    .tm .tech-disclosure > summary:hover { color: var(--accent-hover); }
    .tm .tech-disclosure > summary:focus-visible { outline: 1px solid var(--accent); outline-offset: -2px; border-radius: 6px; }
    .tm .tech-summary-meta {
      display: block; font-weight: 400; font-size: 12.5px; color: var(--secondary);
      margin-top: 2px;
    }
    .tm .tech-disclosure > summary::after {
      content: "+"; font-size: 17px; font-weight: 400; color: var(--accent); line-height: 1;
      flex: none;
    }
    .tm .tech-disclosure[open] > summary::after { content: "−"; }
    .tm .tech-disclosure[open] > summary { border-bottom: 1px solid var(--hairline-soft); }
    .tm .tech-body { padding: 15px 17px; }
    .tm .tech-body > :last-child { margin-bottom: 0; }
    @media (pointer: coarse) {
      .tm .tech-disclosure > summary { min-height: 48px; }
    }

    /* Compact anchor jump strip inside Level 3. */
    .tm .math-index {
      display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0 0 16px;
    }
    .tm .math-link {
      font-size: 11.5px; letter-spacing: 0.1em; font-weight: 600;
      text-transform: uppercase; color: var(--secondary); padding: 2px 0;
    }
    .tm .math-link:hover { color: var(--accent-hover); }
    .tm .math-link:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }

    /* Numbered calculation steps inside Level 3 disclosures. */
    .tm .steps { list-style: none; padding: 0; margin: 8px 0 4px; counter-reset: tm-step; }
    .tm .step {
      counter-increment: tm-step;
      display: grid; grid-template-columns: 28px minmax(0, 1fr); column-gap: 14px;
      padding: 13px 0; border-top: 1px solid var(--hairline-soft);
    }
    .tm .step:first-child { border-top: 0; padding-top: 2px; }
    .tm .step::before {
      content: counter(tm-step);
      font-family: var(--sans); font-size: 11px; font-weight: 600;
      font-variant-numeric: tabular-nums;
      color: var(--accent);
      border: 1px solid var(--accent-border);
      background: var(--accent-wash-soft);
      width: 24px; height: 24px; border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      margin-top: 1px;
    }
    .tm .step-title {
      margin: 0 0 6px; font-family: var(--sans); font-size: 14px; font-weight: 600;
      color: var(--ink); line-height: 1.35;
    }
    .tm .step-body > .para { margin-bottom: 10px; }
    .tm .step-body > .para:last-child { margin-bottom: 0; }

    /* Formula callout: wraps cleanly without horizontal overflow. */
    .tm .formula {
      margin: 10px 0 12px; padding: 10px 14px;
      background: var(--accent-wash-soft);
      border-left: 2px solid var(--accent);
      border-radius: 0 4px 4px 0;
      font-family: var(--sans); font-size: 13px; line-height: 1.55;
      color: var(--ink); font-variant-numeric: tabular-nums;
      overflow-wrap: break-word;
    }
    .tm .formula-eq { font-weight: 600; }
    .tm .formula-note {
      margin-top: 5px; font-size: 12.5px; color: var(--secondary); line-height: 1.48;
    }

    /* Worked example arithmetic rows. */
    .tm .example-head {
      margin: 18px 0 8px;
      font-size: 11px; letter-spacing: 0.16em; font-weight: 600;
      text-transform: uppercase; color: var(--accent);
    }
    .tm .example-head:first-child { margin-top: 2px; }
    .tm .example-rows {
      margin: 8px 0 14px; padding: 0; list-style: none;
      font-family: var(--sans); font-size: 13px; line-height: 1.5;
      color: var(--ink-soft); font-variant-numeric: tabular-nums;
    }
    .tm .example-rows:last-child { margin-bottom: 0; }
    .tm .example-rows li {
      padding: 7px 0; border-top: 1px solid var(--hairline-soft);
      display: grid; grid-template-columns: 165px minmax(0, 1fr); column-gap: 12px;
    }
    .tm .example-rows li:first-child { border-top: 0; padding-top: 2px; }
    .tm .example-label { font-weight: 600; color: var(--ink); }
    .tm .example-rows strong { color: var(--ink); font-weight: 600; }

    .tm .sym {
      font-family: var(--sans); font-size: 0.9em; font-weight: 600;
      color: var(--ink); font-variant-numeric: tabular-nums;
    }

    @media (max-width: 720px) {
      .tm .atitle { font-size: 32px; }
      .tm .intro { font-size: 16px; }
      .tm .tier-tiles { grid-template-columns: minmax(0, 1fr); }
      .tm .journey { grid-template-columns: minmax(0, 1fr); gap: 10px; }
      .tm .flow { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .tm .compare-grid { grid-template-columns: minmax(0, 1fr); }
      .tm .status-grid { grid-template-columns: minmax(0, 1fr); }
      .tm .status-row dt { border-bottom: 0; padding-bottom: 2px; }
      .tm .status-row dd { padding-top: 0; }
      .tm .who { font-size: 12.5px; }
      .tm .who tbody th { width: 108px; }
      .tm .who th, .tm .who td { padding-right: 10px; }
      .tm .step { grid-template-columns: 24px minmax(0, 1fr); column-gap: 10px; }
      .tm .example-rows li { grid-template-columns: minmax(0, 1fr); row-gap: 2px; }
    }
    @media (max-width: 480px) {
      .tm .flow { grid-template-columns: minmax(0, 1fr); }
    }
  </style>
  <div class="tl-page">
    <SiteHeader />

    <article class="tm">{partial && shown ? (
      <TiersScope
        tiers={tiers}
        shown={shown}
        setIn={setIn}
        retroactive={retroactive}
        firstSeason={firstSeason}
      />
    ) : (<>
      {/* ══════════════════════════════════════════════════════════════════
          FIRST SCREEN · UNDERSTAND ALL THREE TIERS IN 15 SECONDS
          ══════════════════════════════════════════════════════════════════ */}
      <section class="lede">
        <div class="akicker num">TOUCHLINE · NCAA {division.toUpperCase()}</div>
        <h1 class="atitle serif">Understanding Touchline tiers</h1>
        <p class="intro">
          Touchline recognizes players and defences that stand out in measurable parts of college
          soccer. <strong>Tiers highlight standout box-score performance — not overall player
          ability.</strong>
        </p>

        <div class="tier-tiles" aria-label="Touchline's two tiers and the team defence badge">
          <div class="tier-tile tier-tile-primary">
            <div class="tile-kicker">Tier 1</div>
            <div class="tile-stat">Top 5%</div>
            <div class="tile-kind">Shooting &amp; scoring</div>
            <div class="tile-scope">
              Individual non-penalty goals &amp; shots per 90 for eligible forwards or midfielders.
            </div>
          </div>
          <div class="tier-tile">
            <div class="tile-kicker">Tier 2</div>
            <div class="tile-stat">Next 15%</div>
            <div class="tile-kind">Shooting &amp; scoring</div>
            <div class="tile-scope">
              Positions 6% to 20% of eligible forwards or midfielders in their position group.
            </div>
          </div>
          <div class="tier-tile">
            <div class="tile-kicker">Team defence badge</div>
            <div class="tile-stat">Top 20%</div>
            <div class="tile-kind">Team performance</div>
            <div class="tile-scope">
              <strong>Awarded to the team, not a player.</strong> The division's best records of
              goals conceded against what opponents usually score, this season.
            </div>
          </div>
        </div>
        <p class="tile-footnote">
          Percentages are within eligible comparison groups. Men and women are evaluated
          separately; forwards and midfielders are evaluated separately. About{" "}
          <strong>80% of eligible players hold no tier</strong>, and about 80% of teams hold no
          badge.
        </p>

        <nav class="journey" aria-label="Reading levels">
          <a class="journey-stop" href="#level-1">
            <span class="journey-tag">1 · ~1 minute</span>
            <span class="journey-title">What a tier tells you</span>
            <span class="journey-sub">Meaning, limits &amp; sheet statuses</span>
          </a>
          <a class="journey-stop" href="#level-2">
            <span class="journey-tag">2 · 3–5 minutes</span>
            <span class="journey-title">How tiers are determined</span>
            <span class="journey-sub">Simple examples before any math</span>
          </a>
          <a class="journey-stop" href="#level-3">
            <span class="journey-tag">3 · Optional deep dive</span>
            <span class="journey-title">Explore the mathematics</span>
            <span class="journey-sub">Complete formulas, weights &amp; worked math</span>
          </a>
        </nav>
      </section>

      {/* ══════════════════════════════════════════════════════════════════
          LEVEL 1 · WHAT A TIER TELLS YOU (~1 minute, zero formulas)
          ══════════════════════════════════════════════════════════════════ */}
      <div class="level-banner" id="level-1">
        <div class="level-tag">Level 1 · ~1 minute</div>
        <h2 class="level-heading">What a tier tells you — and does not</h2>
        <p class="level-dek">
          Everything a player, parent or coach needs to interpret a tier on a player sheet.
        </p>
      </div>

      <section class="band band-lead" id="not-a-rating">
        <div class="callout">
          <p>
            <strong>A tier is not an overall player ranking or a prediction.</strong> It recognizes
            standout statistical production in one area of soccer that box scores can measure.
          </p>
          <p>
            A player without a tier may still be one of the most valuable players on the field.
            Behind the scenes, Touchline calculates numerical estimates to draw the cutoff lines,
            but never publishes scores or rankings — inside Tier 1 or Tier 2 there is no #1 and no
            #50.
          </p>
        </div>

        <p class="para">
          Keep two distinctions in mind whenever you see a tier on a player sheet:
        </p>
        <ul class="list">
          <li>
            <strong>Defence is recognised on the team, not on one player.</strong> The team
            defence badge sits on the team page. A regular defender's or goalkeeper's sheet shows
            the team's figures and, where the team holds it, the badge, but no defence tier of
            the player's own: nothing in the box scores measures one defender's part reliably.
          </li>
          <li>
            <strong>Box scores leave out most of soccer.</strong> Tiers cannot see positioning,
            tackles, interceptions, off-ball movement, build-up passing, assists, leadership,
            seasons played at a previous programme, or why a player missed matches (Touchline never
            assumes injury or rest).
          </li>
        </ul>
      </section>

      <section class="band" id="statuses">
        <h3 class="sechead">WHAT EACH STATUS ON A PLAYER SHEET MEANS</h3>
        <p class="para">
          Every forward and midfielder with a box-score line at a {division} programme Touchline
          follows displays one of four statuses. None of them implies poor playing ability:
        </p>
        <dl class="status-grid">
          <div class="status-row">
            <dt>Tier awarded</dt>
            <dd>Cleared eligibility and finished inside the tier cutoff (Tier 1 or Tier 2).</dd>
          </div>
          <div class="status-row">
            <dt>Eligible, no tier</dt>
            <dd>Cleared eligibility and was compared with peers, finishing outside the top 20% (~4 in 5 compared players).</dd>
          </div>
          <div class="status-row">
            <dt>Needs more minutes</dt>
            <dd>Did not reach the playing-time threshold for a fair comparison. Nothing else is implied.</dd>
          </div>
          <div class="status-row">
            <dt>Incomplete records</dt>
            <dd>
              Missing or unmatched published data prevented a fair evaluation —{" "}
              <strong>never</strong> a failure to qualify on performance.{" "}
              <a href="#sheet">See the four data reasons</a>.
            </dd>
          </div>
        </dl>
      </section>

      {/* ══════════════════════════════════════════════════════════════════
          LEVEL 2 · HOW TIERS ARE DETERMINED (3–5 minutes, visual examples)
          ══════════════════════════════════════════════════════════════════ */}
      <div class="level-banner" id="level-2">
        <div class="level-tag">Level 2 · 3–5 minutes</div>
        <h2 class="level-heading">How tiers are determined</h2>
        <p class="level-dek">
          Why raw totals mislead — explained through simple examples before any equations.
        </p>
      </div>

      <section class="band band-lead" id="process">
        <h3 class="sechead">FROM BOX SCORES TO A TIER</h3>
        <p class="para">
          Tiers are calculated once each season from published match box scores and are not
          continuously changed afterward. Every player moves through four steps:
        </p>
        <ol class="flow">
          <li class="flow-step">
            <span class="flow-num">Step 1</span>
            <span class="flow-name">Qualify</span>
            <span class="flow-desc">Meet the playing-time and season-history minimums.</span>
          </li>
          <li class="flow-step">
            <span class="flow-num">Step 2</span>
            <span class="flow-name">Adjust</span>
            <span class="flow-desc">Account for opponent strength, venue and prior seasons.</span>
          </li>
          <li class="flow-step">
            <span class="flow-num">Step 3</span>
            <span class="flow-name">Compare</span>
            <span class="flow-desc">Evaluate eligible players within their comparison group.</span>
          </li>
          <li class="flow-step">
            <span class="flow-num">Step 4</span>
            <span class="flow-name">Assign</span>
            <span class="flow-desc">Award fixed percentage cutoffs, then discard the scores.</span>
          </li>
        </ol>
      </section>

      <section class="band" id="why-adjust">
        <h3 class="sechead">FOUR IDEAS BEHIND THE COMPARISONS</h3>

        {/* Idea 1: Opponent strength */}
        <h4 class="question">1. Is every goal worth the same?</h4>
        <p class="para">
          In the standings, yes. But imagine two forwards who each score ten goals: one faces
          stingy defences on the road, while the other faces weaker defences at home. Simply
          counting goals treats those seasons as identical even though the circumstances were very
          different.
        </p>
        <p class="para">
          Touchline adjusts every match's non-penalty goals and shots for how tough the opponent's
          defence is and whether the match was home or away. Penalty kicks are removed so
          designated kickers are not boosted over teammates who win the fouls.
        </p>
        <div class="compare-grid" aria-label="Illustrative opponent adjustment comparison">
          <div class="compare-card">
            <div class="compare-kicker">Away · Strong defence</div>
            <div class="compare-figure compare-figure-accent">1.37</div>
            <div class="compare-label">Adjusted goal contribution</div>
            <div class="compare-meta">1 goal scored · Opponent defence factor 0.80 (harder)</div>
          </div>
          <div class="compare-card">
            <div class="compare-kicker">Home · Weaker defence</div>
            <div class="compare-figure">0.70</div>
            <div class="compare-label">Adjusted goal contribution</div>
            <div class="compare-meta">1 goal scored · Opponent defence factor 1.30 (easier)</div>
          </div>
        </div>
        <p class="caption">
          Illustrative values from the current methodology, rounded. Both players scored once, but
          scoring away against a tough defence counts nearly twice as much.
        </p>
        <details class="tech-disclosure">
          <summary>See the opponent adjustment formula</summary>
          <div class="tech-body">
            <div class="formula">
              <div class="formula-eq">
                match adjG = g ÷ (dfn_goals[opponent] × venue_goals)<br />
                match adjS = s ÷ (dfn_shots[opponent] × venue_shots)
              </div>
              <div class="formula-note">
                Applied to every counted match before summing the season. Full team-strength model
                in <a href="#opponents">Explore the mathematics → Opponent model</a>.
              </div>
            </div>
          </div>
        </details>

        {/* Idea 2: Shots + goals per 90 */}
        <h4 class="question">2. Why count shots alongside goals — and adjust for minutes?</h4>
        <p class="para">
          Goals alone are noisy: a couple of deflections or posts hit can swing a player's season
          total by four or five goals. Shot volume is much steadier from month to month and says
          more about sustained attacking threat than past goals alone.
        </p>
        <p class="para">
          Touchline puts both adjusted goals and adjusted shots on a per-90-minute basis (so
          playing time is compared fairly) and combines them — with one goal counting for roughly
          two and a half to three shots. Assists and earlier passes are not counted.
        </p>
        <details class="tech-disclosure">
          <summary>See the exact goal and shot weights</summary>
          <div class="tech-body">
            <div class="formula">
              <div class="formula-eq">
                threat = wG × (adjG × 90 ÷ minutes) + wS × (adjS × 90 ÷ minutes)
              </div>
              <div class="formula-note">
                <strong>Men:</strong> wG = 0.234, wS = 0.0885 (1 goal = 2.64 shots).{" "}
                <strong>Women:</strong> wG = 0.238, wS = 0.0749 (1 goal = 3.18 shots).
              </div>
            </div>
          </div>
        </details>

        {/* Idea 3: Multiple seasons + position average */}
        <h4 class="question">3. Why does Touchline use previous seasons and a position average?</h4>
        <p class="para">
          A single season can still be influenced by a hot streak or a soft stretch of opponents.
          To reduce the effect of short-term noise, Touchline pulls every estimate slightly toward
          the average for that position group. When a player also played regularly at the same
          programme the year before, two seasons provide much stronger evidence — so the pull toward
          average becomes much smaller while the current season still carries the most weight.
        </p>
        <div class="compare-grid" aria-label="Illustrative one-season versus two-season blend">
          <div class="compare-card">
            <div class="compare-kicker">One season of evidence</div>
            <div class="compare-figure">0.389</div>
            <div class="compare-label">Pulled ~20% toward average</div>
            <div class="compare-meta">Threat 0.418 this season, blended with 0.280 group average</div>
          </div>
          <div class="compare-card">
            <div class="compare-kicker">Two strong seasons in a row</div>
            <div class="compare-figure compare-figure-accent">0.399</div>
            <div class="compare-label">Pulled only 6–7% toward average</div>
            <div class="compare-meta">Same 0.418 season, backed by 0.390 last season</div>
          </div>
        </div>
        <p class="caption">
          Illustrative men's forward values, rounded. Sustained production across two seasons earns
          more confidence than one season alone.
        </p>
        <details class="tech-disclosure">
          <summary>See how seasons are weighted</summary>
          <div class="tech-body">
            <div class="table-wrap">
              <table class="who num">
                <thead>
                  <tr>
                    <th scope="col">Evidence counted</th>
                    <th scope="col">Men's blend</th>
                    <th scope="col">Women's blend</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th scope="row">1 season</th>
                    <td>79% current + 21% group avg</td>
                    <td>82% current + 18% group avg</td>
                  </tr>
                  <tr>
                    <th scope="row">2 seasons</th>
                    <td>59% current + 34% prior + 7% group avg</td>
                    <td>64% current + 30% prior + 6% group avg</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </details>

        {/* Idea 4: Defensive workload */}
        <h4 class="question">4. Does allowing fewer goals always mean a better defence?</h4>
        <p class="para">
          Not on its own. A back line on a dominant possession team facing 6 shots a match has a
          very different job from one facing 16 shots a match — and box scores do not tell us which
          individual defender won each tackle.
        </p>
        <p class="para">
          Touchline first tried to credit the back line alone, comparing a team only with teams
          facing a similar shot workload, so that a defence holding firm behind a midfield that
          cannot keep the ball would stand out. Tested on every season collected, that comparison
          did not hold up: split a season's matches in two at random, and the teams that stood out
          on one half mostly did not on the other. Goals per shot faced and a goalkeeper's save
          percentage did no better.
        </p>
        <p class="para">
          What does hold up is the team's whole defending: <strong>goals conceded against what its
          opponents usually score</strong>, compared across the whole division. Keeping the other
          side from shooting counts as much as stopping the shots, so it rewards the team, from the
          front line's pressing to the goalkeeper. The top fifth of teams each season hold the{" "}
          <strong>team defence badge</strong>.
        </p>
        <div class="compare-grid" aria-label="Illustrative team defence comparison">
          <div class="compare-card">
            <div class="compare-kicker">Team A · 16.0 shots faced a match</div>
            <div class="compare-figure">25% below</div>
            <div class="compare-label">Conceded 24 where opponents usually score 32</div>
            <div class="compare-meta">record = ln(32 ÷ 24) = +0.288</div>
          </div>
          <div class="compare-card">
            <div class="compare-kicker">Team B · 12.2 shots faced a match</div>
            <div class="compare-figure compare-figure-accent">33% below</div>
            <div class="compare-label">Conceded 16 where opponents usually score 24</div>
            <div class="compare-meta">record = ln(24 ÷ 16) = +0.405, the stronger record</div>
          </div>
        </div>
        <p class="caption">
          Illustrative values. Teams are ranked by how far below expectation they conceded; the
          shots a team faced are part of that record, not set aside.
        </p>
        <details class="tech-disclosure">
          <summary>See the defensive calculation</summary>
          <div class="tech-body">
            <div class="formula">
              <div class="formula-eq">
                team record = −ln( max(GA, 0.5) ÷ EGA ) = ln( EGA ÷ max(GA, 0.5) )
              </div>
              <div class="formula-note">
                The top fifth of the division's teams with 12 or more complete matches, each season.
                Full walkthrough in{" "}
                <a href="#defence">Explore the mathematics → Team defence badge</a>.
              </div>
            </div>
          </div>
        </details>
      </section>

