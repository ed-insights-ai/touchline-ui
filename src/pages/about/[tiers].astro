---
// How tiers work: a short educational experience (Level 1: meaning at a glance,
// Level 2: intuition with side-by-side examples) followed by complete,
// expandable technical documentation (Level 3: exact formulas, coefficients,
// eligibility rules and worked examples).
//
// A dynamic route on purpose, with one possible path: getStaticPaths returns
// it only while the tiers are on (lib/player-tier.ts activeTiers, which holds
// the publication gate and the levels in tiers.config.ts). With the gate
// closed, or on a level with no tiers, the build emits no page at all, not an
// empty one. A level that shows only part of the tiers (Division I men:
// midfielders) gets a short page of its own (components/TiersScope.astro) in
// this page's frame and styles; the full method below is the level that shows
// every tier.
//
// Its CSS is an inline block for the same reason the sheet's is: a scoped
// <style> here would be bundled into the site's stylesheets even on a build
// that emits no page, and a closed gate must leave the site as it was. Every
// rule is under .tm, this page's own root, so it reaches nothing else.
//
// The level's name, the month tiers are set, and the date earlier seasons were
// worked out read from config and from the files' frozen_at; nothing here is
// a date or a division written by hand.
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Page from "../../layouts/Page.astro";
import { loadSeason, type Season } from "../../lib/derive.ts";
import { dayOfMonth, monLong } from "../../lib/format.ts";
import TiersScope from "../../components/TiersScope.astro";
import { activeTiers, coverageLine } from "../../lib/player-tier.ts";
import { loadTiers, type TiersFile } from "../../lib/tiers.ts";
import { currentDivision, ncaaDivisions, site } from "../../site.config.ts";
import {
  levelTiers,
  showsFullShooting,
  TEAM_DEFENCE_TIER_RETIRED,
  TIERS_LEVELS,
} from "../../tiers.config.ts";

export function getStaticPaths() {
  return activeTiers() ? [{ params: { tiers: "tiers" } }] : [];
}

// Present, because the page is built only when it is.
const tiers = activeTiers() as TiersFile;

const seasons: Season[] = site.conferences.flatMap((key) => {
  try {
    return [loadSeason(key)];
  } catch {
    return [];
  }
});

const division = currentDivision.name;
// What this level shows. Every tier: the full method below. Part of them: the
// short page (TiersScope) in its place.
const shown = levelTiers(tiers.level);
const partial = shown !== null && !showsFullShooting(shown);
// What each other level shows, for the coverage paragraph: from config, never
// a division named by hand.
const elsewhere = ncaaDivisions
  .filter((d) => d.key !== currentDivision.key && d.published)
  .map((d) => coverageLine(d.name, TIERS_LEVELS[d.key] ?? null));

/** The month this season's tiers were frozen in. */
const setIn = monLong(tiers.frozen_at);

// Earlier seasons' files that were frozen after their own season ended were
// worked out later, by the same rule. Said once, and only when every earlier
// file agrees on when that was.
const earlier = Array.from({ length: 10 }, (_, i) => tiers.season - 10 + i)
  .map((y) => loadTiers(tiers.level, y, tiers.gender))
  .filter((f): f is TiersFile => f !== null);
const workedOut = [
  ...new Set(
    earlier
      .filter((f) => Number(f.frozen_at.slice(0, 4)) > f.season)
      .map((f) => `${monLong(f.frozen_at)} ${f.frozen_at.slice(0, 4)}`),
  ),
];
const retroactive =
  earlier.length > 0 &&
  earlier.every((f) => Number(f.frozen_at.slice(0, 4)) > f.season) &&
  workedOut.length === 1
    ? `Tiers for the seasons before ${tiers.season} were worked out in ${workedOut[0]} by the same rule, from every match of those seasons, postseason included.`
    : null;

// The first season with a tiers file. Nothing before it is counted, so that
// season's players could not have an earlier one: said once, when there is an
// earlier file to say it of.
const firstSeason = earlier[0]?.season ?? null;
const firstSeasonNote =
  firstSeason === null
    ? null
    : `The first season with tiers is ${firstSeason}, and nothing before it is counted: a ${firstSeason} forward or midfielder is judged on that season alone.`;

// The day the team defence tier left player sheets, said once, from config.
const retired = `${monLong(TEAM_DEFENCE_TIER_RETIRED)} ${dayOfMonth(TEAM_DEFENCE_TIER_RETIRED)}, ${TEAM_DEFENCE_TIER_RETIRED.slice(0, 4)}`;
---

<Page
  title="Touchline — How tiers work"
  description="Understand Touchline tiers in 60 seconds, learn why opponent strength and playing time matter, or open the complete mathematical methodology."
>
  <style is:inline>
    .tm .lede { padding: 40px 0 28px; max-width: 760px; }
    .tm .akicker { margin-bottom: 14px; font-size: 11px; letter-spacing: 0.2em; color: var(--accent); font-weight: 600; }
    .tm .atitle { margin: 0 0 14px; font-size: 42px; line-height: 1.1; letter-spacing: -0.005em; }
    .tm .intro {
      margin: 0; font-size: 17.5px; line-height: 1.6; color: var(--ink-soft);
      font-family: var(--serif); font-weight: 400; text-wrap: pretty;
    }
    .tm .intro strong { font-weight: 600; color: var(--ink); }

    /* First-screen 3-tile tier summary: understand all three labels in seconds. */
    .tm .tier-tiles {
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px;
      margin: 24px 0 12px;
    }
    .tm .tier-tiles-two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tm .tier-tile {
      padding: 16px 16px 15px; background: var(--card);
      border: 1px solid var(--hairline); border-radius: 6px;
      display: flex; flex-direction: column; gap: 4px;
    }
    .tm .tier-tile-primary { border-top: 2px solid var(--accent); }
    .tm .tile-kicker {
      font-size: 10.5px; letter-spacing: 0.16em; font-weight: 600;
      text-transform: uppercase; color: var(--secondary);
    }
    .tm .tier-tile-primary .tile-kicker { color: var(--accent); }
    .tm .tile-stat {
      font-family: var(--serif); font-size: 32px; font-weight: 500;
      line-height: 1.12; color: var(--ink); font-variant-numeric: tabular-nums;
      margin: 4px 0 2px;
    }
    .tm .tile-kind { font-size: 13px; font-weight: 600; color: var(--ink); line-height: 1.3; }
    .tm .tile-scope { font-size: 12.5px; color: var(--secondary); line-height: 1.42; margin-top: 2px; }
    .tm .tile-scope strong { color: var(--ink); font-weight: 600; }
    .tm .tile-footnote {
      margin: 0; font-family: var(--serif); font-size: 14.5px; line-height: 1.5;
      color: var(--secondary); text-wrap: pretty;
    }

    /* Simple 3-stop reading journey bar. */
    .tm .journey {
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 18px;
      margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--hairline);
    }
    .tm .journey-stop {
      display: flex; flex-direction: column; gap: 2px; padding: 4px 0;
      color: inherit;
    }
    .tm .journey-stop:hover .journey-title { color: var(--accent-hover); }
    .tm .journey-stop:focus-visible { outline: 1px solid var(--accent); outline-offset: 4px; border-radius: 3px; }
    .tm .journey-tag {
      font-size: 10px; letter-spacing: 0.16em; font-weight: 600;
      text-transform: uppercase; color: var(--accent);
    }
    .tm .journey-title { font-size: 13.5px; font-weight: 600; color: var(--ink); }
    .tm .journey-sub { font-size: 12px; color: var(--secondary); line-height: 1.4; }

    /* Level dividers: clean transition from overview -> learning -> math. */
    .tm .level-banner {
      max-width: 760px; padding: 34px 0 8px;
      border-top: 2px solid var(--ink);
