    }
    .tm .status-row dt {
      font-family: var(--sans); font-size: 13px; font-weight: 600; color: var(--ink);
      padding-right: 16px;
    }
    .tm .status-row dd {
      font-family: var(--serif); font-size: 15px; line-height: 1.5; color: var(--ink-soft);
    }

    /* Level 2 four-step visual process sequence. */
    .tm .flow {
      list-style: none; padding: 0; margin: 14px 0 18px;
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px;
    }
