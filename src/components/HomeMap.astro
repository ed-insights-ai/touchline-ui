---
// The home page's map: where the collected season is played.
//
// What is drawn: a dot per programme town, a label per region at the centroid
// of that region's dots, nudged by config so it clears them (site.regions,
// geo.ts regionLabels). Nothing is tinted by conference. Six hues could not
// tell nineteen conferences apart and no palette honestly tells thirty, so a
// dot says "a programme plays here" and nothing else; and no state is shaded,
// because the leagues interleave on the ground and any tinted territory would
// claim ground its conference does not hold. A region is broad enough to own
// its ground, so a region label is fine where a conference label was not.
//
// Two modes, one view model (lib/home.ts mapView). Under the column cap the
// map sits above the columns with no selection: every dot one ink, the
// labels present but inert (owner's ruling). Past the cap it sits beside the
// bands and carries the one selection those share (tl-38t): the selected
// region's dots wear the accent and its label lights, every other dot steps
// back, and a label is a link to its band's anchor, so with no script a label
// still opens its band. The section's one script (HomeConferences.astro)
// moves the selection on hover, click and tap. The headline programme's dot
// wears a ring — the journal names the programme in its basis; nothing is
// matched out of the sentence.
//
// Inside the selected region the conferences are told apart by shape and by
// hue, both by position in the band: each dot is a group holding a disc, a
// diamond and a square, and the dot's glyph class (lib/home.ts bandGlyphs)
// says which shows and whether it is filled or hollow while the region is
// on, and its hue class (bandHues) says which --hue-N token inks it. Off,
// every dot is the plain dim disc, so an unselected region reads as it
// always has. The same glyph, in the same hue, is printed before the code in
// the ledger row: the row is the legend, and the region of one conference is
// still the accent alone.
//
// Every figure here is recomputed from the fixtures and the coordinates
// file. The column prints no fixture counts: it answers where, the columns
// or the bands answer how many, and the two never argue.
import { STATE_OUTLINES } from "../lib/basemap.ts";
import { spell } from "../lib/format.ts";
import { MAP_FRAME } from "../lib/geo.ts";
import { type MapView, placesLine, unplacedLines } from "../lib/home.ts";

interface Props {
  view: MapView;
  conferences: number;
  /** How many conferences play this sport at all — context, not a collected figure. */
  divisionConferences: number;
}
const { view, conferences, divisionConferences } = Astro.props as Props;
const { dots, labels, placed, states, provinces, unplaced, selecting } = view;
const places = placesLine(states, provinces).toLowerCase();
const absent = unplacedLines(unplaced);
---

<div class="mapcol">
  <svg
    class="map"
    viewBox={`${MAP_FRAME.x} ${MAP_FRAME.y} ${MAP_FRAME.w} ${MAP_FRAME.h}`}
    role="img"
    aria-label={`Map of the lower 48 United States. ${placed} dots mark the towns of the programmes Touchline collects, across ${places} in ${spell(conferences)} conferences, labelled by region.${selecting ? " A region label opens that region's conferences beside the map." : ""}`}
  >
    <g class="land">
      {STATE_OUTLINES.map((s) => <path d={s.d} />)}
    </g>
    {dots.map((d) => (
      <g class={d.cls} data-region={d.region ?? undefined} data-k={d.key} transform={`translate(${d.x} ${d.y})`}>
        <title>{d.name} — {d.city} ({d.code})</title>
        {d.hl && <circle class="halo" r="8.5" />}
        <circle class="pip disc" r="4.5" />
        <path class="pip diamond" d="M0 -6.5 L6.5 0 L0 6.5 L-6.5 0 Z" />
        <rect class="pip square" x="-5" y="-5" width="10" height="10" />
      </g>
    ))}
    {labels.map((l) =>
      l.href ? (
        <a
          class="rlink"
          href={l.href}
          data-region={l.key}
          aria-label={`${l.name}: ${l.conferences} ${l.conferences === 1 ? "conference" : "conferences"}, ${l.programmes} programmes. Open the band.`}
        >
          <rect class="rhit" x={l.x - 80} y={l.y - 20} width="160" height="30" rx="6" />
          <text class={l.on ? "rlabel on" : "rlabel"} data-region={l.key} x={l.x} y={l.y} text-anchor="middle">
            {l.name.toUpperCase()}<tspan class="rn" dx="6">{l.conferences} · {l.programmes}</tspan>
          </text>
        </a>
      ) : (
        <text class="rlabel" x={l.x} y={l.y} text-anchor="middle">
          {l.name.toUpperCase()}<tspan class="rn" dx="6">{l.conferences} · {l.programmes}</tspan>
        </text>
      ),
    )}
  </svg>
  <div class="mapfoot num">
    <span>{view.footer}</span>
    <span class="chip chip-context">{conferences} OF {divisionConferences} CONFERENCES</span>
  </div>
  {absent.map((line) => (
    <p class="unplaced">{line}</p>
  ))}
</div>

<style>
  .mapcol { min-width: 0; }
  /* Beside the bands the map stays put while they scroll; the container is
     the section (HomeConferences.astro), so this is a width of the section,
     not of the viewport. Above the columns there is no such container and
     the rule does not apply. */
  @container confs (min-width: 900px) {
    .mapcol { position: sticky; top: 24px; }
  }
  .map { display: block; width: 100%; height: auto; }
  /* The basemap is drawn a step off the paper, close enough that the land is
     a ground and not a figure (tui-3bz). */
  .land path { fill: #e9e5da; stroke: #d5d0c3; stroke-width: 1; stroke-linejoin: round; }
  /* One ink for every dot at rest; when the map selects, the selected
     region's come forward in the accent and the rest step back to the bar
     ink, a mark already drawn here. A paper stroke keeps two neighbours
     apart. The ink is one variable per dot so a glyph's fill and stroke
     follow the state without a rule per shape per state. */
  .dot { --dot-ink: var(--muted-mark); }
  .dot.dim { --dot-ink: var(--muted-bar); }
  .dot.on { --dot-ink: var(--accent); }
  /* On, the conference's hue by its position in the band; hue 1 is the
     accent, so a dot with no hue class and a first conference are the same
     purple. */
  .dot.on.hue-1 { --dot-ink: var(--hue-1); }
  .dot.on.hue-2 { --dot-ink: var(--hue-2); }
  .dot.on.hue-3 { --dot-ink: var(--hue-3); }
  .dot.on.hue-4 { --dot-ink: var(--hue-4); }
  .dot.on.hue-5 { --dot-ink: var(--hue-5); }
  .dot.on.hue-6 { --dot-ink: var(--hue-6); }
  /* A hovered row or dot lights its conference: the region's others step
     back to the rest ink, still above the unselected regions, still shaped.
     Written after the hues and more specific than them, so it wins. */
  .map.lit .dot.on:not(.lit) { --dot-ink: var(--muted-mark); }
  .pip {
    fill: var(--dot-ink);
    stroke: var(--paper);
    stroke-width: 1.6;
    transition: fill 0.12s, r 0.12s;
  }
  .dot.on .disc { r: 5.5; }
  /* Off, the disc; on, the conference's glyph. The hollow ones are paper
     with an ink edge, so a ring beside a disc is a ring and not a smaller
     disc. */
  .diamond, .square { display: none; }
  .dot.on.mark-ring .disc, .dot.on.mark-hollow-diamond .diamond, .dot.on.mark-hollow-square .square {
    fill: var(--paper);
    stroke: var(--dot-ink);
    stroke-width: 2;
  }
  .dot.on.mark-diamond .disc, .dot.on.mark-hollow-diamond .disc { display: none; }
  .dot.on.mark-diamond .diamond, .dot.on.mark-hollow-diamond .diamond { display: inline; }
  .dot.on.mark-square .disc, .dot.on.mark-hollow-square .disc { display: none; }
  .dot.on.mark-square .square, .dot.on.mark-hollow-square .square { display: inline; }
  /* The headline programme's ring, drawn outside the glyph with paper
     between: the accent while its region is selected, the bar ink while it
     is not, so the ring never claims the selection. */
  .halo { fill: none; stroke: var(--dot-ink); stroke-width: 1.5; transition: stroke 0.12s; }
  @media (prefers-reduced-motion: reduce) { .pip, .halo { transition: none; } }
  /* Region labels live on the map because a region is wide enough to own its
     ground. The paper-coloured stroke under the letters keeps a label legible
     where it crosses a coastline. */
  .rlink { cursor: pointer; }
  .rlink:focus-visible { outline: none; }
  .rlink:focus-visible .rlabel { fill: var(--accent); }
  .rhit { fill: transparent; }
  .rlabel {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.16em;
    font-weight: 600;
    fill: var(--ink-soft);
    text-transform: uppercase;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 4px;
    stroke-linejoin: round;
    transition: fill 0.12s;
  }
  .rlabel.on, .rlink:hover .rlabel { fill: var(--accent); }
  .rn { font-size: 10px; letter-spacing: 0.1em; font-weight: 400; fill: var(--quiet); }
  .rlabel.on .rn { fill: var(--accent); }
  .mapfoot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 8px 0 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--quiet);
  }
  .unplaced { margin: 10px 0 0; font-size: 14px; color: var(--quiet); line-height: 1.5; }
  @container confs (max-width: 720px) {
    /* The SVG scales down with the column, so the label type steps up to
       stay readable at phone width. */
    .rlabel { font-size: 14px; }
    .rn { font-size: 12px; }
    .mapfoot { flex-wrap: wrap; gap: 6px 10px; }
  }
  @media (max-width: 720px) {
    .mapfoot { flex-wrap: wrap; gap: 6px 10px; }
  }
</style>
