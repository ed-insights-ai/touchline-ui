---
// The conference table, ranked, and the one line that says what it ranks.
//
// Two phases, one table. Before conference play opens the conference table is
// all zeros, and a reader of a table expects a top and a bottom, so the rows
// rank every countable match a member has played, against anyone, on a
// single line. From the first conference result on, the loud line is the
// conference record and its points — the figures the playoffs turn on — and
// the record across all matches steps down, with the side's form, to a dim
// second line beneath the name: the same figure the early table ranked on,
// kept in view the way a standings page keeps its overall column. Which rows
// arrive is the page's call (table or overallTable); the component only says
// which it was given.
import FormBadges from "./FormBadges.astro";
import {
  formOf,
  overallTable,
  teamHref,
  type Result,
  type Season,
  type TableRow,
} from "../lib/derive.ts";
import { dayOfMonth, monShort } from "../lib/format.ts";

interface Props {
  season: Season;
  rows: TableRow[];
  /** Conference play has begun: the rows are the conference table. */
  live: boolean;
  /** The date conference play opens, when the schedule names one. */
  opens: string | null;
}
const { season, rows, live, opens } = Astro.props;
const form = (slug: string): Result[] => formOf(season, slug);
const record = (r: TableRow): string => `${r.won}–${r.drawn}–${r.lost}`;
// The all-matches record that sits beneath each conference row.
const overall = live ? new Map(overallTable(season).map((r) => [r.slug, r])) : null;
const label = live
  ? "RANKED ON CONFERENCE MATCHES"
  : opens
    ? `ALL MATCHES UNTIL CONFERENCE PLAY OPENS ${monShort(opens).toUpperCase()} ${dayOfMonth(opens)}`
    : "ALL MATCHES UNTIL CONFERENCE PLAY OPENS";
---

<h2 class="sechead">THE TABLE</h2>
<div class="table num">
  {rows.map((r, i) => {
    const f = form(r.slug);
    const o = overall?.get(r.slug);
    return live ? (
      <a class="trow trow-live hoverable" href={teamHref(season.key, r.slug)}>
        <span class="tpos">{i + 1}</span>
        <span class="tname">{r.name}</span>
        <span class="trec">{record(r)}</span>
        <span class="tpts">{r.points}</span>
        <span class="tdim">
          <FormBadges form={f} />
          {o && <span class={f.length > 0 ? "tall tall-after" : "tall"}>all matches {record(o)}</span>}
        </span>
      </a>
    ) : (
      <a class="trow trow-early hoverable" href={teamHref(season.key, r.slug)}>
        <span class="tpos">{i + 1}</span>
        <span class="tname">{r.name}</span>
        <FormBadges form={f} />
        <span class="trec">{record(r)}</span>
      </a>
    );
  })}
</div>
<p class="table-label num">{label} · 3–1–0 POINTS</p>

<style>
  .table { display: flex; flex-direction: column; }
  .trow {
    display: grid;
    gap: 4px 8px;
    padding: 9px 4px;
    border-bottom: 1px solid var(--hairline);
    align-items: center;
    border-left: 3px solid transparent;
    color: inherit;
  }
  .trow-early { grid-template-columns: 20px 1fr 76px 44px; }
  /* Four short cells on the loud line, so a phone keeps the names whole. */
  .trow-live { grid-template-columns: 20px 1fr 52px 36px; }
  .trow:hover { border-left-color: var(--accent); }
  .tpos { font-size: 11.5px; color: var(--quiet); }
  .tname { font-size: 13.5px; }
  .trec { font-size: 12.5px; text-align: right; color: var(--quiet); white-space: nowrap; }
  .tpts { font-size: 13.5px; font-weight: 600; text-align: right; color: var(--quiet); }
  /* Once the table is the conference table, its record and points are the
     figures the playoffs turn on, and they take the ink. */
  .trow-live .trec { font-size: 13px; color: var(--ink); }
  .trow-live .tpts { color: var(--ink); }
  /* The dim line: form and the all-matches record, under the name. */
  .tdim {
    grid-column: 2 / -1;
    display: flex;
    align-items: center;
    min-width: 0;
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--quiet);
  }
  .tdim :global(.wdl) { opacity: 0.6; }
  .tall { white-space: nowrap; }
  .tall-after::before { content: "·"; margin: 0 8px; color: var(--outline-quiet); }
  .table-label {
    margin: 8px 0 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    line-height: 1.5;
    color: var(--secondary);
  }
</style>
