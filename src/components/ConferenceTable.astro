---
// The conference table, ranked, and the one line that says what it ranks.
//
// Two phases, one table. Before conference play opens the conference table is
// all zeros, and a reader of a table expects a top and a bottom, so the rows
// rank every countable match a member has played, against anyone, on a
// single line. From the first conference result on, the loud line is the
// conference record and its points — the figures the playoffs turn on — and
// the record across all matches steps down, with the side's form, to a dim
// second line beneath the name: the same figure the early table ranked on,
// kept in view the way a standings page keeps its overall column. Which rows
// arrive is the page's call (table or overallTable); the component only says
// which it was given. A conference that prints its standings in divisions
// gets one of these per division, headed by the division's printed name, and
// then the conference-wide table beneath them (lib/standings.ts); the head is
// the page's call too, and defaults to the one table most conferences print.
import { activeTiers, tableMarks, tieredLine } from "../lib/player-tier.ts";
import { divisionPostseason } from "../lib/postseason-division.ts";
import { participantsOf } from "../lib/postseason.ts";
import { seasonTitles } from "../lib/titles-season.ts";
import { titleMarks } from "../lib/titles.ts";
import FormBadges from "./FormBadges.astro";
import TitleMark from "./TitleMark.astro";
import {
  formOf,
  overallTable,
  teamHref,
  type Result,
  type Season,
  type TableRow,
} from "../lib/derive.ts";

interface Props {
  season: Season;
  rows: TableRow[];
  /** Conference play has begun: the rows are the conference table. */
  live: boolean;
  /** The head rule's words. A division's table carries the division's name. */
  title?: string;
}
const { season, rows, live, title = "THE TABLE" } = Astro.props;

// Once the conference tournament has begun, the table is final: it is the
// regular season's, and the tournament's games are not in it (model.ts
// computeTable). An ink rule falls under the last row that played in the tournament when those
// rows are the table's top block, the line the tournament was cut at.
const tournament = divisionPostseason().conference.find((t) =>
  t.codes.includes(season.fixtures.conference),
);
const frozen = live && tournament !== undefined;
// The titles the season has decided (lib/titles.ts): a ribbon and its words
// on a conference champion's row, a trophy on the national champion's.
// Titles are results, not tiers, so they draw with the tiers gate closed.
const titles = seasonTitles(season);
const entered = tournament ? participantsOf(tournament) : new Set<string>();
const lastIn = rows.findLastIndex((r) => entered.has(r.slug));
const cutAt = lastIn >= 0 && rows.slice(0, lastIn + 1).every((r) => entered.has(r.slug)) ? lastIn : -1;
const form = (slug: string): Result[] => formOf(season, slug);
const record = (r: TableRow): string => `${r.won}–${r.drawn}–${r.lost}`;
// The all-matches record that sits beneath each conference row.
const overall = live ? new Map(overallTable(season).map((r) => [r.slug, r])) : null;
// The tiers, when they are on and are this season's: the team defence
// badge's shield beside a holder's name, and the squad's tier holders on the
// dim line. A count of tiers already published, not a rating.
const tierFile = activeTiers();
const tiers = tierFile && tierFile.season === season.fixtures.season ? tierFile : null;
const marks = (slug: string) => (tiers ? tableMarks(tiers, slug) : null);
---

{/* Until conference play opens, two words on the head rule say what the
    rows rank; the spine already names the date it opens, and once the loud
    line is the conference table the dim line's own words carry ALL MATCHES
    instead. No footnote on the points: three for a win needs no explaining. */}
<div class="thead">
  <h2 class="ttitle">{title}</h2>
  {!live && <span class="tscope num">ALL MATCHES</span>}
  {frozen && <span class="tscope num">FINAL · REGULAR SEASON</span>}
</div>
<div class="table num">
  {/* The columns, named. A record and a points figure read as two unlabelled
      numbers to anyone who does not already know the house order (design
      council, 2026-11-15). The dim line under each name labels itself. */}
  {rows.length > 0 && (live ? (
    <div class="trow trow-live trow-head">
      <span class="tpos">#</span>
      <span>Team</span>
      <span class="trec">W–D–L</span>
      <span class="tpts">Pts</span>
    </div>
  ) : (
    <div class="trow trow-early trow-head">
      <span class="tpos">#</span>
      <span>Team</span>
      <span class="tform">Form</span>
      <span class="trec">W–D–L</span>
    </div>
  ))}
  {rows.map((r, i) => {
    const f = form(r.slug);
    const o = overall?.get(r.slug);
    const m = marks(r.slug);
    // The marks' CSS is TierMarks.astro's, drawn by the page while tiers are
    // on, so the bundled stylesheet is the same with the gate closed.
    const shield = m?.badge ? (
      <span class="table-shield" title="Team defense badge"><span class="vh">, team defense badge</span></span>
    ) : null;
    const tiered = m ? tieredLine(m.tiered) : null;
    return live ? (
      <a class:list={["trow", "trow-live", "hoverable", { "trow-cut": frozen && i === cutAt }]} href={teamHref(season.key, r.slug)}>
        <span class="tpos">{i + 1}</span>
        <span class="tname">{r.name}{shield}{titleMarks(titles, r.slug).map((t) => (
          <span class="tchamp" title={t.words}><TitleMark kind={t.kind} /><span aria-hidden="true">{t.short}</span><span class="vh">, {t.words}</span></span>
        ))}</span>
        <span class="trec">{record(r)}</span>
        <span class="tpts">{r.points}</span>
        <span class="tdim">
          <FormBadges form={f} />
          {o && <span class={f.length > 0 ? "tall tall-after" : "tall"}>all matches {record(o)} <span class="tcap">W–D–L</span></span>}
          {tiered && m && <span class="table-tiered" title={tiered}><span aria-hidden="true">{m.tiered}</span><span class="vh">{tiered}</span></span>}
        </span>
      </a>
    ) : (
      <a class="trow trow-early hoverable" href={teamHref(season.key, r.slug)}>
        <span class="tpos">{i + 1}</span>
        <span class="tname">{r.name}{shield}</span>
        <FormBadges form={f} />
        <span class="trec">{record(r)}</span>
      </a>
    );
  })}
</div>

<style>
  .table { display: flex; flex-direction: column; }
  .trow {
    display: grid;
    gap: 4px 8px;
    padding: 9px 4px;
    border-bottom: 1px solid var(--hairline);
    align-items: center;
    border-left: 3px solid transparent;
    color: inherit;
  }
  .trow-early { grid-template-columns: 20px 1fr 76px 44px; }
  /* Four short cells on the loud line, so a phone keeps the names whole. */
  .trow-live { grid-template-columns: 20px 1fr 52px 36px; }
  .trow-cut { border-bottom-color: var(--ink); }
  /* The column heads, in the caps-label register, on the row grid itself so
     each label sits over its own figures. */
  .trow.trow-head {
    padding-top: 7px; padding-bottom: 6px;
    font-size: 10px; letter-spacing: 0.12em; font-weight: 600; text-transform: uppercase;
    color: var(--quiet);
  }
  .trow.trow-head:hover { border-left-color: transparent; }
  .trow.trow-head .trec, .trow.trow-head .tpts, .trow.trow-head .tpos { font-size: 10px; color: var(--quiet); font-weight: 600; }
  .trow-head .tform { text-align: right; }
  /* A title won: its mark and its words on their own line under the name,
     free to wrap, so a long title never widens the name's column and pushes
     the record and points out of theirs. */
  .tchamp {
    display: flex; align-items: flex-start; gap: 4px; margin-top: 3px;
    font-size: 9.5px; letter-spacing: 0.12em; font-weight: 600; line-height: 1.3; color: var(--ink);
  }
  .trow:hover { border-left-color: var(--accent); }
  .tpos { font-size: 11.5px; color: var(--quiet); }
  .tname { font-size: 13.5px; min-width: 0; }
  .trec { font-size: 12.5px; text-align: right; color: var(--quiet); white-space: nowrap; }
  .tpts { font-size: 13.5px; font-weight: 600; text-align: right; color: var(--quiet); }
  /* Once the table is the conference table, its record and points are the
     figures the playoffs turn on, and they take the ink. */
  .trow-live .trec { font-size: 13px; color: var(--ink); }
  .trow-live .tpts { color: var(--ink); }
  /* The dim line: form and the all-matches record, under the name. */
  .tdim {
    grid-column: 2 / -1;
    display: flex;
    align-items: center;
    min-width: 0;
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--quiet);
  }
  .tdim :global(.wdl) { opacity: 0.6; }
  .tall { white-space: nowrap; }
  /* The dim line's record names its order, in the column heads' caps. */
  .tcap { margin-left: 2px; font-size: 9.5px; letter-spacing: 0.12em; font-weight: 600; }
  .tall-after::before { content: "·"; margin: 0 8px; color: var(--outline-quiet); }
  .thead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 7px;
  }
  /* The section head's own type, since the rule lives on .thead, not the h2. */
  .ttitle { margin: 0; font-size: 11px; letter-spacing: 0.2em; font-weight: 600; }
  .tscope { font-size: 11px; letter-spacing: 0.1em; color: var(--secondary); white-space: nowrap; }
</style>
