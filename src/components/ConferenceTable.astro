---
// The conference table, and the sentence that says what state it is in.
//
// A table before conference play has begun is a valid state, not an empty one:
// the position column reads as a dash rather than a rank, and the statement
// underneath says why. Provenance for that statement attaches here.
import FormBadges from "./FormBadges.astro";
import { formOf, teamHref, type Result, type Season, type TableRow } from "../lib/derive.ts";

interface Props {
  season: Season;
  rows: TableRow[];
  /** Conference play has begun, so a position means something. */
  live: boolean;
  statement: { statement: string; footnote?: string | null };
  /** Lead the statement with its first sentence in bold before the table opens. */
  emphasiseFirstSentence?: boolean;
}
const { season, rows, live, statement, emphasiseFirstSentence = false } = Astro.props;
const form = (slug: string): Result[] => formOf(season, slug);
const stop = statement.statement.indexOf(".");
---

<h2 class="sechead">THE TABLE</h2>
<div class="table num">
  {rows.map((r, i) => (
    <a class="trow hoverable" href={teamHref(season.key, r.slug)}>
      <span class="tpos">{live ? i + 1 : "–"}</span>
      <span class="tname">{r.name}</span>
      <FormBadges form={form(r.slug)} />
      <span class="tpts">{r.points}</span>
    </a>
  ))}
</div>
<p class="table-state">
  {emphasiseFirstSentence && stop >= 0 ? (
    <>
      <strong>{statement.statement.slice(0, stop + 1)}</strong>
      {statement.statement.slice(stop + 1)}
    </>
  ) : (
    statement.statement
  )}
</p>
{statement.footnote && <p class="table-foot">{statement.footnote}</p>}

<style>
  .table { display: flex; flex-direction: column; }
  .trow {
    display: grid;
    grid-template-columns: 20px 1fr 76px 40px;
    gap: 8px;
    padding: 9px 4px;
    border-bottom: 1px solid var(--hairline);
    align-items: center;
    border-left: 3px solid transparent;
    color: inherit;
  }
  .trow:hover { border-left-color: var(--accent); }
  .tpos { font-size: 11.5px; color: var(--quiet); }
  .tname { font-size: 13.5px; }
  .tpts { font-size: 13.5px; font-weight: 600; text-align: right; color: var(--quiet); }
  .table-state { margin: 10px 0 0; font-size: 14px; line-height: 1.5; }
  .table-foot { margin: 4px 0 0; font-size: 14px; color: var(--quiet); line-height: 1.5; }
</style>
