---
// The one line every page carries: who this is and what it is not, when the
// site last looked, and whose it is. Three zones — left, centre, right — the
// same three everywhere.
//
// The disclaimer sentence is plain text; beside it, the one link, and it reads
// 'About & method' on every page (tl-3rlo). The link text names where it goes
// — the page that explains both the independence the sentence claims and the
// method behind every figure on the site — which a bare "About" never did.
//
// The footer used to carry the scope and the season year too, and two
// comments here claimed it was the only home either of them had. It is not
// carrying them any more, so here is where they actually live now: the site
// header names the conference and the season year on every page, the
// national masthead's kicker names the division on the home page, and the
// About page names scope and season in full. The link wears an underline
// rather than trusting a reader to hover a sentence to find out it was one.
//
// Freshness, on a page speaking for one conference, is that conference's own
// stamp. On a page speaking for several it was the OLDEST of them, which is
// true of every figure but read as a stale site: "Data collected Nov 10" under
// a Nov 15 dateline because one conference of nineteen had not collected
// since. It is now the day the rest were collected, and beneath it, by name,
// each conference more than a day behind — so a failed collect is still the
// signal a reader is owed, attributed to the conference it belongs to, and
// the name links to the About page's list of every stamp (lib/freshness.ts).
//
// No logo and no bold name. The line opens with the word Touchline, which is
// the identity, and everything after it is one quiet hairline register.
//
// A team or match page reads its stamp from the build's freshness.js rather
// than printing it (`shared`). Those pages are nearly all of the site, and the
// stamp moves on every collect while the page around it does not: printed, it
// made every page a new file every day and the deploy re-sent the whole site.
// Read from one shared file, a page changes only when its own data does. The
// line a reader sees is the same text, filled by a parser-blocking script
// placed right after it, so it is there before first paint; without scripts
// the cell links to the About page's list of every stamp instead.
import { aboutHref, freshnessHref, type Season } from "../lib/derive.ts";
import { freshness } from "../lib/freshness.ts";
import { site } from "../site.config.ts";

interface Props {
  /** Every conference this page speaks for, in the order it should be read. */
  seasons: readonly Season[];
  /** Read the stamp from freshness.js instead of printing it. One-conference
   *  pages only: a several-conference line is computed across them. */
  shared?: boolean;
}
const { seasons, shared = false } = Astro.props;
const sharedKey = shared && seasons.length === 1 ? seasons[0]?.key : undefined;
const collected = freshness(
  seasons,
  (s) => site.conferenceNames[s.key] ?? s.fixtures.conference,
);
// The copyright's year is this build's, not the season's: it says when the
// work was published, which is a different fact from which season it covers.
const published = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <span class="sf-cell sf-left">
    <span class="sf-left-in">
      <span class="sf-say">Touchline is independent and not affiliated with the {site.governingBody}</span>
      <span class="sf-about"><a class="sf-link" href={aboutHref()}>About &amp; method</a></span>
    </span>
  </span>
  <span class="sf-cell sf-mid num">
    {sharedKey ? (
      <>
        <span class="sf-when" data-conf={sharedKey} data-stamp="line"><noscript><a class="sf-link" href={`${aboutHref()}#collection`}>Collection dates</a></noscript></span>
        <script is:inline src={freshnessHref()}></script>
      </>
    ) : (
      <span class="sf-when">{collected.line}</span>
    )}
    {collected.lagLine && (
      <a class="sf-lag" href={`${aboutHref()}#collection`}>{collected.lagLine}</a>
    )}
  </span>
  <span class="sf-cell sf-right num">© {published} {site.publisher}</span>
</footer>

<style>
  /* Three columns, not three items spread apart. space-between would put the
     middle cell BETWEEN the other two, which moves with their widths — the
     stamp would drift left or right as the disclaimer or the year changed
     length. Equal side columns centre the middle one on the page instead, and
     it stays centred whatever the cells beside it say. */
  .site-footer {
    margin-top: auto;
    padding: 14px 0 8px;
    border-top: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    column-gap: 24px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--quiet);
  }
  .sf-left { justify-self: start; min-width: 0; max-width: 100%; }
  /* The sentence and the link are two items with a middot between them, set
     the way the masthead's strip sets its cells: the dot hangs in the gap
     before the link and the row is pulled left by one gap inside a box that
     clips sideways, so when a phone puts the link on a line of its own the
     dot falls outside the box. A line never opens on "· About & method".
     Clipped on x alone: the link's padding is its hit area and must stay. */
  .sf-left { overflow-x: clip; }
  .sf-left-in { display: flex; flex-wrap: wrap; align-items: baseline; margin-left: -19px; }
  .sf-say, .sf-about { margin-left: 19px; min-width: 0; }
  .sf-about { position: relative; white-space: nowrap; }
  .sf-about::before { content: "·"; position: absolute; left: -12px; color: var(--outline-quiet); }
  .sf-mid { justify-self: center; text-align: center; }
  /* A conference that lags, named under the day the rest were collected: its
     own line, in the footer's register, linking to every stamp on About. */
  .sf-when, .sf-lag { display: block; }
  .sf-lag { color: var(--quiet); }
  .sf-lag:hover { color: var(--accent-hover); }
  .sf-lag:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
  .sf-right { justify-self: end; }
  /* The zones separate the cells; the middots that did it when this was one
     running line would be debris floating in the gaps. */

  /* The footer's only link, and it stays in the footer's register: quiet, not
     accent. Quiet alone would make it a sentence nobody knows is a link, so it
     carries a hairline underline — the affordance without the colour. The
     padding is hit area rather than layout: an inline box on a phone is about
     nineteen pixels tall, and a target this important should not be. */
  .sf-link {
    color: var(--quiet);
    border-bottom: 1px solid var(--outline-quiet);
    padding: 4px 0;
  }
  .sf-link:hover { color: var(--accent-hover); border-bottom-color: var(--accent-hover); }
  .sf-link:focus-visible { outline: 1px solid var(--accent); outline-offset: 3px; }

  /* Three zones need a width to be three zones in, and the width is MEASURED
     rather than guessed: below 980px the disclaimer wraps to two lines inside
     its own column, because that column is only half of what the centred
     middle cell leaves over. My first guess at this was 900px, and the render
     at 901 was a wrapped left cell sitting next to a one-line stamp.

     1024 for headroom over the 980 it actually needs. That headroom is about
     four per cent, so it is a coupling and not a comfort: lengthen the
     disclaimer — a longer governing body, a longer publisher — and this number
     has to be measured again rather than assumed to still hold.

     Stacked lines read left. Three different lengths centred under one another
     look like a ransom note, and the eye has one edge to return to. The
     disclaimer and its link were one sentence and are now a sentence and a
     link: the same 980 still holds, measured again after the change. */
  @media (max-width: 1024px) {
    .site-footer {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 4px;
      line-height: 1.7;
    }
    .sf-left, .sf-mid, .sf-right { justify-self: start; }
    .sf-mid { text-align: left; }
  }
</style>
