---
// The one line every page carries, in reading order: who this is and what it
// is not, the scope, the season, when the site last looked, whose it is, and
// the way to the method.
//
// It answers three obligations that have nowhere else to live. It is the only
// place the season year is named anywhere, since the national masthead stopped
// printing a scope row (tui-5us). It is the only place the division is named
// on a conference page. And on the 380-odd match and matches pages, whose
// mastheads carry no site navigation, About is the only route to the
// methodology — which is why it is the line's only link.
//
// Freshness is one token and several times. A page speaks for as many
// conferences as it shows, and they do not collect at the same time — ten
// hours can separate two of these stamps — so every time is printed, never
// flattened to the freshest. What is not printed three times is the words
// around them: the date and the unit are said once when every stamp shares
// them, and the conference codes carry the rest.
//
// No logo and no bold name. The line opens with the word Touchline, which is
// the identity, and everything after it is one quiet hairline register.
import { aboutHref, collectionLine, type Season } from "../lib/derive.ts";
import { divisionScope, site } from "../site.config.ts";

interface Props {
  /** Every conference this page speaks for, in the order it should be read. */
  seasons: readonly Season[];
}
const { seasons } = Astro.props;
const line = collectionLine(seasons);
// One year on a conference page, a span on a page that shows several seasons.
const years = [...new Set(seasons.map((s) => s.fixtures.season))].sort().join("–");
// The copyright's year is this build's, not the season's: it says when the
// work was published, which is a different fact from which season it covers.
const published = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <span class="sf-cell">Touchline is independent and not affiliated with the {site.governingBody}</span>
  <span class="sf-cell">{divisionScope()}</span>
  <span class="sf-cell num">{years}</span>
  {line.headline && (
    <span class="sf-cell num">
      {line.headline}{line.entries.length > 0 && (
        <span class="sf-times">{line.entries.map((e) => (<span class="sf-time">{e}</span>))}</span>
      )}
    </span>
  )}
  <span class="sf-cell num">© {published} {site.publisher}</span>
  <a class="sf-cell sf-about" href={aboutHref()}>About</a>
</footer>

<style>
  /* One band that wraps rather than a row with a gap in it: every token reads
     in order on a phone, About stays last, and the stamps that used to be
     ordered onto their own line simply fall there when they do not fit. */
  .site-footer {
    margin-top: 28px;
    padding: 14px 0 8px;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    font-size: 12px;
    line-height: 1.6;
    color: var(--quiet);
  }
  /* The separator TRAILS the token it follows rather than leading the one it
     precedes. On a phone this line wraps to four, and a leading middot puts
     one at the start of three of them — which is what the first version did,
     and what the render showed. Trailing, a wrapped line ends on the mark and
     reads as a continuation. Punctuation standing in for a word, which is the
     only type this rung of the ladder sets. */
  .sf-cell:not(:last-child)::after {
    content: "·";
    padding: 0 9px;
    color: var(--outline-quiet);
  }
  /* A code and its time are one word; only the list between them may break. */
  .sf-time { white-space: nowrap; }
  .sf-time + .sf-time::before {
    content: "·";
    padding: 0 9px;
    color: var(--outline-quiet);
  }
  .sf-times::before { content: "—"; padding: 0 7px; color: var(--outline-quiet); }
  /* The only link on the line, and on a match page the only route to the
     method from anywhere. It keeps a touch target the rest of the line has no
     need for. */
  .sf-about {
    color: var(--accent);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    margin: -14px 0;
  }
  .sf-about:hover { color: var(--accent-hover); }

  @media (max-width: 720px) {
    .site-footer { line-height: 1.7; }
    .sf-cell:not(:last-child)::after { padding: 0 7px; }
  }
</style>
