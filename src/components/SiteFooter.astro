---
// The compact footer every page carries.
//
// Two things a reader is owed on any page they might land on first: what this
// site is, and when it last looked. The identity line answers the first and
// names the division, which on a conference page is the only place the
// division is named at all.
//
// The second is one sentence. A page speaks for as many conferences as it
// shows, and they do not collect at the same time — ten hours can separate two
// of these stamps — so every time is printed, never flattened to the freshest.
// What is not printed three times is the words around them: the date and the
// unit are said once when every stamp shares them, and the conference codes
// carry the rest. Codes are the national page's own language; a footer that
// spelled three conference names out would be the longest line on the page.
import { aboutHref, collectionLine, type Season } from "../lib/derive.ts";
import { site } from "../site.config.ts";

interface Props {
  /** Every conference this page speaks for, in the order it should be read. */
  seasons: readonly Season[];
}
const { seasons } = Astro.props;
const line = collectionLine(seasons);
---

<footer class:list={["site-footer", { "is-multi": line.entries.length > 0 }]}>
  <span class="sf-what">
    <strong>Touchline</strong> · independent and unofficial · {site.division}
  </span>
  <span class="grow"></span>
  {line.headline && (
    <span class="sf-when num"><span class="sf-lead">{line.headline}</span>{line.entries.length > 0 && <span class="sf-times">{line.entries.map((e) => (<span class="sf-time">{e}</span>))}</span>}</span>
  )}
  <a class="sf-about" href={aboutHref()}>About &amp; method</a>
</footer>

<style>
  .site-footer {
    margin-top: 28px;
    padding: 14px 0 8px;
    border-top: 1px solid var(--hairline);
    display: flex; align-items: baseline; gap: 8px 18px; flex-wrap: wrap;
    font-size: 12px;
    color: var(--quiet);
  }
  .site-footer strong { color: var(--ink); font-weight: 600; }
  .grow { flex: 1; }
  .sf-about {
    color: var(--accent);
    min-height: 44px; display: inline-flex; align-items: center;
    margin: -14px 0;
  }
  .sf-about:hover { color: var(--accent-hover); }

  /* One stamp is a phrase on the identity line, where it has always sat.
     Several take the line below, reading left to right in the order the page
     reads its conferences. `order` keeps About & method up on the first line,
     where a reader already knows to look for it. */
  .is-multi .sf-when { order: 1; flex-basis: 100%; }
  .is-multi .sf-lead::after { content: "—"; padding: 0 7px; color: var(--fainter); }
  /* A code and its time are one word; only the list between them may break. */
  .sf-time { white-space: nowrap; }
  .sf-time + .sf-time::before {
    content: "·";
    padding: 0 9px;
    color: var(--fainter);
  }

  @media (max-width: 720px) {
    .site-footer { gap: 6px 14px; }
    .grow { display: none; }
    .sf-when { width: 100%; }
    /* The times take a line of their own, so the dash that pointed along the
       line has nothing left to point at and the list keeps its separators. */
    .is-multi .sf-lead::after { content: none; }
    .is-multi .sf-times { display: block; }
  }
</style>
