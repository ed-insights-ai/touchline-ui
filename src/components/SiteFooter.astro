---
// The compact footer every page carries.
//
// Two things a reader is owed on any page they might land on first: what this
// site is, and when it last looked. Both are one line, because a footer that
// asks for attention takes it from the season above it.
//
// A page speaks for as many conferences as it shows, and they do not collect
// at the same time — ten hours can separate two of these stamps. So the
// footer takes a list and prints every stamp in it. Flattening them to one
// "collected through" time would hide the spread behind the freshest number,
// which is the one thing provenance must not do.
//
// One stamp sits on the identity line, where it has always sat. Several take
// a line of their own beneath it: three conference names will not share a
// line with the identity, and the alternative — abbreviating them to codes to
// make them fit — would give this footer a voice no other page's footer has.
import { aboutHref, type Season } from "../lib/derive.ts";
import { dayOfMonth, monShort } from "../lib/format.ts";
import { site } from "../site.config.ts";

interface Props {
  /** Every conference this page speaks for, in the order it should be read. */
  seasons: readonly Season[];
}
const { seasons } = Astro.props;
const stamps = seasons.map((season) => {
  const iso = season.collectedAt;
  return {
    key: season.key,
    conference: site.conferenceNames[season.key] ?? season.fixtures.conference,
    collected: `${monShort(iso.slice(0, 10))} ${dayOfMonth(iso.slice(0, 10))}, ${iso.slice(11, 16)} UTC`,
  };
});
---

<footer class:list={["site-footer", { "is-multi": stamps.length > 1 }]}>
  <span class="sf-what">
    <strong>Touchline</strong> · independent and unofficial · {site.division}
  </span>
  <span class="grow"></span>
  <span class="sf-stamps">
    {stamps.map((s) => (
      <span class="sf-when num">{s.conference} last collected {s.collected}</span>
    ))}
  </span>
  <a class="sf-about" href={aboutHref()}>About &amp; method</a>
</footer>

<style>
  .site-footer {
    margin-top: 28px;
    padding: 14px 0 8px;
    border-top: 1px solid var(--hairline);
    display: flex; align-items: baseline; gap: 8px 18px; flex-wrap: wrap;
    font-size: 11.5px;
    color: var(--quiet);
  }
  .site-footer strong { color: var(--ink); font-weight: 600; }
  .grow { flex: 1; }
  .sf-about {
    color: var(--accent);
    min-height: 44px; display: inline-flex; align-items: center;
    margin: -14px 0;
  }
  .sf-about:hover { color: var(--accent-hover); }

  /* One stamp is a word on the identity line, so the wrapper gets out of the
     way entirely and the span is the flex item it has always been. */
  .sf-stamps { display: contents; }

  /* Several take the line below, reading left to right in the order the page
     reads its conferences. `order` keeps About & method up on the first line
     where a reader already knows to look for it. */
  .is-multi .sf-stamps {
    display: flex; flex-wrap: wrap; align-items: baseline;
    order: 1; flex-basis: 100%;
  }
  .is-multi .sf-when + .sf-when::before {
    content: "·";
    padding: 0 9px;
    color: var(--fainter);
  }

  @media (max-width: 720px) {
    .site-footer { gap: 6px 14px; }
    .grow { display: none; }
    .sf-when { width: 100%; }
    /* A stamp on its own line needs no separator in front of it. */
    .is-multi .sf-when + .sf-when::before { content: none; }
  }
</style>
