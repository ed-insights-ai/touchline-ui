---
import { site } from "../site.config.ts";
import { loadSeason, seasonHref, teamHref } from "../lib/derive.ts";
import type { Season } from "../lib/derive.ts";

interface Props {
  season: Season;
  /** Highlighted team pill, when the reader is on a team's page. */
  currentTeam?: string;
}
const { season, currentTeam } = Astro.props;

// The nav is built from the conferences the data home actually carries — a
// conference is configuration, and one that failed to collect is simply not
// offered rather than offered and broken.
const tabs = site.conferences.flatMap((key) => {
  try {
    return [{ key, label: loadSeason(key).fixtures.conference }];
  } catch {
    return [];
  }
});
// The publisher's own order, which is the order the conference lists itself in.
const teams = season.fixtures.programmes;
---
<header class="site-header">
  <a class="wordmark" href={seasonHref(season.key)}>
    <span class="wordmark-square"></span>
    <span class="wordmark-name">Touchline</span>
  </a>
  <div class="season-tag num">
    {site.conferenceNames[season.key] ?? season.fixtures.conference} · {season.fixtures.season} ·{" "}
    {season.fixtures.gender.toUpperCase()}
  </div>
  <nav class="confnav">
    {tabs.map((t) => (
      <a href={seasonHref(t.key)} aria-current={t.key === season.key ? "page" : undefined}>{t.label}</a>
    ))}
  </nav>
  <div class="grow"></div>
  <nav class="teampills">
    {teams.map((p) => (
      <a
        href={teamHref(season.key, p.slug)}
        title={p.name}
        aria-current={p.slug === currentTeam ? "page" : undefined}
      ><span>{p.abbr ?? p.name}</span></a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    height: 58px;
    display: flex;
    align-items: center;
    gap: 22px;
    border-bottom: 1px solid var(--hairline);
  }
  .site-header .wordmark { color: var(--ink); }
  .season-tag {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--secondary);
    white-space: nowrap;
  }
  @media (max-width: 1180px) {
    .site-header { height: auto; padding: 12px 0; flex-wrap: wrap; gap: 14px; }
  }
</style>
