---
// The one header, on every page (tl-3rlo). It has two shapes and one grammar:
// with no conference in scope — the home, About — it is the wordmark, the
// season, and the conference menu; inside a conference it adds the team menu
// and a quiet view nav (Overview, Matches) for the pages of that conference.
// A match page and the matches page wear it too, where a Season/Matches pair
// used to stand in for it.
import { site } from "../site.config.ts";
import { homeHref, matchesHref, seasonHref, teamHref } from "../lib/derive.ts";
import type { Season } from "../lib/derive.ts";
import { homeSeasons } from "../lib/home.ts";
import { menuColumns } from "../lib/menu.ts";
import { conferenceEntries } from "../lib/nav.ts";
import { displayNameOf } from "../lib/programmes.ts";
import ConferenceMenu from "./ConferenceMenu.astro";

interface Props {
  /** The conference the reader is inside, when there is one. Absent on the
   *  home and About: the header then carries the conference menu alone. */
  season?: Season;
  /** The team named on the second trigger, when the reader is on a team's page. */
  currentTeam?: string;
  /** False on the one page whose own masthead IS the wordmark — the home —
   *  so the header does not stack a second Touchline over the first. Every
   *  other page keeps it: it is the way back to the top of the site. */
  wordmark?: boolean;
}
const { season, currentTeam, wordmark = true } = Astro.props;

// The conference menu is built from the conferences the data home actually
// carries (lib/nav.ts): a conference is configuration, and one that failed to
// collect is simply not offered rather than offered and broken. The menu is
// region-major (lib/menu.ts): each region a run of rows under its own head,
// whole regions per column, the columns balanced by row count. The regions
// are config, so nothing here names one. The trigger shows the abbreviation
// inside a conference, and the word Conferences where there is none.
const entries = conferenceEntries(homeSeasons());
const columns = menuColumns(entries);

// The publisher's own order, which is the order the conference lists itself in.
const teams = season?.fixtures.programmes ?? [];
const current = teams.find((p) => p.slug === currentTeam);
const currentName = current ? displayNameOf(current.slug, current.name) : null;
const seasonLabel = season
  ? `${season.fixtures.season} · ${season.fixtures.gender.toUpperCase()}`
  : `${site.season} · ${site.gender.toUpperCase()}`;
const confName = season ? (site.conferenceNames[season.key] ?? season.fixtures.conference) : null;

// Which view of the conference this page is, read off the page's own address
// rather than told by each page: the overview is the conference's root and
// the matches page its /matches/, and a team or match page is neither. Astro
// carries the deploy base in the URL already, the same base the hrefs carry.
const here = Astro.url.pathname.replace(/\/?$/, "/");
const isView = (href: string): boolean => here === href.replace(/\/?$/, "/");
---
<header class="site-header">
  {/* The wordmark is the way back to the top of the site, so it points at the
      national home — not at the conference the reader happens to be inside. */}
  {wordmark && (
    <a class="wordmark" href={homeHref()}>
      <span class="wordmark-square"></span>
      <span class="wordmark-name">Touchline</span>
    </a>
  )}
  {/* Where the reader is, in words: the conference's full name, and it is the
      direct way to that conference's overview (tl-3rlo) — the menu beside it
      is for going somewhere else. With no conference in scope the tag is the
      season alone. */}
  <div class="season-tag num">
    {season && confName ? (
      <>
        <a class="season-conf" href={seasonHref(season.key)}>{confName}</a> · {seasonLabel}
      </>
    ) : (
      seasonLabel
    )}
  </div>
  {/* Two disclosures, one grammar: where you are, and where you can go. Each
      is a <details>, so the links inside work with scripting off and the
      trigger toggles on Enter and Space by the browser's own rules. The island
      below adds what a <details> cannot promise on its own: aria-expanded that
      says the truth, arrow keys along the rows, Escape, and the keyboard
      handed back to the trigger it left. The 2px accent rule stays on the
      conference trigger — it is still the answer to "which conference is
      this" — and nothing else in the header is purple but the current row. */}
  <nav class="hnav" aria-label={season ? "Conferences and teams" : "Conferences"}>
    <details class="hmenu hmenu-conf">
      <summary
        class="htab htab-conf"
        aria-label={season ? `Conference: ${season.fixtures.conference}` : "Conferences"}
      >
        <span class="htab-label">{season ? season.fixtures.conference : "Conferences"}</span>
        <svg class="chevron" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 L5 6.5 L8 3.5" /></svg>
      </summary>
      <ConferenceMenu
        columns={columns}
        currentKey={season?.key}
        count={entries.length}
        seasonLabel={seasonLabel}
      />
    </details>
    {season && (
      <details class="hmenu hmenu-team">
        <summary
          class:list={["htab", "htab-team", { "htab-here": !!current }]}
          aria-label={currentName ? `Team: ${currentName}` : "Teams"}
        >
          <span class="htab-label">{currentName ?? "Teams"}</span>
          <svg class="chevron" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 L5 6.5 L8 3.5" /></svg>
        </summary>
        <div class="hmenu-panel">
          <div class="hmenu-head">
            <span class="hmenu-tag num">{teams.length} programmes · {season.fixtures.conference}</span>
            <button type="button" class="hmenu-close">Close</button>
          </div>
          <div class="hmenu-grid hmenu-grid-team">
            {teams.map((p) => (
              <a
                class="mrow"
                href={teamHref(season.key, p.slug)}
                aria-current={p.slug === currentTeam ? "page" : undefined}
              ><span class="mabbr">{p.abbr ?? ""}</span><span class="mname">{displayNameOf(p.slug, p.name)}</span></a>
            ))}
          </div>
        </div>
      </details>
    )}
  </nav>
  {/* The views WITHIN the conference the reader is already in, so they take
      the trigger's type register and none of its vocabulary: no chevron, no
      rule. A hairline sets them apart from the two controls that move. Teams
      is the menu above — there is no teams page to link to — so the nav is
      the two pages a conference has. */}
  {season && (
    <nav class="viewnav" aria-label="Views">
      <a
        href={seasonHref(season.key)}
        aria-current={isView(seasonHref(season.key)) ? "page" : undefined}
      >Overview</a>
      <a
        href={matchesHref(season.key)}
        aria-current={isView(matchesHref(season.key)) ? "page" : undefined}
      >Matches</a>
    </nav>
  )}
  <div class="grow"></div>
</header>

<script>
  // The second JavaScript on this site, on the same terms as the first: turn
  // it off and the header is exactly the <details> it was written as. No link
  // is rewritten and no default is prevented on a link. What is added is what
  // a bare <details> cannot say or do: an aria-expanded that tells the truth,
  // one menu open at a time, arrow keys along the rows, Escape, a click
  // outside, and the keyboard handed back to the trigger that opened it.

  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>(".hnav .hmenu"));
  if (menus.length) {
    const summaryOf = (m: HTMLDetailsElement) => m.querySelector<HTMLElement>(":scope > summary");
    const rowsOf = (m: HTMLDetailsElement) => Array.from(m.querySelectorAll<HTMLElement>("a.mrow"));
    const reflect = (m: HTMLDetailsElement) => summaryOf(m)?.setAttribute("aria-expanded", String(m.open));

    const close = (m: HTMLDetailsElement, returnFocus: boolean) => {
      if (!m.open) return;
      m.open = false;
      if (returnFocus) summaryOf(m)?.focus();
    };

    for (const m of menus) {
      reflect(m);
      m.addEventListener("toggle", () => {
        reflect(m);
        if (m.open) for (const other of menus) if (other !== m) close(other, false);
      });
      m.querySelector(".hmenu-close")?.addEventListener("click", () => close(m, true));
      m.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          e.preventDefault();
          close(m, true);
          return;
        }
        if (!m.open) return;
        const rows = rowsOf(m);
        if (!rows.length) return;
        const at = rows.indexOf(document.activeElement as HTMLElement);
        let next: number | null = null;
        if (e.key === "ArrowDown") next = at < 0 ? 0 : Math.min(at + 1, rows.length - 1);
        else if (e.key === "ArrowUp") next = at < 0 ? rows.length - 1 : Math.max(at - 1, 0);
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = rows.length - 1;
        if (next === null) return;
        e.preventDefault();
        rows[next]?.focus();
      });
    }

    document.addEventListener("click", (e) => {
      const target = e.target as Node | null;
      for (const m of menus) if (m.open && target && !m.contains(target)) close(m, false);
    });
    // Tabbing out of an open menu leaves it open behind the reader; close it
    // as focus leaves, without pulling focus back.
    document.addEventListener("focusin", (e) => {
      const target = e.target as Node | null;
      for (const m of menus) if (m.open && target && !m.contains(target)) close(m, false);
    });
  }
</script>

<style>
  .site-header {
    height: 58px;
    display: flex;
    align-items: center;
    gap: 22px;
    border-bottom: 1px solid var(--hairline);
    position: relative;
  }
  .site-header .wordmark { color: var(--ink); }
  .season-tag {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--secondary);
    white-space: nowrap;
  }
  /* The conference's name is a link in the tag's own register: quiet, and it
     answers with ink on hover, the way the view nav does. No underline and no
     accent — the 2px rule on the trigger beside it already says where the
     reader is, and a second purple thing in the header would compete with it. */
  .season-conf { color: inherit; }
  .season-conf:hover { color: var(--ink); }
  .viewnav { gap: 16px; }
  @media (max-width: 1180px) {
    .site-header { height: auto; padding: 12px 0; flex-wrap: wrap; gap: 14px; }
  }
  /* The full conference name does not fit a 320px phone on one line
     (measured: "Great Lakes Valley Conference · 2026 · MEN" ran 14px past the
     edge), so on a phone the tag may wrap; it is the same words. */
  @media (max-width: 480px) {
    .season-tag { white-space: normal; min-width: 0; }
  }
</style>
