---
// The match in one line: ninety minutes drawn to scale, two lanes — the home
// side above the axis, the away side below — with visual weight following
// importance. The goal is the only labeled mark and drops a purple hairline
// through both lanes; shots are ink rings; corners thin ticks; fouls and
// offsides the smallest gray dots; cards the pip encoding the cautions panel
// already uses. Roster changes are not match action: substitutions, keeper
// changes and lineup entries sit behind one labeled toggle, off by default.
//
// Which marks exist, which pile shares a minute, and which plays are counted
// in the note instead of drawn is lib/timeline.ts; this file is the drawing.
// The strip never scrolls sideways: on a phone it compresses — smaller marks
// at the same honest positions — because a timeline that reflows is lying
// about when something happened, but one that scrolls off-screen on the
// device most readers hold is not being read at all.
//
// Interaction is script-free. Hover shows a stack's published lines verbatim;
// selecting a stack (it is a radio) prints clock · team · line in a detail
// row under the strip, so the fact is reachable by touch and keyboard too.
import type { LaneStack, MarkKind, MatchStrip } from "../lib/timeline.ts";

interface Props {
  homeAbbr: string;
  awayAbbr: string;
  strip: MatchStrip;
}
const { homeAbbr, awayAbbr, strip } = Astro.props;
const { fullTime } = strip;

const at = (minute: number): number => Math.min(100, Math.max(0, (minute / fullTime) * 100));

// Both lanes' stacks, flattened so each can carry a radio id.
const lanes: { lane: "home" | "away"; stack: LaneStack }[] = [
  ...strip.home.map((stack) => ({ lane: "home" as const, stack })),
  ...strip.away.map((stack) => ({ lane: "away" as const, stack })),
];

const present = new Set<MarkKind>();
for (const { stack } of lanes) for (const m of stack.marks) present.add(m.kind);

const hasToggle = strip.subCount > 0;

// Quarter-hour ticks, quiet on the axis; only 0′, HT and full time speak.
const ticks: number[] = [];
for (let m = 0; m <= fullTime; m += 15) ticks.push(m);
if (ticks[ticks.length - 1] !== fullTime) ticks.push(fullTime);

const NOUN: Record<MarkKind, string> = {
  goal: "goal",
  shot: "shot",
  corner: "corner",
  foul: "foul",
  offside: "offside",
  card: "caution",
  red: "red card",
  sub: "substitution",
  roster: "roster change",
};
const noteText = strip.notes
  .map((n) => `${n.count} ${NOUN[n.kind]}${n.count === 1 ? "" : "s"} with ${n.reason}`)
  .join(" · ");

// The selection wiring is per-stack, so the rules are generated here rather
// than written in the scoped style below: radio i shows detail row i, hides
// the hint, and hands its stack a focus ring for keyboard readers.
const selectionCss = lanes
  .map(
    (_, i) =>
      `#tls-${i}:checked ~ .tl-detail > .tld-${i}{display:flex}` +
      `#tls-${i}:checked ~ .tl-detail > .tl-hint{display:none}` +
      `#tls-${i}:focus-visible ~ .timeline label[for="tls-${i}"]{outline:1px solid var(--accent);outline-offset:3px}`,
  )
  .join("\n");

/** A stack carrying nothing but roster movement. The strip does not draw one
 *  until the substitutions toggle asks for it, so nothing else may offer it
 *  either — one test, used by the mark and by the control that selects it. */
const subOnly = (stack: LaneStack): boolean =>
  stack.marks.every((m) => m.kind === "sub" || m.kind === "roster");

const stackLabel = (stack: LaneStack): string =>
  `${stack.minute}′ — ${stack.marks.length} ${stack.marks.length === 1 ? "play" : "plays"}`;
---

<section class="timeline-band">
  <div class="timeline-head">
    <h2 class="sechead">MATCH TIMELINE</h2>
    <div class="grow"></div>
    <div class="legend">
      <span class="lanes">{homeAbbr} ABOVE · {awayAbbr} BELOW</span>
      {present.has("goal") && <span><i class="lk lk-goal"></i>GOAL</span>}
      {present.has("shot") && <span><i class="lk lk-shot"></i>SHOT</span>}
      {present.has("corner") && <span><i class="lk lk-corner"></i>CORNER</span>}
      {(present.has("foul") || present.has("offside")) && (
        <span><i class="lk lk-dot"></i>FOUL · OFFSIDE</span>
      )}
      {present.has("card") && <span><i class="key key-card"></i>CAUTION</span>}
      {present.has("red") && <span><i class="key key-red"></i>RED CARD</span>}
    </div>
  </div>

  {hasToggle && <input type="checkbox" id="tl-subs" class="tl-subs-box" />}
  {lanes.map(({ stack }, i) => (
    <input
      type="radio"
      name="tl-select"
      class={`tls${subOnly(stack) ? " tls-subonly" : ""}`}
      id={`tls-${i}`}
      aria-label={stackLabel(stack)}
    />
  ))}

  <div
    class="timeline"
    style={`--th-off:${strip.tallest.home};--ta-off:${strip.tallest.away};--th-on:${strip.tallestAll.home};--ta-on:${strip.tallestAll.away}`}
  >
    {strip.goals.map((g) => (
      <div class="goal-line" style={`left:${g.x}%`}></div>
    ))}
    <div class="axis"></div>
    {ticks.map((m) => (
      <div class={`tick${m === 45 ? " tick-ht" : ""}`} style={`left:${at(m)}%`}></div>
    ))}
    <div class="tick-label" style="left:0">0′</div>
    <div class="tick-label tick-mid" style={`left:${at(45)}%`}>HT</div>
    <div class="tick-label tick-end" style="left:100%">{fullTime}′</div>

    {lanes.map(({ lane, stack }, i) => (
      <>
        <label
          class={`stack stack-${lane}${subOnly(stack) ? " stack-subonly" : ""}`}
          style={`left:${stack.x}%`}
          for={`tls-${i}`}
        >
          {stack.marks.map((m) => (
            <i
              class={`pip pip-${m.kind}${m.kind === "sub" || m.kind === "roster" ? " m-sub" : ""}`}
            ></i>
          ))}
        </label>
        {/* The tooltip is a pointer affordance and nothing else. It sits at
            opacity 0 rather than display:none — it has to be laid out to be
            measured, and it is the stack's sibling because the hover selector
            depends on that — so without this it stayed in the accessibility
            tree, and a reader heard every published line here, then heard the
            selected one again below, then heard the whole ledger. The lines
            are not lost: selecting a mark prints them under the strip, and
            the play-by-play below is the complete sequence. */}
        <span class="mark-detail" aria-hidden="true">
          {stack.marks.map((m) => (
            <span class={`md-row${m.kind === "sub" || m.kind === "roster" ? " m-subrow" : ""}`}>{m.raw}</span>
          ))}
        </span>
      </>
    ))}

    {strip.goals.map((g) => (
      <div
        class={`goal-label lane-${g.home ? "home" : "away"} tier-${g.tier} at-${g.align}`}
        style={`left:${g.x}%`}
      >{g.text}</div>
    ))}
  </div>

  {(hasToggle || noteText) && (
    <div class="tl-foot">
      {hasToggle && (
        <label class="tl-toggle" for="tl-subs">
          <span>+ SUBSTITUTIONS · {strip.subCount}</span>
        </label>
      )}
      {noteText && <span class="tl-note">NOT ON THE STRIP: {noteText.toUpperCase()}</span>}
    </div>
  )}

  {/* Selecting a mark is a :checked rule, so nothing in the DOM changes when
      a reader moves through the marks — only which row is displayed. Announced
      politely, this row is the timeline's spoken summary: one mark at a time,
      the clock, the side and the programme's own sentence. */}
  <div class="tl-detail num" aria-live="polite">
    <div class="tl-hint">HOVER A MARK — OR SELECT ONE — FOR THE PUBLISHED LINE</div>
    {lanes.map(({ stack }, i) => (
      <div class={`tld tld-${i}`}>
        {stack.marks.map((m) => (
          <div class={`tld-row${m.kind === "sub" || m.kind === "roster" ? " tld-row-sub" : ""}`}>
            <span class="tld-clock">{m.clock}</span>
            <span class="tld-team">{m.team}</span>
            <span class="tld-line">{m.raw}</span>
          </div>
        ))}
      </div>
    ))}
  </div>
  <style is:inline set:html={selectionCss}></style>
</section>

<style>
  .timeline-band {
    padding: 18px 0 20px;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    display: flex; flex-direction: column; gap: 10px;
  }
  .timeline-head { display: flex; align-items: baseline; }
  .grow { flex: 1; }
  .legend {
    display: flex; gap: 16px; align-items: center;
    font-size: 10.5px; letter-spacing: 0.1em; color: var(--faint);
  }
  .legend span { display: flex; align-items: center; gap: 6px; }
  .legend .lanes { color: var(--secondary); }
  .lk { display: inline-block; flex: none; box-sizing: border-box; }
  .lk-goal { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .lk-shot { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--ink); }
  .lk-corner { width: 2px; height: 10px; background: var(--ink-soft); }
  .lk-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--faint); }

  .tl-subs-box, .tls {
    position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none;
  }

  /* The band is laid out from each lane's tallest stack: --th and --ta are
     the headroom the lanes need, in marks, and they swap to the toggled-open
     values when the roster layer is shown. Everything else is derived. */
  .timeline {
    --pitch: 14px;   /* one mark's slot in a stack */
    --cap: 34px;     /* the two goal-label tiers above the home lane */
    --foot: 50px;    /* the two away tiers plus the tick-label row */
    --th: var(--th-off);
    --ta: var(--ta-off);
    --lane-h: calc(var(--th) * var(--pitch) + 8px);
    --lane-a: calc(var(--ta) * var(--pitch) + 8px);
    position: relative;
    height: calc(var(--cap) + var(--lane-h) + 2px + var(--lane-a) + var(--foot));
  }
  .tl-subs-box:checked ~ .timeline { --th: var(--th-on); --ta: var(--ta-on); }
  .timeline .m-sub { display: none; }
  .tl-subs-box:checked ~ .timeline .m-sub { display: flex; }
  .timeline .stack-subonly { display: none; }
  .tl-subs-box:checked ~ .timeline .stack-subonly { display: flex; }
  /* And with the mark goes the control that selects it. The radios are
     visually hidden rather than display:none, which is what keeps them
     operable — but a stack of pure roster movement is not on the strip until
     the toggle asks for it, and a reader tabbing the timeline was being
     offered marks that are not drawn: 18 of 45 radios on the messiest match
     in this collect, 17 of 81 on the busiest. A control for something that
     is not there is worse than no control. */
  .tls-subonly { display: none; }
  .tl-subs-box:checked ~ .tls-subonly { display: inline-block; }

  .axis {
    position: absolute; top: calc(var(--cap) + var(--lane-h));
    left: 0; right: 0; height: 2px; background: var(--outline);
  }
  /* A goal structures the whole strip: one hairline through both lanes. */
  .goal-line {
    position: absolute; top: var(--cap); width: 1px;
    height: calc(var(--lane-h) + 2px + var(--lane-a));
    background: var(--goal-line);
  }
  .tick {
    position: absolute; top: calc(var(--cap) + var(--lane-h) - 5px);
    width: 1px; height: 12px; background: var(--tick);
  }
  .tick-ht { top: calc(var(--cap) + var(--lane-h) - 7px); height: 16px; }
  .tick-label {
    position: absolute; bottom: 0;
    font-size: 10px; color: var(--faint);
  }
  .tick-mid { transform: translateX(-50%); }
  .tick-end { transform: translateX(-100%); }

  .stack {
    position: absolute; transform: translateX(-50%);
    display: flex; align-items: center; width: 14px;
    cursor: pointer;
  }
  /* The pips are small; the touch target is not. */
  .stack::after { content: ""; position: absolute; inset: -6px -5px; }
  .stack-home {
    bottom: calc(var(--lane-a) + var(--foot) + 2px);
    flex-direction: column-reverse;
  }
  .stack-away {
    top: calc(var(--cap) + var(--lane-h) + 2px);
    flex-direction: column;
  }

  /* Each pip occupies one pitch of the stack whatever shape it draws, so a
     mixed pile spaces evenly and the headroom arithmetic above stays true. */
  .pip {
    flex: none; width: 14px; height: var(--pitch);
    display: flex; align-items: center; justify-content: center;
  }
  /* base.css sets border-box on `*`, which does not match a pseudo-element:
     without this the shot's ring is added OUTSIDE its 9px. */
  .pip::before { content: ""; display: block; box-sizing: border-box; }
  .pip-goal::before { width: 12px; height: 12px; border-radius: 50%; background: var(--accent); }
  .pip-shot::before { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--ink); }
  .pip-corner::before { width: 2px; height: 10px; background: var(--ink-soft); }
  .pip-foul::before, .pip-offside::before {
    width: 4px; height: 4px; border-radius: 50%; background: var(--faint);
  }
  /* Cards keep the encoding the cautions panel uses (tui-o4k): same shape,
     amber for a caution, the alert colour for a sending-off. */
  .pip-card::before { width: 8px; height: 11px; border-radius: 1.5px; background: var(--draw); }
  .pip-red::before { width: 8px; height: 11px; border-radius: 1.5px; background: var(--loss); }
  .pip-sub::before, .pip-roster::before { width: 8px; height: 2px; background: var(--chevron); }

  /* The one labeled mark. Above its own lane for the home side, below for
     the away side, staggered across two tiers so neighbours stay legible. */
  .goal-label {
    position: absolute; transform: translateX(-50%);
    font-size: 11px; line-height: 12px; font-weight: 600;
    color: var(--accent); white-space: nowrap;
  }
  .goal-label.lane-home.tier-a { top: calc(var(--cap) - 16px); }
  .goal-label.lane-home.tier-b { top: calc(var(--cap) - 30px); }
  .goal-label.lane-away.tier-a { bottom: calc(var(--foot) - 20px); }
  .goal-label.lane-away.tier-b { bottom: calc(var(--foot) - 36px); }
  .goal-label.lane-away { color: var(--secondary); }
  .goal-label.at-end { transform: translateX(-100%); }
  .goal-label.at-start { transform: none; }

  /* Hover: the published lines, verbatim, centred on the band rather than on
     the mark — a nowrap panel centred on a mark near 90′ pushes the page
     sideways. It stays the stack's SIBLING; the selector below depends on it. */
  .mark-detail {
    position: absolute; left: 50%; bottom: calc(100% + 6px); transform: translateX(-50%);
    z-index: 15;
    display: flex; flex-direction: column; gap: 2px;
    max-width: min(480px, 92vw); white-space: normal; overflow-wrap: anywhere;
    background: var(--ink); color: var(--paper);
    font-size: 13.5px; letter-spacing: 0.01em; line-height: 1.5;
    padding: 4px 8px; border-radius: 4px;
    opacity: 0; pointer-events: none; transition: opacity 90ms ease-out;
  }
  .stack:hover + .mark-detail { opacity: 1; }
  .timeline .m-subrow { display: none; }
  .tl-subs-box:checked ~ .timeline .m-subrow { display: block; }
  @media (prefers-reduced-motion: reduce) { .mark-detail { transition: none; } }

  .tl-foot { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .tl-toggle { min-height: 44px; display: flex; align-items: center; cursor: pointer; margin: -12px 0; }
  .tl-toggle > span {
    font-size: 10px; letter-spacing: 0.14em; font-weight: 600;
    color: var(--faint); border: 1px solid var(--outline);
    padding: 3px 10px; border-radius: 3px; white-space: nowrap;
  }
  .tl-toggle:hover > span { color: var(--ink-soft); border-color: var(--chevron); }
  .tl-subs-box:checked ~ .tl-foot .tl-toggle > span {
    color: var(--accent); border-color: var(--accent-border);
  }
  .tl-subs-box:focus-visible ~ .tl-foot .tl-toggle > span {
    outline: 1px solid var(--accent); outline-offset: 2px;
  }
  /* The named note: plays that exist in the account but cannot sit on a
     timeline. Counted out loud, never guessed onto a minute. */
  .tl-note { font-size: 10.5px; letter-spacing: 0.1em; color: var(--secondary); }

  .tl-detail { display: flex; flex-direction: column; min-height: 18px; }
  .tl-hint { font-size: 10.5px; letter-spacing: 0.1em; color: var(--fainter); }
  .tld { display: none; flex-direction: column; gap: 3px; }
  .tld-row { display: flex; gap: 12px; font-size: 13px; align-items: baseline; }
  .tld-row-sub { display: none; }
  .tl-subs-box:checked ~ .tl-detail .tld-row-sub { display: flex; }
  .tld-clock { color: var(--faint); flex: none; width: 44px; }
  .tld-team { color: var(--ink-soft); flex: none; min-width: 40px; }
  .tld-line { color: var(--secondary); overflow-wrap: anywhere; }

  /* Phone: the strip compresses instead of scrolling — same honest positions,
     smaller marks. The page body never scrolls sideways. */
  @media (max-width: 720px) {
    .timeline-head { flex-wrap: wrap; gap: 8px 14px; }
    .legend { flex-wrap: wrap; gap: 6px 12px; font-size: 10px; }
    .timeline { --pitch: 11px; --cap: 30px; --foot: 46px; }
    .stack { width: 11px; }
    .pip { width: 11px; }
    .pip-goal::before { width: 10px; height: 10px; }
    .pip-shot::before { width: 7px; height: 7px; border-width: 1.25px; }
    .pip-corner::before { width: 1.5px; height: 8px; }
    .pip-foul::before, .pip-offside::before { width: 3px; height: 3px; }
    .pip-card::before { width: 6px; height: 9px; }
    .pip-red::before { width: 6px; height: 9px; }
    .pip-sub::before, .pip-roster::before { width: 6px; height: 2px; }
    .goal-label { font-size: 10px; line-height: 11px; }
    .goal-label.lane-home.tier-a { top: calc(var(--cap) - 14px); }
    .goal-label.lane-home.tier-b { top: calc(var(--cap) - 26px); }
    .goal-label.lane-away.tier-a { bottom: calc(var(--foot) - 18px); }
    .goal-label.lane-away.tier-b { bottom: calc(var(--foot) - 32px); }
    .tld-row { flex-wrap: wrap; gap: 4px 10px; }
  }
</style>
