---
// How the home page lays its conferences out. It decides nothing about the
// data: the page computes the views, the layout, the bands and the footprints
// (lib/home.ts, lib/geo.ts) and this renders what it is handed.
//
// "columns": one column per conference, in kickoff order — the layout the
// page has always had for a site under its column cap, rule for rule, so the
// render below the cap is pixel-identical (scripts/visual.sh holds it to
// that).
//
// "bands": the map-led section (tl-38t). The map sits beside the bands from
// a section width of 900px, sticky while the bands scroll, and its region
// labels are the control; narrower, the map stacks above a sticky chip row
// and the bands, and the chips carry the job where the map is too small to
// hit well. One region is selected — the map ink, the chips and the open
// band share the one state — and exactly one band is open at rest, chosen
// server-side (lib/home.ts openBandIndex): the headline's region, else the
// imminent band, else the first.
//
// Server-rendered at rest, with one small script. The section reads
// correctly with no script at all: the open band shows, the closed bands
// show their heads, and every head, chip and map label is a link to its
// band's anchor (HomeBands.astro says how :target keeps one band open). The
// script below only moves the selection — hover previews on a fine pointer,
// click or tap pins, a chip or a map label on a narrow section scrolls the
// band head into view — and it fetches nothing.
//
// Nothing conference- or region-specific is written here: the regions come
// from the bands (site.regions order), the conferences from the views.
import type { ConferenceFootprint } from "../lib/geo.ts";
import type { BandColumn, CardView, HomeBand, HomeLayout } from "../lib/home.ts";
import { leadLine, openBandIndex } from "../lib/home.ts";
import ConferenceCard from "./ConferenceCard.astro";
import HomeBands from "./HomeBands.astro";
import HomeMap from "./HomeMap.astro";

interface Props {
  /** In kickoff order. */
  cards: readonly (CardView & BandColumn)[];
  layout: HomeLayout;
  bands: HomeBand<CardView & BandColumn>[];
  footprints: readonly ConferenceFootprint[];
  /** The programme the division's headline is about (journal basis), if any. */
  headlineProgramme: string | null;
  /** The followed conference that lists a programme, or null. */
  conferenceOf: (slug: string) => string | null;
  /** The headline conference and programme, resolved by the page, or null. */
  headline: { key: string; code: string; programme: string } | null;
  divisionConferences: number;
}
const {
  cards,
  layout,
  bands,
  footprints,
  headlineProgramme,
  conferenceOf,
  headline,
  divisionConferences,
} = Astro.props as Props;

const open = openBandIndex(bands, headlineProgramme, conferenceOf);
const openBand = bands[open] ?? null;
const selected = openBand?.region.key ?? null;
const regionOf: Record<string, string> = Object.fromEntries(
  bands.flatMap((b) => b.columns.map((c) => [c.key, b.region.key])),
);
const openIsHeadline =
  headline !== null && openBand !== null && openBand.columns.some((c) => c.key === headline.key);
const lead = openBand ? leadLine(openBand, openIsHeadline ? headline : null) : null;
---
{layout === "columns" ? (
  <section class="confs-cols" style={`--conf-cols: ${cards.length};`}>
    {cards.map((c) => <ConferenceCard {...c} />)}
  </section>
) : (
  <section class="confs" data-home-confs>
    <div class="confs-head">
      <h2 class="confs-sechead">THE CONFERENCES</h2>
      <div class="grow"></div>
      <div class="confs-scope num">
        {cards.length} CONFERENCES · {bands.length} REGIONS
      </div>
    </div>
    {lead && <p class="lead-line">{lead}</p>}
    <div class="stage">
      <HomeMap
        footprints={footprints}
        regionOf={regionOf}
        selected={selected}
        headlineProgramme={headlineProgramme}
        divisionConferences={divisionConferences}
      />
      <HomeBands bands={bands} open={open} headline={headline} />
    </div>
    <script is:inline>
      (() => {
        const root = document.querySelector("[data-home-confs]");
        if (!root) return;
        const col = root.querySelector(".bandcol");
        if (col) col.dataset.js = "";
        const lead = root.querySelector(".lead-line");
        const bands = Array.from(root.querySelectorAll(".band"));
        const atRest = bands.find((b) => b.dataset.open === "true");
        if (!atRest) return;
        let pinned = atRest.dataset.region;
        let preview = null;
        const all = (s) => Array.from(root.querySelectorAll(s));
        // One state, applied everywhere it shows: the map's dots and labels,
        // the chips, the bands, the lead line.
        const apply = () => {
          const rk = preview || pinned;
          for (const d of all(".dot")) {
            d.classList.toggle("on", d.dataset.region === rk);
            d.classList.toggle("dim", d.dataset.region !== rk);
          }
          for (const t of all(".rlabel")) t.classList.toggle("on", t.dataset.region === rk);
          for (const c of all(".chip")) c.setAttribute("aria-pressed", String(c.dataset.region === rk));
          for (const b of bands) {
            const on = b.dataset.region === rk;
            b.dataset.open = String(on);
            const head = b.querySelector(".bhead");
            if (head) head.setAttribute("aria-expanded", String(on));
            if (on && lead) lead.textContent = (!preview && b.dataset.leadHeadline) || b.dataset.lead || "";
          }
        };
        const narrow = () => root.getBoundingClientRect().width < 900;
        const pin = (rk, scroll) => {
          pinned = rk;
          preview = null;
          apply();
          if (!scroll || !narrow()) return;
          const band = bands.find((b) => b.dataset.region === rk);
          if (!band) return;
          const chips = root.querySelector(".chips");
          const pad = (chips ? chips.getBoundingClientRect().height : 0) + 8;
          const top = band.getBoundingClientRect().top + window.scrollY - pad;
          const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top, behavior: still ? "auto" : "smooth" });
        };
        root.addEventListener("click", (e) => {
          const t = e.target.closest("[data-region]");
          if (!t || !root.contains(t) || t.classList.contains("dot") || t.classList.contains("band")) return;
          e.preventDefault();
          // The open band's own head does nothing: there is always one open.
          if (t.classList.contains("bhead") && t.dataset.region === pinned) return;
          pin(t.dataset.region, !t.classList.contains("bhead"));
        });
        // Hover previews only where hover is a thing: a fine pointer.
        const fine = matchMedia("(hover: hover) and (pointer: fine)");
        const map = root.querySelector(".map");
        if (map) {
          map.addEventListener("pointerover", (e) => {
            if (!fine.matches) return;
            const t = e.target.closest("[data-region]");
            if (t) {
              preview = t.dataset.region;
              apply();
            }
          });
          map.addEventListener("pointerleave", () => {
            if (preview) {
              preview = null;
              apply();
            }
          });
        }
        // A reader who arrived on a band's anchor gets that band, once.
        const hash = location.hash.startsWith("#region-") ? location.hash.slice(8) : "";
        if (hash && bands.some((b) => b.dataset.region === hash)) pin(hash, true);
        else apply();
      })();
    </script>
  </section>
)}

<style>
  /* ── One column per conference ──────────────────────────────────────────── */
  .confs-cols {
    display: grid;
    grid-template-columns: repeat(var(--conf-cols, 1), minmax(0, 1fr));
    padding: 26px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .confs-cols :global(.conf:first-child) { padding-left: 0; }
  .confs-cols :global(.conf:last-child) { padding-right: 0; }
  .confs-cols :global(.conf + .conf) { border-left: 1px solid var(--hairline); }
  @media (max-width: 1180px) {
    .confs-cols { grid-template-columns: minmax(0, 1fr); row-gap: 24px; }
    .confs-cols :global(.conf) { padding: 0; }
    .confs-cols :global(.conf + .conf) { border-left: none; border-top: 1px solid var(--hairline); padding-top: 24px; }
  }

  /* ── The map-led section ────────────────────────────────────────────────── */
  /* The section is the container its columns query: the two-column stage
     from 900px of SECTION width, whatever the viewport. */
  .confs {
    container-type: inline-size;
    container-name: confs;
    padding: 18px 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .confs-head { display: flex; align-items: baseline; gap: 12px; }
  /* The same register as LAST NIGHT's head, one section down. */
  .confs-sechead { margin: 0; font-size: 11px; letter-spacing: 0.2em; font-weight: 600; }
  .confs-scope { font-size: 11px; letter-spacing: 0.1em; color: var(--quiet); }
  /* The line under the head: what the open band is doing, and, while the
     headline's band is the one open, why it is open. Serif italic, quiet —
     the editorial whisper, one rung under the head. */
  .lead-line {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.45;
    color: var(--quiet);
    text-wrap: pretty;
  }
  .stage { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; padding-top: 6px; }
  @container confs (min-width: 900px) {
    .stage {
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
      column-gap: 40px;
      align-items: start;
    }
  }
  @container confs (max-width: 720px) {
    .confs-head { flex-wrap: wrap; gap: 6px 12px; }
  }
</style>
