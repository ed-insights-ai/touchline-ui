---
// The calendar week the collect landed in, as a newspaper column of day
// groups. Monday to Sunday, every day printed — a day with nothing on it says
// so, because an empty Tuesday is a fact about the week and not a gap in the
// page.
//
// Each line reads away "at" home, the way a schedule is spoken. The programme
// this site collects carries the weight; an opponent it does not follow stays
// quiet. When two collected programmes meet, both carry it — there is no
// reason to favour either.
import { dayOfMonth, dowLong, monLong } from "../lib/format.ts";
import { matchHref, type Season } from "../lib/derive.ts";
import { kickoff, weekOf } from "../lib/schedule.ts";

interface Props {
  season: Season;
  matchesHref: string;
}
const { season, matchesHref } = Astro.props as Props;

const week = weekOf(season);
const names = season.names;
const members = new Set(season.fixtures.programmes.map((p) => p.slug));

const dayLabel = (iso: string): string =>
  `${dowLong(iso).toUpperCase()}, ${monLong(iso).toUpperCase()} ${dayOfMonth(iso)}`;

// The closed state is one quiet line: the count and a caret. The week's date
// range went with the SEASON STORY band — the spine's flag now says which
// week it is — and the count is the same list the docket renders beneath.
const count = week.matches.length;
// The league count rides the strip once there is one, in the words the spine's
// legend uses; each league row also wears the league colour in the margin.
const headline =
  count === 0
    ? "NO MATCHES THIS WEEK"
    : `${count} ${count === 1 ? "MATCH" : "MATCHES"} THIS WEEK` +
      (week.leagueMatches > 0 ? ` · ${week.leagueMatches} LEAGUE` : "");

// The week splits into two columns at desk width; the break keeps whole days
// together rather than cutting one across the gutter.
const half = Math.ceil(week.days.length / 2);
const columns = [week.days.slice(0, half), week.days.slice(half)];

const emptyNote =
  `No match anywhere in this conference between ${monLong(week.start)} ${dayOfMonth(week.start)} and ` +
  `${monLong(week.end)} ${dayOfMonth(week.end)}. The week is empty, and that is the record.`;
---

<section class="week">
  {/* The docket folds because the spine above it is the season's always-visible
      visual and this is the detail beneath it. Native <details>: the week is
      reachable with JavaScript off, and nothing about it is remembered between
      pages. The summary keeps what the closed state has to say for itself. */}
  <details class="disclosure wk-fold">
    <summary class="wk-summary">
      <h2 class="wk-title">{headline}</h2>
      {/* Sits with the label it opens. At the far right it would read as part
          of "ALL MATCHES →", which is a different destination entirely. */}
      <i class="caret" aria-hidden="true"></i>
    </summary>

  {week.matches.length === 0 ? (
    <p class="wk-empty">{emptyNote}</p>
  ) : (
    <div class="wk-cols">
      {columns.map((col) => (
        <div class="wk-col">
          {col.map((day) => (
            <div class="wk-day">
              <div class="wk-date">{dayLabel(day.date)}</div>
              {day.matches.length === 0 ? (
                <p class="wk-none serif-italic">No matches.</p>
              ) : (
                day.matches.map((f) => (
                  <a
                    class={f.conference_game ? "wk-row wk-league hoverable" : "wk-row hoverable"}
                    href={matchHref(season.key, f.id)}
                  >
                    <span class="wk-line">
                      {f.conference_game && <span class="vh">League match. </span>}
                      <span class={members.has(f.away) ? "wk-side wk-mine" : "wk-side"}>
                        {names.name(f.away)}
                      </span>
                      <span class="wk-at"> at </span>
                      <span class={members.has(f.home) ? "wk-side wk-mine" : "wk-side"}>
                        {names.name(f.home)}
                      </span>
                      {f.venue && <span class="wk-venue"> · {f.venue}</span>}
                    </span>
                    <span class="wk-time num">{kickoff(f.time) ?? "—"}</span>
                  </a>
                ))
              )}
            </div>
          ))}
        </div>
      ))}
    </div>
  )}

  </details>

  {/* Outside the fold on purpose: the road to every match stays open whether or
      not this week is expanded, and a link inside a <summary> would be a click
      that both follows and toggles. */}
  <a class="wk-all" href={matchesHref}>ALL MATCHES →</a>
</section>

<style>
  /* One row, two things in it: the fold spans the full width so the expanded
     docket keeps every pixel it had, and the ALL MATCHES link shares that first
     row so it sits on the summary line without being inside the click target. */
  .week {
    padding: 20px 0 18px;
    border-bottom: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 16px;
  }
  .wk-fold {
    grid-column: 1 / -1;
    grid-row: 1;
    /* Both items in this row sit on the summary's baseline, so the link reads
       as part of the same line rather than three pixels above it. */
    align-self: baseline;
    /* Block, not a flex column: a closed <details> still lays out its hidden
       children enough to leave a flex gap behind, which put 14px of dead space
       under the summary. Spacing lives on the children instead, so the closed
       state is exactly the summary row. */
  }
  .wk-summary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 14px;
    /* A tap target, and room kept clear for the link overlaying this row. */
    min-height: 44px;
    padding: 6px 128px 6px 0;
  }
  .wk-title { margin: 0; font-size: 11px; letter-spacing: 0.2em; font-weight: 600; }
  /* The same caret By the Numbers uses for a line that opens on more. */
  .caret {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--chevron);
    border-bottom: 1.5px solid var(--chevron);
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
  }
  .wk-fold[open] .caret { transform: rotate(45deg); }
  .wk-summary:hover .wk-title { color: var(--accent); }
  .wk-all {
    grid-column: 2;
    grid-row: 1;
    align-self: baseline;
    padding: 6px 0;
    font-size: 11px;
    letter-spacing: 0.14em;
    font-weight: 600;
    color: var(--accent);
  }
  .wk-all:hover { color: var(--accent-hover); }

  .wk-cols { margin-top: 18px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 56px; }
  .wk-col { display: flex; flex-direction: column; }
  /* Each day is a block: its label in ink over a rule darker than the row
     hairlines, and clear air before the next day, so the eye finds where a
     day starts and ends without reading the labels (owner, 2026-09-01). */
  .wk-day { display: flex; flex-direction: column; }
  .wk-day + .wk-day { margin-top: 26px; }
  .wk-date {
    padding: 0 0 6px;
    font-size: 10px;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1px solid var(--tenure-rule);
  }
  .wk-date + .wk-row, .wk-date + .wk-none { border-top: none; }
  .wk-none { margin: 0; padding: 7px 0 6px; font-size: 13.5px; color: var(--quiet); }

  .wk-row {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 7px 0;
    border-top: 1px solid var(--hairline-soft);
    color: inherit;
    font-size: 13.5px;
  }
  /* A league match wears the league colour as a square hung in the margin,
     the spine's swatch at the spine's size, so the text does not move and the
     colour keeps the one meaning it has on this site. */
  .wk-league::before {
    content: "";
    position: absolute;
    left: -16px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 1px;
    background: var(--accent);
  }
  .wk-line { flex: 1; min-width: 0; }
  .wk-side { color: var(--quiet); }
  .wk-mine { color: var(--ink); font-weight: 600; }
  .wk-at { color: var(--quiet); }
  .wk-venue { color: var(--quiet); font-size: 12px; }
  .wk-time { flex: none; color: var(--quiet); font-size: 13px; }

  .wk-empty { margin: 14px 0 0; font-size: 14px; line-height: 1.5; color: var(--quiet); max-width: 760px; }

  @media (max-width: 1180px) {
    .wk-cols { grid-template-columns: minmax(0, 1fr); gap: 0; }
  }
  @media (max-width: 720px) {
    /* No room to keep a lane clear beside the summary, so the link takes its
       own line the way the head row already wrapped at this width. */
    .week { grid-template-columns: minmax(0, 1fr); }
    .wk-fold { grid-column: 1; }
    .wk-summary { padding-right: 0; min-height: 40px; }
    .wk-all { grid-column: 1; grid-row: 2; justify-self: start; padding: 4px 0 2px; }
    .wk-row { flex-wrap: wrap; gap: 2px 10px; }
  }
</style>
