---
// The season page's masthead: the kicker, the counts, the story's headline and
// dek, and the one summary figure beneath them.
//
// The coverage line is where the page states what it is standing on, so the
// provenance disclosure for the gap count belongs here and nowhere else.
import type { BoxScoreGap, SeasonCounts } from "../lib/derive.ts";

interface Props {
  kicker: string;
  headline: string;
  dek?: string | null;
  counts: SeasonCounts;
  gaps: BoxScoreGap[];
  /** Shared matches whose score only one programme's page has posted: the
   *  label the gaps use, and which page has not spoken. Empty most days. */
  oneSided?: { label: string; note: string }[];
  /** The figures strip beneath the lede, composed by the page. */
  strip: string[];
  /** When the headline and dek last changed — "UPDATED SEP 1". Null when the
   *  page has no journal, or has one written before the stamp existed: the
   *  tag is a fact about the sentence, so no fact means no tag rather than a
   *  guess. */
  stamp?: string | null;
  /** The journal was written against an earlier collect than this one. */
  stale?: boolean;
}
const {
  kicker,
  headline,
  dek,
  counts,
  gaps,
  oneSided = [],
  strip,
  stamp = null,
  stale = false,
} = Astro.props;
---

<section class="masthead">
  <div class="masthead-top">
    <div class="kicker">{kicker}</div>
    <div class="grow"></div>
    {/* Only the gaps up here. The played count moved into the strip beneath
        the lede, and the score-gap count left the masthead by ruling: the
        season line marks each one and its legend names them. The gap stays
        because it is the one thing here a reader can open. */}
    <div class="coverage num">
      {gaps.length > 0 ? (
        <details class="disclosure gaps">
          <summary class="gapcount">{counts.gaps} {counts.gaps === 1 ? "BOX SCORE GAP" : "BOX SCORE GAPS"}</summary>
          <div class="gaps-panel">
            <div class="gaps-head">
              MATCHES PLAYED WHOSE BOX SCORE THE COLLECTOR COULD NOT REACH
            </div>
            {gaps.map((g) => (
              <div class="gap-row">
                <span class="gap-match">{g.label}</span>
                <span class="gap-reason">{g.reason}</span>
              </div>
            ))}
          </div>
        </details>
      ) : (
        <span>{counts.gaps} BOX SCORE GAPS</span>
      )}
      {/* A final on one side only: the other programme's page has not posted
          the score yet. Printed only while there is one, in the gap count's
          own form, and it opens the same way. */}
      {oneSided.length > 0 && (
        <details class="disclosure gaps">
          <summary class="gapcount">{oneSided.length} {oneSided.length === 1 ? "FINAL" : "FINALS"} ON ONE SIDE ONLY</summary>
          <div class="gaps-panel">
            <div class="gaps-head">
              SHARED MATCHES WHOSE SCORE ONLY ONE PROGRAMME'S PAGE HAS POSTED
            </div>
            {oneSided.map((m) => (
              <div class="gap-row">
                <span class="gap-match">{m.label}</span>
                <span class="gap-reason">{m.note}</span>
              </div>
            ))}
          </div>
        </details>
      )}
    </div>
  </div>
  <h1 class="headline serif">{headline}</h1>
  {/* Serif: the dek is the story's opening paragraph, and serif means story. */}
  {dek && <p class="dek serif">{dek}</p>}
  {stamp && <div class="mast-stamp num">{stamp}</div>}
  {/* The figures, in the national masthead's strip vocabulary: cells and
      middots, nothing a reader has to read as a sentence. */}
  <div class="strip num">
    {strip.map((cell) => <span class="cell">{cell}</span>)}
    {stale && <span class="cell">JOURNAL WRITTEN FOR AN EARLIER COLLECT</span>}
  </div>
</section>

<style>
  .masthead {
    padding: 30px 0 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-bottom: 1px solid var(--hairline);
  }
  .masthead-top { display: flex; align-items: baseline; gap: 8px 16px; flex-wrap: wrap; }
  .kicker { font-size: 11px; letter-spacing: 0.2em; color: var(--accent); font-weight: 600; }
  /* When the lede last changed, in the national masthead's treatment exactly:
     the same fact about the same kind of sentence, so it wears the same type
     on both surfaces. */
  .mast-stamp { font-size: 10px; letter-spacing: 0.12em; color: var(--quiet); }
  .coverage { font-size: 11px; letter-spacing: 0.1em; color: var(--quiet); white-space: nowrap; }
  .coverage > * + * { margin-left: 16px; }
  .gapcount {
    border-bottom: 1px dotted var(--faint);
    white-space: nowrap;
    display: inline-block;
  }
  .gaps { display: inline-block; position: relative; }
  .gaps[open] .gapcount { color: var(--accent); border-bottom-color: var(--accent); }
  .gaps-panel {
    position: absolute; right: 0; top: calc(100% + 8px); z-index: 20;
    width: min(460px, calc(100vw - 2 * var(--gutter)));
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    box-shadow: 0 8px 28px rgba(26, 28, 34, 0.12);
    padding: 12px 14px;
    display: flex; flex-direction: column; gap: 7px;
    letter-spacing: 0;
    text-align: left;
    white-space: normal;
  }
  .gaps-head {
    font-size: 10px; letter-spacing: 0.12em; font-weight: 600; color: var(--quiet);
    line-height: 1.4;
  }
  .gap-row {
    display: flex; flex-direction: column; gap: 1px;
    border-top: 1px solid var(--hairline-soft); padding-top: 6px;
  }
  .gap-match { font-size: 12.5px; color: var(--ink); }
  .gap-reason { font-size: 11.5px; color: var(--secondary); }
  .grow { flex: 1; }
  /* The headline heads the whole page, not the left column: the two-column
     split begins beneath the masthead, and nothing up here answers to it. It
     used to stop at 980px, which under the ten-word headline rule guaranteed
     a wrap with a two-word tail — "…and Sul Ross State / still goalless". Now
     it takes the full measure, and when it does wrap it balances, two even
     lines rather than a long one and an orphan, as the national page's does. */
  .headline {
    margin: 0;
    font-size: 46px;
    line-height: 1.08;
    letter-spacing: -0.005em;
    max-width: none;
    text-wrap: balance;
  }
  /* The same measure as the headline it stands under, and filled the way a
     paragraph fills it: the first line runs the full measure and the last
     takes what is left. Not balanced — balance splits a two-line lede into
     two equal lines that both stop at sixty percent, which reads as the old
     column cap all over again. Pretty only refuses a one-word last line. */
  .dek {
    margin: 0;
    font-size: 18px;
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: none;
    text-wrap: pretty;
  }
  .strip { display: flex; flex-wrap: wrap; margin-top: 2px; font-size: 11.5px; letter-spacing: 0.1em; color: var(--secondary); }
  .cell { white-space: nowrap; }
  @media (max-width: 480px) { .cell { white-space: normal; } }
  .cell + .cell::before { content: "·"; margin: 0 10px; color: var(--outline-quiet); }

  @media (max-width: 1180px) {
    .headline { font-size: 34px; }
  }
  @media (max-width: 720px) {
    .coverage { white-space: normal; }
  }
</style>
