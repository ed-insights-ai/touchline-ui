---
// The method page's body for a level measured on its own seasons after the
// method was built on another (tiers.config.ts methodIsShort): Division I
// men and women, each gender on its own measurement and constants. It says what the level shows, how each position is marked, the
// constants fitted on the level's own seasons, how the badge is set, and
// where the full method is. The measurement behind those choices is the
// build log's and the spec's, not the reader's. The page ([tiers].astro) draws it inside its own
// .tm article, so every class here is that page's and its inline styles reach
// these.
//
// As on the page itself, no division, month or constant is written by hand:
// names come from site.config.ts, the decision and its figures from
// tiers.config.ts, the constants from lib/tier-constants.ts, and the dates
// from the files' frozen_at.
import { divisionHref } from "../lib/gender.ts";
import { CONSTANTS } from "../lib/tier-constants.ts";
import type { TiersFile } from "../lib/tiers.ts";
import { currentDivision, type NcaaDivisionKey, ncaaDivisions } from "../site.config.ts";
import {
  type LevelTiers,
  methodIsShort,
  SHOOTING_LEVELS,
  TIERS_LEVELS,
} from "../tiers.config.ts";
import TierTiles from "./TierTiles.astro";

interface Props {
  tiers: TiersFile;
  shown: LevelTiers;
  /** The month the season's tiers were set in. */
  setIn: string;
  /** "Tiers for the seasons before … were worked out in …", or null. */
  retroactive: string | null;
  firstSeason: number | null;
}

const { tiers, shown, setIn, retroactive, firstSeason } = Astro.props;

const division = currentDivision.name;
const gender = tiers.gender === "men" ? "men's" : "women's";
const groupPlural = { M: "midfielders", F: "forwards" } as const;
const title = (s: string): string => `${s[0]?.toUpperCase() ?? ""}${s.slice(1)}`;
const groupWords = shown.shooting.map((g) => groupPlural[g]).join(" and ");
const twoLevel = shown.shooting
  .filter((g) => SHOOTING_LEVELS[g] === 2)
  .map((g) => groupPlural[g])
  .join(" and ");
const oneLevel = shown.shooting
  .filter((g) => SHOOTING_LEVELS[g] === 1)
  .map((g) => groupPlural[g])
  .join(" and ");

// The level whose page is the full method for this gender, for its link.
const fullKey = (Object.keys(TIERS_LEVELS) as NcaaDivisionKey[]).find((k) => {
  const l = TIERS_LEVELS[k]?.[tiers.gender];
  return l !== undefined && !methodIsShort(l);
});
const full = ncaaDivisions.find((d) => d.key === fullKey) ?? null;
const fullHome = full ? divisionHref(full.key) : null;
const fullMethod = fullHome ? `${fullHome}about/tiers/` : null;

const two = (x: number): string => x.toFixed(2);

const c = CONSTANTS[tiers.level as NcaaDivisionKey]?.[tiers.gender];
const perShot = c ? (c.weights.wG / c.weights.wS).toFixed(2) : null;

const firstSeasonNote =
  firstSeason === null
    ? null
    : `The first season with tiers is ${firstSeason}, and nothing before it is counted: a ${firstSeason} forward or midfielder is judged on that season alone.`;
---

<section class="lede">
  <div class="akicker num">TOUCHLINE · NCAA {division.toUpperCase()}</div>
  <h1 class="atitle serif">Understanding Touchline tiers</h1>
  <p class="intro">
    On {division} pages Touchline shows the <strong>shooting and scoring tier for {gender}{" "}
    {groupWords}</strong>{shown.badge && (<>, and on team pages the <strong>team defense
    badge</strong></>)}. Tiers highlight standout box-score performance — not overall player
    ability.
  </p>
  <TierTiles shown={shown} />
  <p class="tile-footnote">
    Percentages are within one season's eligible {groupWords}, compared separately{shown.badge && ", or the division's teams"}. About{" "}
    <strong>80% of eligible players hold no tier</strong>{shown.badge && ", and about 80% of teams hold no badge"}.
  </p>
</section>

<section class="band" id="positions">
  <h3 class="sechead">HOW EACH POSITION IS MARKED</h3>
  <ul class="list">
    {twoLevel && (
      <li>
        <strong>{title(twoLevel)}:</strong> Tier 1 (the top 5%) or Tier 2 (the next 15%).
      </li>
    )}
    {oneLevel && (
      <li>
        <strong>{title(oneLevel)}:</strong> one tier, the top 20%. A forward's scoring swings
        more from match to match than a midfielder's, so Touchline marks the top fifth rather
        than splitting it, the same way on every level.
      </li>
    )}
    <li>
      <strong>Defenders and goalkeepers:</strong> no player tier. A regular's sheet prints the
      team's defensive figures{shown.badge && ", and the team defense badge goes to the team"}.
    </li>
  </ul>
  <p class="para">No tier is not a bad mark.</p>
</section>

<section class="band" id="how">
  <h3 class="sechead">HOW THE TIER IS SET</h3>
  <p class="para">
    Step for step as on every level: non-penalty goals and shots per 90, each adjusted for the
    defense faced and for home and away; blended with the player's previous season at the same
    program when that season counts, and pulled toward the group average; then the cut inside
    each group, ties included. A player is eligible with 900 minutes this season, or 600 this
    season and 600 the season before.
  </p>
  {c && (
    <>
    <p class="para">
      Two weightings are fitted on {division}'s own seasons, by the same method on every level:
    </p>
    <ul class="list num">
      <li>
        <strong>Threat</strong> = {c.weights.wG} × goals + {c.weights.wS} × shots, per 90 (one goal
        counts as {perShot} shots).
      </li>
      <li>
        <strong>One season counts:</strong> {two(c.blend.one[0])} × this season + {two(c.blend.one[1])} × group
        average.
      </li>
      <li>
        <strong>Two seasons count:</strong> {two(c.blend.two[0])} × this season + {two(c.blend.two[1])} ×
        previous + {two(c.blend.two[2])} × group average.
      </li>
    </ul>
    </>
  )}
  {fullMethod && full && (
    <p class="para">
      The full method, with worked examples, is on the <a href={fullMethod}>{full.name} tiers page</a>.
    </p>
  )}
</section>

{shown.badge && (
  <section class="band" id="badge">
    <h3 class="sechead">HOW THE BADGE IS SET</h3>
    <p class="para">
      Over a team's complete matches (at least 12), Touchline compares the goals it conceded with
      what its opponents usually score: record = ln(opponents' usual ÷ goals conceded). The top
      fifth of the division's teams that season, ties included, hold the badge. Keeping opponents
      from shooting counts as much as stopping their shots, so it credits the whole team's
      defending, from the front line to the goalkeeper. It is one season's, and is not averaged
      with earlier seasons.
    </p>
  </section>
)}

<section class="band" id="when">
  <h3 class="sechead">WHEN TIERS ARE SET</h3>
  <p class="para">
    Tiers are calculated once a season, in {setIn}, and are not moved afterward. The minutes
    printed beside a tier are the minutes counted through that day.{retroactive && ` ${retroactive}`}{firstSeasonNote && ` ${firstSeasonNote}`}
  </p>
</section>
