---
// Every fixture a programme published, in order, each cell carrying either its
// result or its date. Nothing is dropped for want of a score: a silent final
// keeps its cell and says so in the loss colour.
//
// Each cell states its opponent and date through a title attribute alone.
// That is the hover-only-facts problem, and the disclosure that fixes it
// belongs on this component.
//
// The one purple cell is the conference opener (derive.ts conferenceOpenerOf:
// the first fixture that counts in the conference table), and a postseason
// cell wears its round in the ledger's tag. Both are keyed under the strip,
// each only where a cell wears it: a colour nobody explains is decoration,
// and purple on this site is never decoration.
import type { StageChip as Chip } from "../lib/stage.ts";
import StageChip from "./StageChip.astro";

interface Cell {
  href: string;
  /** "vs Delta State · Saturday, August 27" */
  detail: string;
  opponent: string;
  /** The scoreline, or the date when there is not one. */
  line: string;
  /** "by forfeit" or "disputed" under the scoreline, or null. */
  mark?: string | null;
  result: "W" | "D" | "L" | null;
  isOpener: boolean;
  silent: boolean;
  /** The postseason round ("GAC SF", "NCAA R2"), or null. */
  stage?: Chip | null;
  /** Scheduled: the cell carries a date, on a dashed rule. */
  ahead?: boolean;
}
interface Props {
  cells: Cell[];
}
const { cells } = Astro.props;
const anyOpener = cells.some((c) => c.isOpener);
const anyAhead = cells.some((c) => c.ahead);
// One real chip per competition the strip wears, so the key is drawn by the
// chip it explains and names no conference of its own.
const keyChips = [...new Map(cells.flatMap((c) => (c.stage ? [[c.stage.competition, c.stage]] : []))).values()]
  .sort((a, b) => (a.competition === b.competition ? 0 : a.competition === "conference" ? -1 : 1));
---

<h2 class="sechead">SEASON</h2>
<div class="strip num">
  {cells.map((c) => (
    <a
      class={[
        "cell",
        c.result ? `cell-${c.result}` : "",
        c.isOpener ? "cell-opener" : "",
        c.silent ? "cell-silent" : "",
      ]
        .filter(Boolean)
        .join(" ")}
      href={c.href}
    >
      <span class="cell-opp">{c.opponent}</span>
      <span class="cell-line">{c.line}</span>
      {c.mark && <span class="cell-mark">{c.mark}</span>}
      {c.stage && <span class="cell-stage"><StageChip chip={c.stage} size="sm" /></span>}
      <span class="cell-detail">{c.detail}{c.stage ? ` · ${c.stage.phrase}` : ""}{c.isOpener ? " · conference opener" : ""}</span>
    </a>
  ))}
</div>
{(anyOpener || keyChips.length > 0 || anyAhead) && (
  <div class="strip-key">
    {anyOpener && (
      <span class="key-item">
        <span class="key-swatch key-opener" aria-hidden="true"></span>
        <span class="label">Conference opener</span>
      </span>
    )}
    {keyChips.map((chip) => (
      <span class="key-item">
        <span class="key-chips" aria-hidden="true"><StageChip chip={chip} size="sm" /></span>
        <span class="label">
          {chip.competition === "ncaa" ? "NCAA tournament round" : "Conference tournament round"}
        </span>
      </span>
    ))}
    {anyAhead && (
      <span class="key-item">
        <span class="key-swatch key-ahead" aria-hidden="true"></span>
        <span class="label">Still to play, by date</span>
      </span>
    )}
  </div>
)}

<style>
  /* The detail is positioned against the STRIP, not the cell it belongs to.
     Centred on a cell it is a nowrap box far wider than the cell — 274px of
     "at Southern Nazarene · Thursday, September 17" over a 45px cell — and on
     an outer cell that pushed the document sideways even at opacity zero. The
     same trap as an absolutely positioned visually-hidden span: invisible is
     not the same as taking no space. Spanning the strip it cannot overflow,
     and it gives the reader one place to look instead of a moving one. */
  .strip { display: flex; gap: 7px; position: relative; }
  .cell {
    flex: 1 1 0;
    min-width: 0;
    display: flex; flex-direction: column; gap: 4px; align-items: center;
    padding: 8px 0 6px;
    border-bottom: 2px dashed var(--outline-quiet);
    color: inherit;
  }
  .cell-opp { font-size: 10px; font-weight: 600; color: var(--quiet); }
  .cell-line { font-size: 12px; color: var(--quiet); }
  /* "by forfeit" or "disputed": the opponent line's register, under the score. */
  .cell-mark { font-size: 9px; color: var(--quiet); letter-spacing: 0.06em; white-space: nowrap; }
  .cell:hover, .cell:focus-visible {
    background: var(--accent-wash-soft); border-radius: 5px 5px 0 0;
  }
  /* What the cell used to say through a title attribute alone. Read by a
     screen reader wherever it is, shown to a pointer or a keyboard on the
     cell it belongs to. */
  .cell-detail {
    position: absolute; left: 0; right: 0; top: calc(100% + 6px);
    z-index: 15;
    background: var(--ink); color: var(--paper);
    font-size: 12px; letter-spacing: 0.01em;
    padding: 4px 9px; border-radius: 4px;
    opacity: 0; pointer-events: none; transition: opacity 90ms ease-out;
  }
  .cell:hover .cell-detail, .cell:focus-visible .cell-detail { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .cell-detail { transition: none; } }
  .cell-W, .cell-D, .cell-L { border-bottom-style: solid; border-radius: 5px 5px 0 0; }
  .cell-W { border-bottom-color: var(--win); background: var(--win-wash); }
  .cell-D { border-bottom-color: var(--draw); background: var(--draw-wash); }
  .cell-L { border-bottom-color: var(--loss); background: var(--loss-wash); }
  .cell-W .cell-opp, .cell-D .cell-opp, .cell-L .cell-opp { color: var(--quiet); }
  .cell-W .cell-line, .cell-D .cell-line, .cell-L .cell-line {
    font-size: 13px; font-weight: 600; color: var(--ink);
  }
  .cell-silent { border-bottom-color: var(--loss); }
  .cell-silent .cell-line { color: var(--loss); }
  .cell-opener {
    border-bottom-color: var(--accent);
    background: var(--accent-wash-soft);
    border-radius: 5px 5px 0 0;
  }
  .cell-opener .cell-opp, .cell-opener .cell-line { color: var(--accent); font-weight: 600; }
  /* A cell is ~48px at desk width, and "GAC FINAL" is wider: the tag may
     break between its owner and its round rather than spill into the gutter. */
  .cell-stage { display: flex; justify-content: center; max-width: 100%; padding: 0 2px; }
  .cell-stage :global(.stage-chip) { white-space: normal; text-align: center; max-width: 100%; }

  /* The key, in the squad shape legend's register: a swatch drawn like the
     cell it explains, then a caps label. */
  .strip-key { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; margin-top: 10px; }
  .key-item { display: inline-flex; align-items: center; gap: 8px; }
  .key-swatch { width: 16px; height: 12px; border-radius: 3px 3px 0 0; border-bottom: 2px solid; }
  .key-opener { background: var(--accent-wash-soft); border-bottom-color: var(--accent); }
  .key-ahead { border-bottom: 2px dashed var(--outline-quiet); border-radius: 0; }
  .key-chips { display: inline-flex; }

  @media (max-width: 1180px) {
    .strip { flex-wrap: wrap; }
    .cell { flex: 0 0 calc(16.66% - 6px); }
  }
</style>
