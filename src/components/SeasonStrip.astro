---
// Every fixture a programme published, in order, each cell carrying either its
// result or its date. Nothing is dropped for want of a score: a silent final
// keeps its cell and says so in the loss colour.
//
// Each cell states its opponent and date through a title attribute alone.
// That is the hover-only-facts problem, and the disclosure that fixes it
// belongs on this component.
interface Cell {
  href: string;
  /** "vs Delta State · Saturday, August 27" */
  detail: string;
  opponent: string;
  /** The scoreline, or the date when there is not one. */
  line: string;
  result: "W" | "D" | "L" | null;
  isOpener: boolean;
  silent: boolean;
}
interface Props {
  cells: Cell[];
}
const { cells } = Astro.props;
---

<h2 class="sechead">SEASON</h2>
<div class="strip num">
  {cells.map((c) => (
    <a
      class={[
        "cell",
        c.result ? `cell-${c.result}` : "",
        c.isOpener ? "cell-opener" : "",
        c.silent ? "cell-silent" : "",
      ]
        .filter(Boolean)
        .join(" ")}
      href={c.href}
    >
      <span class="cell-opp">{c.opponent}</span>
      <span class="cell-line">{c.line}</span>
      <span class="cell-detail">{c.detail}</span>
    </a>
  ))}
</div>

<style>
  /* The detail is positioned against the STRIP, not the cell it belongs to.
     Centred on a cell it is a nowrap box far wider than the cell — 274px of
     "at Southern Nazarene · Thursday, September 17" over a 45px cell — and on
     an outer cell that pushed the document sideways even at opacity zero. The
     same trap as an absolutely positioned visually-hidden span: invisible is
     not the same as taking no space. Spanning the strip it cannot overflow,
     and it gives the reader one place to look instead of a moving one. */
  .strip { display: flex; gap: 7px; position: relative; }
  .cell {
    flex: 1 1 0;
    min-width: 0;
    display: flex; flex-direction: column; gap: 4px; align-items: center;
    padding: 8px 0 6px;
    border-bottom: 2px dashed var(--outline-quiet);
    color: inherit;
  }
  .cell-opp { font-size: 10px; font-weight: 600; color: var(--quiet); }
  .cell-line { font-size: 12px; color: var(--quiet); }
  .cell:hover, .cell:focus-visible {
    background: var(--accent-wash-soft); border-radius: 5px 5px 0 0;
  }
  /* What the cell used to say through a title attribute alone. Read by a
     screen reader wherever it is, shown to a pointer or a keyboard on the
     cell it belongs to. */
  .cell-detail {
    position: absolute; left: 0; right: 0; top: calc(100% + 6px);
    z-index: 15;
    background: var(--ink); color: var(--paper);
    font-size: 12px; letter-spacing: 0.01em;
    padding: 4px 9px; border-radius: 4px;
    opacity: 0; pointer-events: none; transition: opacity 90ms ease-out;
  }
  .cell:hover .cell-detail, .cell:focus-visible .cell-detail { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .cell-detail { transition: none; } }
  .cell-W, .cell-D, .cell-L { border-bottom-style: solid; border-radius: 5px 5px 0 0; }
  .cell-W { border-bottom-color: var(--win); background: var(--win-wash); }
  .cell-D { border-bottom-color: var(--draw); background: var(--draw-wash); }
  .cell-L { border-bottom-color: var(--loss); background: var(--loss-wash); }
  .cell-W .cell-opp, .cell-D .cell-opp, .cell-L .cell-opp { color: var(--quiet); }
  .cell-W .cell-line, .cell-D .cell-line, .cell-L .cell-line {
    font-size: 13px; font-weight: 600; color: var(--ink);
  }
  .cell-silent { border-bottom-color: var(--loss); }
  .cell-silent .cell-line { color: var(--loss); }
  .cell-opener {
    border-bottom-color: var(--accent);
    background: var(--accent-wash-soft);
    border-radius: 5px 5px 0 0;
  }
  .cell-opener .cell-opp, .cell-opener .cell-line { color: var(--accent); font-weight: 600; }

  @media (max-width: 1180px) {
    .strip { flex-wrap: wrap; }
    .cell { flex: 0 0 calc(16.66% - 6px); }
  }
</style>
