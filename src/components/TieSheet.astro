---
// The tie sheet: one postseason tie, over the page, like the player sheet.
//
// It opens on :target (#tie-…), so it is deep-linkable, survives a reload,
// closes with the back button and needs no script. Inside, two separate 44px
// links: trace a side's path (#path-…, which also closes the sheet, since
// only one fragment is the target), and the Match Centre.
//
// Every claim says how it is known. The score and a collected shootout are
// OBSERVED; a side known to have gone through only because it plays the next
// round is DERIVED; the round placement is DERIVED from the bracket's shape;
// the published round text prints verbatim, in italic, as published. A
// disputed tie prints each record's version and claims nothing.
//
// A tie still to play says what the records say of it: the kickoff and the
// ground as one page printed them, the host's where there is a host, with
// every other page named beside it rather than merged (two schedules can
// print one match in two local times). Each side's season record and last
// five, read from the file it is a member of, and each side's route here:
// its earlier ties in this tournament, each one a link to its own sheet.
import { clockTime, dayOfMonth, monShort } from "../lib/format.ts";
import { formOf, hasScore, matchHref, recordOf, resultFor } from "../lib/derive.ts";
import {
  type KickoffVersion,
  kickoffOf,
  roundNameOf,
  routeOf,
  sideSeasonOf,
  type Tie,
  tieAnchor,
  type Tournament,
} from "../lib/postseason.ts";
import FormBadges from "./FormBadges.astro";

interface Props {
  tie: Tie;
  tournament: Tournament;
  conferenceOf: ReadonlyMap<string, string>;
  /** Where closing returns to. */
  back: string;
}
const { tie, tournament, conferenceOf, back } = Astro.props;
const f = tie.fixture;
const names = tie.match.season.names;
const ROUND: Record<string, string> = {
  R1: "First round",
  R2: "Second round",
  R3: "Third round",
  QF: "Quarterfinal",
  SF: "Semifinal",
  FINAL: "Final",
};
const competition = tie.competition === "ncaa" ? "NCAA" : `${tournament.codes.join("/")} tournament`;
const round = tie.label ? (ROUND[tie.label] ?? `Round ${tie.label.slice(1)}`) : "Round not placed";
const when = `${["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][new Date(`${f.date}T12:00:00Z`).getUTCDay()]} ${monShort(f.date)} ${dayOfMonth(f.date)}`;
const scored = hasScore(f) && f.status === "final";
const sides = (["home", "away"] as const).map((side) => {
  const slug = side === "home" ? f.home : f.away;
  return {
    slug,
    name: names.name(slug),
    code: conferenceOf.get(slug) ?? "",
    goals: scored && !tie.disputed ? (side === "home" ? f.home_score : f.away_score) : null,
    pens: tie.shootout ? (side === "home" ? tie.shootout.home : tie.shootout.away) : null,
    state: tie.through ? (tie.through.slug === slug ? "w" : "l") : "",
  };
});
const nameOf = (slug: string): string => names.name(slug);
const throughLine = (() => {
  const t = tie.through;
  if (!t) return null;
  const who = nameOf(t.slug);
  if (t.by === "shootout" && tie.shootout) {
    const won = t.slug === f.home ? tie.shootout.home : tie.shootout.away;
    const lost = t.slug === f.home ? tie.shootout.away : tie.shootout.home;
    return { chip: "OBSERVED", text: `${who} won the shootout ${won}–${lost}, from the published result. The match is a draw in every record.` };
  }
  if (t.by === "score") return { chip: "OBSERVED", text: `${who} went through, from the published score.` };
  return {
    chip: "DERIVED",
    text: `${who} went through: no record of this tie names a winner, and ${who} plays the next round.`,
  };
})();
const published = [tie.source, tie.roundPublished, tie.resultPublished].filter(
  (x): x is string => typeof x === "string",
);

// The kickoff, for a tie still to play. One record printed, every other
// named: the time is never averaged or picked between silently.
const kickoff = (() => {
  if (scored || tie.disputed || f.status === "final") return null;
  const k = kickoffOf(tie);
  const who = (v: KickoffVersion): string => (v.by ? nameOf(v.by) : (v.source ?? "another schedule"));
  const p = k.primary;
  const venueFrom = p.venue ? null : ([...k.agree, ...k.differ].find((v) => v.venue) ?? null);
  const venue = p.venue ?? venueFrom?.venue ?? null;
  const time = clockTime(p.time ?? undefined);
  const lead = p.by
    ? `As published by ${nameOf(p.by)}${k.hosted ? ", the host" : ""}`
    : p.source
      ? `As published on ${p.source}`
      : "As published";
  const also = k.agree.length > 0 ? `, and by ${k.agree.map(who).join(" and ")}` : "";
  const notes = [
    `${lead}${also}.`,
    ...k.differ.map((v) => {
      const t = clockTime(v.time ?? undefined);
      return `${who(v)}'s schedule ${t ? `lists ${t}` : "lists no time"}.`;
    }),
    ...(venueFrom ? [`The ground is from ${who(venueFrom)}'s schedule.`] : []),
  ];
  return { time, venue, note: notes.join(" ") };
})();

// Each side's season and route, from the records the site holds.
const unplayed = kickoff !== null;
const columns = sides.map((s) => {
  const season = sideSeasonOf(tie, s.slug);
  const record = season ? recordOf(season, s.slug) : null;
  const route = routeOf(tournament, tie, s.slug).map((x) => {
    const xf = x.fixture;
    const home = xf.home === s.slug;
    const opponent = home ? xf.away : xf.home;
    const counted = hasScore(xf) && xf.status === "final" && !x.disputed;
    const pens = x.shootout
      ? home
        ? `${x.shootout.home}–${x.shootout.away}`
        : `${x.shootout.away}–${x.shootout.home}`
      : null;
    return {
      href: `#${tieAnchor(x)}`,
      round: x.label || "—",
      roundName: x.label ? roundNameOf(x.label) : "Round not placed",
      opponent: x.match.season.names.name(opponent),
      result: counted ? resultFor(xf, home ? "home" : "away") : null,
      score: counted ? `${home ? xf.home_score : xf.away_score}–${home ? xf.away_score : xf.home_score}` : null,
      pens,
      through: x.through?.slug === s.slug,
      disputed: x.disputed,
    };
  });
  return {
    ...s,
    record: record && record.played > 0 ? record : null,
    form: season && record && record.played > 0 ? formOf(season, s.slug) : [],
    followed: season !== null,
    route,
  };
});
const showCols = unplayed || columns.some((c) => c.route.length > 0);
const tournamentName = tie.competition === "ncaa" ? "NCAA tournament" : `${tournament.codes.join("/")} tournament`;
---

<div class="sheet tie-sheet" id={tieAnchor(tie)}>
  <a class="sheet-scrim" href={back} aria-label="Close the tie"></a>
  <div class="sheet-panel" role="dialog" aria-label={`${sides[0]?.name} v ${sides[1]?.name}`}>
    <div class="sh-lab">
      <span class="sh-labt">
        <span>{competition} · {round}</span>
        <span>{when}{!unplayed && f.venue ? ` · ${f.venue}` : ""}</span>
      </span>
      <a class="sheet-close" href={back} aria-label="Close">&times;</a>
    </div>

    {sides.map((s) => (
      <div class:list={["sh-side", s.state]}>
        <span class="n serif">{s.name}{s.code && <small>{s.code}</small>}</span>
        <span class="g serif num">
          {s.goals ?? ""}
          {s.pens !== null && <span class="pk">({s.pens})</span>}
        </span>
      </div>
    ))}

    {kickoff && (
      <div class="sh-kick">
        <span class="sh-kl">Not yet played · kickoff</span>
        <span class="sh-kv serif num">
          {kickoff.time ?? "No kickoff time published"}{kickoff.venue && <span class="sh-kvenue"> · {kickoff.venue}</span>}
        </span>
        <span class="sh-kp">{kickoff.note}</span>
      </div>
    )}
    {!scored && !tie.disputed && !kickoff && <p class="sh-note">Not yet played.</p>}

    {tie.disputed ? (
      <div class="sh-note">
        <span class="chip chip-context">Disputed</span>
        <span>Its records disagree, so this tie counts nowhere and no side is inferred to have gone through.</span>
        <ul class="versions">
          {tie.versions.map((v) => (
            <li>
              <b>{v.code}</b> · {v.phase}{v.competition ? ` (${v.competition})` : ""}
              {v.shootout ? ` · shootout to ${nameOf(v.shootout.winner)}` : ""}
              {v.published ? ` · "${v.published}"` : ""}
            </li>
          ))}
        </ul>
      </div>
    ) : (
      throughLine && (
        <p class="sh-note">
          <span class:list={["chip", throughLine.chip === "OBSERVED" ? "chip-observed" : "chip-derived"]}>
            {throughLine.chip === "OBSERVED" ? "OBSERVED ●●●" : "DERIVED ●●○"}
          </span>
          <span>{throughLine.text}</span>
        </p>
      )
    )}

    {!showCols && (
      <p class="sh-note">Both sides' first tie in the {tournamentName} on the record.</p>
    )}
    {showCols && <div class="sh-cols">
      {columns.map((c) => (
        <div class="sh-col">
          <span class="sh-h">{c.name}</span>
          {unplayed && (
            c.record ? (
              <div class="sh-rec">
                <span class="sh-fig num">{c.record.won}–{c.record.drawn}–{c.record.lost}</span>
                <span class="sh-cap">W–D–L</span>
                <span class="sh-form"><FormBadges form={c.form} /></span>
              </div>
            ) : (
              <span class="sh-none">
                {c.followed ? "No result collected this season." : "Not a programme this site follows: no season record."}
              </span>
            )
          )}
          <span class="sh-cap sh-rcap">Before this tie</span>
          {c.route.length === 0 ? (
            <span class="sh-none">First tie in the {tournamentName} on the record.</span>
          ) : (
            <ol class="sh-route">
              {c.route.map((r) => (
                <li>
                  <a href={r.href} aria-label={`${r.roundName} against ${r.opponent}: open the tie`}>
                    <span class="rr">{r.round}</span>
                    {r.result ? <span class={`wdl wdl-${r.result}`}>{r.result}</span> : <span class="wdl wdl-none" aria-hidden="true"></span>}
                    <span class="rs num">
                      {r.disputed ? "disputed" : (r.score ?? (r.through ? "through" : "—"))}
                      {r.pens && <span class="pk">({r.pens})</span>}
                    </span>
                    <span class="ro">v {r.opponent}</span>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </div>
      ))}
    </div>}
    {unplayed && columns.some((c) => c.record) && (
      <p class="sh-pub">Season records and last five from each programme's published results; a shootout is a draw.</p>
    )}

    {tie.label && (
      <p class="sh-note">
        <span class="chip chip-derived">DERIVED ●●○</span>
        <span>The round comes from the bracket's shape: each tie is one round before the next tie either side played.</span>
      </p>
    )}

    {published.length > 0 && (
      <p class="sh-pub">As published: {published.map((p, i) => (
        <>{i > 0 && " · "}"{p}"</>
      ))}</p>
    )}

    <div class="sh-actions">
      {sides.map((s) => (
        <a class="btn" href={`#path-${s.slug}`}>Trace {s.name}'s path</a>
      ))}
      <a class="btn primary" href={matchHref(tie.match.key, f.id)}>Match Centre →</a>
    </div>
  </div>
</div>

<script>
  // The player sheet's island, on the same terms (PlayerSheet.astro): the
  // sheet opens on :target and closes by leaving it, and with scripting off
  // that is the whole feature. This adds what a CSS overlay cannot do: focus
  // the panel on open, Escape to close (by the close link's own href, so it
  // leaves the history a click would), the keyboard held inside while the
  // panel is over the page, and handed back to the tie that opened it.
  //
  // aria-modal is claimed here, beside the trap that makes it true, and never
  // in the markup, where scripting off would make it a promise not kept.

  const FOCUSABLE = 'a[href], button, input, select, textarea, [tabindex]:not([tabindex="-1"])';

  const targeted = (): HTMLElement | null => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return null;
    const el = document.getElementById(id);
    return el?.classList.contains("tie-sheet") ? el : null;
  };
  const panelOf = (sheet: HTMLElement): HTMLElement | null => sheet.querySelector(".sheet-panel");

  /** The tie on the page that opened the sheet. A route link inside one sheet
   *  opens another without changing it, so the keyboard goes back to the
   *  bracket, not into a sheet that has closed. */
  let opener: HTMLElement | null = null;
  let live: HTMLElement | null = null;

  function enter(sheet: HTMLElement): void {
    const panel = panelOf(sheet);
    if (!panel) return;
    live = sheet;
    panel.setAttribute("aria-modal", "true");
    panel.setAttribute("tabindex", "-1");
    panel.focus();
  }

  function leave(restore: boolean): void {
    const panel = live && panelOf(live);
    live = null;
    if (panel) {
      panel.removeAttribute("aria-modal");
      panel.removeAttribute("tabindex");
    }
    if (!restore) return;
    if (opener && document.contains(opener)) opener.focus({ preventScroll: true });
    opener = null;
  }

  function sync(): void {
    const next = targeted();
    if (next === live) return;
    if (live) leave(next === null);
    if (next) enter(next);
  }

  document.addEventListener("click", (e) => {
    const link = (e.target as Element | null)?.closest?.('a[href^="#tie-"]');
    if (link && !link.closest(".tie-sheet")) opener = link as HTMLElement;
  });

  document.addEventListener("keydown", (e) => {
    if (!live) return;
    if (e.key === "Escape") {
      const close = live.querySelector<HTMLAnchorElement>(".sheet-close");
      location.hash = close?.getAttribute("href")?.slice(1) ?? "";
      return;
    }
    if (e.key !== "Tab") return;
    const panel = panelOf(live);
    if (!panel) return;
    const items = Array.from(panel.querySelectorAll(FOCUSABLE)) as HTMLElement[];
    const first = items[0];
    const last = items[items.length - 1];
    const active = document.activeElement;
    if (!first || !last) {
      e.preventDefault();
      panel.focus();
    } else if (!panel.contains(active)) {
      e.preventDefault();
      (e.shiftKey ? last : first).focus();
    } else if (e.shiftKey && (active === first || active === panel)) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  });

  window.addEventListener("hashchange", sync);
  sync();
</script>

<style>
  .sheet { position: fixed; inset: 0; z-index: 40; display: none; }
  .sheet:target { display: block; }
  .sheet-scrim { position: absolute; inset: 0; background: rgba(26, 28, 34, 0.32); }
  .sheet-panel {
    position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); z-index: 41;
    width: min(520px, 100vw); box-sizing: border-box; max-height: 90vh; overflow-y: auto;
    background: var(--paper); border-top: 2px solid var(--ink); border-radius: 12px 12px 0 0;
    padding: 18px max(16px, env(safe-area-inset-left, 0px)) calc(18px + env(safe-area-inset-bottom, 0px));
    display: grid; gap: 12px; color: var(--ink);
  }
  /* A bottom sheet is the phone's pattern, where the thumb is. With room to
     spare it is a card in the middle of the view, where the eye already is:
     docked at the foot of a desktop window it read as something left behind. */
  @media (min-width: 721px) {
    .sheet-panel {
      top: 50%; bottom: auto; transform: translate(-50%, -50%);
      max-height: min(90vh, 720px); border-radius: 12px; border: 1px solid var(--hairline);
      border-top: 2px solid var(--ink); padding: 20px 24px;
      box-shadow: 0 18px 48px rgba(26, 28, 34, 0.18);
    }
  }
  .sheet-panel:focus { outline: none; }
  .sh-kick { display: grid; gap: 3px; border-top: 1px solid var(--hairline); padding-top: 10px; }
  .sh-kl, .sh-h, .sh-cap {
    font-size: 10px; letter-spacing: 0.16em; font-weight: 600; color: var(--quiet); text-transform: uppercase;
  }
  .sh-kv { font-size: 20px; line-height: 1.25; }
  .sh-kvenue { font-size: 16px; color: var(--secondary); }
  .sh-kp { font-family: var(--serif); font-style: italic; font-size: 13px; line-height: 1.45; color: var(--quiet); }
  .sh-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 18px; border-top: 1px solid var(--hairline); padding-top: 10px; }
  .sh-col { display: grid; gap: 6px; align-content: start; min-width: 0; }
  .sh-h { color: var(--ink); letter-spacing: 0.1em; overflow-wrap: anywhere; }
  .sh-rec { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .sh-fig { font-family: var(--serif); font-size: 22px; line-height: 1; font-weight: 500; }
  .sh-form { margin-left: auto; }
  .sh-rcap { margin-top: 4px; }
  .sh-none { font-size: 12px; line-height: 1.45; color: var(--secondary); }
  .sh-route { list-style: none; margin: 0; padding: 0; display: grid; }
  .sh-route a {
    display: grid; grid-template-columns: auto auto auto minmax(0, 1fr); align-items: center; gap: 6px;
    min-height: 30px; border-top: 1px solid var(--hairline-soft); color: var(--ink); font-size: 12.5px;
  }
  .sh-route li:last-child a { border-bottom: 1px solid var(--hairline-soft); }
  .sh-route a:hover { background: var(--accent-wash-soft); }
  .sh-route a:focus-visible { outline: 1px solid var(--accent); outline-offset: -1px; }
  .sh-route .rr { font-size: 9.5px; letter-spacing: 0.08em; font-weight: 600; color: var(--quiet); min-width: 2.4em; }
  .sh-route .ro { line-height: 1.25; padding-block: 4px; overflow-wrap: break-word; min-width: 0; }
  .sh-route .rs { font-weight: 600; white-space: nowrap; }
  .wdl-none { background: none; border: 1px dashed var(--outline-quiet); }
  @media (pointer: coarse) {
    .sh-route a { min-height: 44px; }
  }
  @media (max-width: 380px) {
    .sh-cols { grid-template-columns: minmax(0, 1fr); }
  }
  .sh-labt { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 10px; flex: 1; min-width: 0; }
  .sh-lab {
    display: flex; justify-content: space-between; align-items: center; gap: 4px 10px;
    font-size: 10.5px; letter-spacing: 0.16em; font-weight: 600; color: var(--quiet); text-transform: uppercase;
  }
  .sheet-close {
    font-size: 16px; color: var(--quiet); line-height: 1; min-width: 44px; min-height: 44px;
    display: flex; align-items: center; justify-content: flex-end; margin: -12px -8px -12px auto;
  }
  .sh-side { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 10px; }
  .sh-side .n { font-size: 20px; }
  .sh-side .n small { font-family: var(--sans); font-size: 10px; letter-spacing: 0.1em; color: var(--quiet); margin-left: 6px; font-weight: 500; }
  .sh-side .g { font-size: 28px; }
  .sh-side.l .n, .sh-side.l .g { color: var(--secondary); font-weight: 400; }
  .pk { font-size: 0.6em; color: var(--quiet); margin-left: 3px; font-family: var(--sans); }
  .sh-note { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--secondary); display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
  .versions { margin: 0; padding-left: 18px; width: 100%; }
  .sh-pub { margin: 0; font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--quiet); }
  .sh-actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; }
  .btn {
    min-height: 44px; display: flex; align-items: center; justify-content: center; text-align: center;
    border: 1px solid var(--outline); border-radius: 6px; padding: 0 10px;
    font-size: 12.5px; color: var(--ink); background: var(--card);
  }
  .btn:hover { border-color: var(--ink); }
  .btn.primary { border-color: var(--accent); color: var(--accent); font-weight: 600; }
  .btn.primary:hover { background: var(--accent-wash); }
</style>
