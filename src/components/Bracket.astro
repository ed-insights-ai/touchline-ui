---
// The NCAA bracket, drawn from the results alone (no bracket document yet).
//
// Once results join a whole quarterfinal subtree, that subtree is a region,
// headed by the ground that hosted its quarterfinal (a fact from the
// fixtures) and ordered by the semifinal pairings. Connectors are drawn only
// between ties the results join.
//
// Until a region exists, the placed ties are one tree read left to right:
// each tie joined to the next tie its winner played, a tie whose sides both
// enter in a later round shown as such, and the trees the results have not
// yet joined stacked rather than paired. The rounds still to come are counts
// beside it, never lines: the page never draws a pairing it has not seen.
//
// Two densities from one markup. Wide, names and conference codes; at a
// phone's width the region keeps its shape in four ~77px columns of
// abbreviations, which never ellipsise.
import { dayOfMonth, monShort } from "../lib/format.ts";
import {
  aheadOf,
  layoutRegion,
  layoutTree,
  regionsOf,
  roundNameOf,
  type Tie,
  type Tournament,
  treesOf,
} from "../lib/postseason.ts";
import TieBox from "./TieBox.astro";

interface Props {
  tournament: Tournament;
  conferenceOf: ReadonlyMap<string, string>;
}
const { tournament, conferenceOf } = Astro.props;

const roundName = roundNameOf;
const day = (iso: string): string => `${monShort(iso)} ${dayOfMonth(iso)}`;
const span = (ties: readonly Tie[]): string => {
  const dates = [...new Set(ties.map((t) => t.fixture.date))].sort();
  const a = dates[0];
  const b = dates.at(-1);
  if (!a || !b) return "";
  return a === b ? day(a) : `${day(a)}–${a.slice(5, 7) === b.slice(5, 7) ? dayOfMonth(b) : day(b)}`;
};

const regions = regionsOf(tournament);
const laid = regions.map((r) => {
  const layout = layoutRegion(r);
  const labels = [...new Set([...r.ties].sort((a, b) => a.round - b.round).map((t) => t.label))];
  const programmes = new Set(r.ties.flatMap((t) => [t.fixture.home, t.fixture.away])).size;
  const ground = r.quarterfinal.fixture.venue ?? r.quarterfinal.match.season.names.name(r.quarterfinal.fixture.home);
  return { region: r, layout, labels, programmes, ground };
});
const inRegions = new Set(regions.flatMap((r) => r.ties));
// Ties no region holds, before the semifinals: listed by round, by date.
const loose = tournament.ties.filter(
  (t) => !inRegions.has(t) && t.label !== "SF" && t.label !== "FINAL",
);

// No region yet: the placed ties as trees, stacked on one grid whose columns
// are rounds, so a lone second-round tie sits beside the joined ones.
const placedLoose = laid.length === 0 ? loose.filter((t) => t.round > 0) : [];
const trees = treesOf(placedLoose);
const firstRound = placedLoose.length > 0 ? Math.min(...placedLoose.map((t) => t.round)) : 0;
const treeCols = trees.length > 0 ? Math.max(...trees.map((t) => t.root.round)) - firstRound + 1 : 0;
const treeCells: ReturnType<typeof layoutTree>["cells"] = [];
const enters: { col: number; row: number }[] = [];
let treeRows = 0;
for (const tree of trees) {
  const l = layoutTree(tree, firstRound);
  for (const c of l.cells) treeCells.push({ ...c, row: c.row + treeRows });
  // A tie with no tie behind it, past the first column: both sides start here.
  if (tree.ties.length === 1 && tree.root.round > firstRound) {
    enters.push({ col: tree.root.round - firstRound, row: treeRows + 1 });
  }
  treeRows += l.rows;
}
// Said once per run, not once per row: consecutive rows of one column whose
// ties both sides enter later share one note, and each row keeps only its
// dashed lead-in to the tie beside it.
const enterRuns: { col: number; row: number; span: number; label: string }[] = [];
for (const e of [...enters].sort((a, b) => a.col - b.col || a.row - b.row)) {
  const run = enterRuns.at(-1);
  if (run && run.col === e.col && run.row + run.span === e.row) run.span++;
  else enterRuns.push({ col: e.col, row: e.row, span: 1, label: "" });
}
for (const run of enterRuns) {
  const label = placedLoose.find((t) => t.round === firstRound + run.col)?.label ?? `R${firstRound + run.col}`;
  run.label = roundName(label).toLowerCase();
}
const treeHeads = Array.from({ length: treeCols }, (_, i) => {
  const ties = placedLoose.filter((t) => t.round === firstRound + i);
  return { label: ties[0]?.label ?? `R${firstRound + i}`, ties };
});

// Listed by round: with regions, the ties no region holds; without, only the
// ties the graph could not place.
const listed = laid.length > 0 ? loose : loose.filter((t) => t.round === 0);
const byRound = [...new Set(listed.map((t) => t.label || "—"))].map((label) => ({
  label,
  ties: listed.filter((t) => (t.label || "—") === label),
}));
const regionTabs = laid.map((l, i) => ({ id: `region-${i + 1}`, ground: l.ground }));

// The rounds still to come, as counts.
const ahead = aheadOf(tournament);
const aheadName = (label: string, n: number): string => {
  if (label === "QF") return n === 1 ? "quarterfinal" : "quarterfinals";
  if (label === "SF") return n === 1 ? "semifinal" : "semifinals";
  if (label === "FINAL") return "final";
  return `${roundName(label).toLowerCase().replace(" ", "-")} ${n === 1 ? "tie" : "ties"}`;
};
---

<div class="bracket">
  {laid.length > 0 && (
    <nav class="region-tabs" aria-label="Regions">
      {regionTabs.map((t) => <a href={`#${t.id}`}>{t.ground}</a>)}
    </nav>
  )}
  <div class="regions">
    {laid.map((l, i) => (
      <section class="region" id={`region-${i + 1}`}>
        <div class="region-head">
          <b>Quarterfinal at {l.ground}</b>
          <span class="num">{l.programmes} programs</span>
        </div>
        <div class="grid" style={`--cols:${l.layout.cols};--rows:${l.layout.rows}`}>
          {l.labels.map((label, c) => (
            <span class="rhead" style={`grid-column:${c + 1};grid-row:1`}>
              <span class="rl">{roundName(label)}</span><span class="rs">{label}</span>
              <small>{span(l.region.ties.filter((t) => t.label === label))}</small>
            </span>
          ))}
          {l.layout.cells.map((cell) => (
            <div
              class:list={["slot", { feeds: cell.feeds, direct: cell.feeds && cell.direct, joins: cell.joins !== null }]}
              style={`grid-column:${cell.col};grid-row:${cell.row + 1} / span ${cell.span}${cell.joins ? `;--jt:${(cell.joins.top * 100).toFixed(2)}%;--jb:${(100 - cell.joins.bottom * 100).toFixed(2)}%` : ""}`}
            >
              <TieBox tie={cell.tie} conferenceOf={conferenceOf} />
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
  {(trees.length > 0 || ahead.length > 0) && (
    <div class:list={["treewrap", { below: laid.length > 0 }]}>
      {trees.length > 0 && (
        <div class="grid tree" style={`--cols:${treeCols};--rows:${treeRows}`}>
          {treeHeads.map((h, c) => (
            <span class="rhead" style={`grid-column:${c + 1};grid-row:1`}>
              <span class="rl">{roundName(h.label)}</span><span class="rs">{h.label}</span>
              <small>{span(h.ties)}</small>
            </span>
          ))}
          {treeCells.map((cell) => (
            <div
              class:list={["slot", { feeds: cell.feeds, direct: cell.feeds && cell.direct, joins: cell.joins !== null }]}
              style={`grid-column:${cell.col};grid-row:${cell.row + 1} / span ${cell.span}${cell.joins ? `;--jt:${(cell.joins.top * 100).toFixed(2)}%;--jb:${(100 - cell.joins.bottom * 100).toFixed(2)}%` : ""}`}
            >
              <TieBox tie={cell.tie} conferenceOf={conferenceOf} />
            </div>
          ))}
          {enters.map((e) => (
            <span class="enter-lead" style={`grid-column:${e.col};grid-row:${e.row + 1}`} aria-hidden="true"></span>
          ))}
          {enterRuns.map((r) => (
            <span class="enter" style={`grid-column:${r.col};grid-row:${r.row + 1} / span ${r.span}`}>
              <b>Both sides enter here</b>
              <small>
                {r.span === 1
                  ? `The tie beside: both sides enter in the ${r.label}.`
                  : `The ${r.span} ties beside: both sides of each enter in the ${r.label}.`}
              </small>
            </span>
          ))}
        </div>
      )}
      {ahead.length > 0 && (
        <aside class="ahead" aria-label="Still to play">
          <span class="ah-head">Still to play</span>
          {ahead.map((a) => (
            <div class="ghost">
              <span><b class="num">{a.ties}</b> {aheadName(a.label, a.ties)}</span>
              <span class="pips" aria-hidden="true">{Array.from({ length: a.ties }, () => <i></i>)}</span>
            </div>
          ))}
          <p class="ah-note">Counts only: the pairings appear as the results do.</p>
        </aside>
      )}
    </div>
  )}
  {byRound.length > 0 && (
    <div class="loose">
      {laid.length > 0 && (
        <p class="loose-note">Ties the results do not yet join to a region, by round and date.</p>
      )}
      {byRound.map((g) => (
        <section class="bydate">
          <div class="region-head">
            <b>{g.label === "—" ? "Round not placed" : roundName(g.label)}</b>
            <span>{span(g.ties)}</span>
          </div>
          <div class="list">
            {g.ties.map((t) => (
              <div class="item">
                <TieBox tie={t} conferenceOf={conferenceOf} />
                {t.roundPublished && <span class="pub">"{t.roundPublished}"</span>}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  )}
</div>

<style>
  .bracket { --g: 32px; --fs: 12.5px; display: grid; gap: 28px; }
  .regions { display: grid; grid-template-columns: minmax(0, 1fr); gap: 34px; }
  .region { display: grid; gap: 10px; min-width: 0; scroll-margin-top: 16px; }
  .region-head {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline;
    gap: 4px 10px; border-bottom: 1px solid var(--ink); padding-bottom: 6px;
  }
  .region-head b { font-size: 11px; letter-spacing: 0.2em; font-weight: 600; text-transform: uppercase; }
  .region-head span { font-size: 11px; color: var(--quiet); letter-spacing: 0.06em; }
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-auto-rows: minmax(60px, auto);
    grid-template-rows: auto;
    column-gap: var(--g);
  }
  .rhead {
    font-size: 10px; letter-spacing: 0.14em; color: var(--quiet); font-weight: 600;
    text-transform: uppercase; align-self: end; padding-bottom: 6px;
  }
  .rhead small { display: block; letter-spacing: 0.06em; font-weight: 500; text-transform: none; font-size: 10.5px; }
  .rhead .rs { display: none; }
  .slot { position: relative; display: flex; align-items: center; min-width: 0; padding-block: 4px; }
  /* A line out to the right, half a gap; the tie it feeds draws the rest. */
  .slot.feeds::after {
    content: ""; position: absolute; right: calc(var(--g) / -2); top: 50%;
    width: calc(var(--g) / 2); border-top: 1px solid var(--outline-quiet);
  }
  .slot.direct::after { right: calc(var(--g) * -1); width: var(--g); }
  /* Where two ties feed one: a rule between their centres, then a stub in. */
  .slot.joins::before {
    content: ""; position: absolute; left: calc(var(--g) / -2);
    top: var(--jt, 25%); bottom: var(--jb, 25%); border-left: 1px solid var(--outline-quiet);
  }
  .slot.joins > :global(.tie)::before {
    content: ""; position: absolute; left: calc(var(--g) / -2); top: 50%;
    width: calc(var(--g) / 2); border-top: 1px solid var(--outline-quiet);
  }
  .region-tabs { display: none; }

  /* Before regions: the tree, and the rounds still to come beside it. */
  .treewrap { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 22px 32px; }
  .treewrap .tree { flex: 1 1 440px; min-width: 0; max-width: calc(var(--cols) * 300px); }
  /* A run of ties whose sides both start in a later column: one note for
     the run, set against a dashed bracket down the run's rows, and a dashed
     lead-in from the bracket to each tie. */
  .enter {
    display: flex; flex-direction: column; justify-content: center; align-items: flex-end; gap: 4px;
    padding: 0 14px 0 0; margin-block: 30px; text-align: right;
    border-right: 1px dashed var(--outline-quiet);
    color: var(--quiet); position: relative;
  }
  .enter b { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; }
  .enter small { font-size: 11.5px; line-height: 1.4; max-width: 22ch; }
  .enter-lead { position: relative; }
  .enter-lead::after {
    content: ""; position: absolute; right: calc(var(--g) * -1); top: 50%;
    width: var(--g); border-top: 1px dashed var(--outline-quiet);
  }
  .ahead {
    flex: 0 1 220px; display: grid; gap: 10px; position: sticky; top: 16px;
    border-left: 1px dashed var(--outline-quiet); padding-left: 18px;
  }
  .treewrap.below .ahead { flex-basis: 100%; border-left: 0; padding-left: 0; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); position: static; }
  .ah-head { font-size: 10px; letter-spacing: 0.14em; color: var(--quiet); font-weight: 600; text-transform: uppercase; padding-bottom: 6px; border-bottom: 1px solid var(--hairline); }
  .treewrap.below .ah-head, .treewrap.below .ah-note { grid-column: 1 / -1; }
  .ghost {
    display: grid; gap: 6px; border: 1px dashed var(--outline-quiet); border-radius: 6px;
    padding: 9px 11px; font-size: 12.5px; color: var(--secondary);
  }
  .ghost b { font-size: 16px; color: var(--ink); font-weight: 600; margin-right: 2px; }
  .pips { display: flex; gap: 3px; }
  .pips i { flex: 1; height: 7px; border: 1px dashed var(--outline-quiet); border-radius: 2px; }
  .ah-note { margin: 0; font-size: 11.5px; color: var(--quiet); font-style: italic; }

  .loose { display: grid; gap: 22px; }
  .loose-note { margin: 0; font-size: 12.5px; color: var(--secondary); }
  .bydate { display: grid; gap: 10px; }
  .bydate .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px 24px; }
  .bydate .item { display: grid; gap: 4px; }
  .pub { font-family: var(--serif); font-style: italic; font-size: 12px; color: var(--quiet); }

  /* A phone: the region keeps its shape, at compact density, and the four
     regions become tabs that jump to each. */
  @media (max-width: 720px) {
    .bracket { --g: 12px; --fs: 11.5px; }
    .grid { grid-auto-rows: minmax(56px, auto); }
    .rhead .rl, .rhead small { display: none; }
    .rhead .rs { display: inline; }
    .region-tabs {
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
      font-size: 10.5px; letter-spacing: 0.08em; font-weight: 600;
    }
    .region-tabs a {
      min-height: 44px; display: flex; align-items: center; justify-content: center;
      text-align: center; color: var(--secondary); border-bottom: 2px solid var(--hairline);
      overflow-wrap: anywhere; padding: 0 2px;
    }
    .region-tabs a:hover { color: var(--ink); }
    .regions :global(.tie), .tree :global(.tie) { --fs: 11.5px; }
    .ahead {
      flex-basis: 100%; border-left: 0; padding-left: 0; position: static;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ah-head, .ah-note { grid-column: 1 / -1; }
    .enter { padding-right: 8px; }
    .enter b { font-size: 9px; letter-spacing: 0.08em; }
    .enter small { font-size: 10.5px; }
  }
</style>

<script>
  // The compact density is a class, so that a region's abbreviations swap in
  // at the width a name stops fitting rather than at a guessed breakpoint.
  // Without script the media query above still gives the phone its layout;
  // the names then ellipsise instead of becoming abbreviations.
  const apply = (): void => {
    for (const grid of Array.from(document.querySelectorAll<HTMLElement>(".bracket .grid"))) {
      const cols = Number(getComputedStyle(grid).getPropertyValue("--cols")) || 4;
      grid.classList.toggle("compact", grid.clientWidth / cols < 150);
    }
  };
  apply();
  addEventListener("resize", apply);
</script>
