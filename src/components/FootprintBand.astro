---
// Where the collected season is played, on one map.
//
// What is drawn: a dot per programme town, every dot in one ink
// (--muted-mark, already a drawn mark on this site), and a label per region
// at the centroid of that region's dots, nudged by config so it clears them.
// Nothing is tinted. Six hues could not tell nineteen conferences apart and
// no palette honestly tells thirty, so a dot says "a programme plays here"
// and nothing else. No conference regions, no shaded states either: the
// leagues interleave on the ground, two of them have members a few miles
// apart, and any tinted territory would claim ground its conference does
// not hold.
//
// Conference labels left the map on Sep 1: the leagues interleave exactly
// where the ground is busiest, so a cluster label was ambiguous where it was
// needed most and every added conference made it worse. A region is broad
// enough to own its ground, so a region label is fine where a conference
// label was not. Regions and their label nudges are config (site.regions);
// byRegion/regionLabels do the grouping and this component never groups on
// its own.
//
// Hover is selection, and selection is purple. Hover a key row or a dot
// group and that conference's dots fill --accent while every other dot steps
// back; the hovered row takes the accent wash. CSS only, no JavaScript. The
// trade-off, accepted: at rest, interleaved conferences are told apart only
// by the key, and touch has no hover at all. A dot's own <title> still names
// its conference, so nothing is lost that was there before.
//
// Identity lives in the key beside the map, grouped under region heads in
// site.regions order, rows within a region in the order the page passes them.
// Purple is Touchline's and never a conference's.
//
// Every figure here is recomputed from the fixtures and the coordinates file.
// The band prints no fixture counts of its own. It answers where, and a
// played-and-scheduled tally answers how many; putting both in one band would
// make the map argue with the columns above it, which count the same season.
import { BASEMAP_VIEWBOX, STATE_OUTLINES } from "../lib/basemap.ts";
import { spell } from "../lib/format.ts";
import { type ConferenceFootprint, footprintOf, regionLabels } from "../lib/geo.ts";
import type { HomeColumn } from "../lib/home.ts";
import { byRegion } from "../lib/regions.ts";

interface Props {
  columns: readonly HomeColumn[];
  /** How many conferences play this sport at all — context, not a collected figure. */
  divisionConferences: number;
}
const { columns, divisionConferences } = Astro.props as Props;

const footprints: ConferenceFootprint[] = columns.map((c) =>
  footprintOf(
    c.key,
    c.code,
    c.name,
    c.season.fixtures.programmes.map((p) => ({ slug: p.slug, name: p.name })),
  ),
);

const placedCount = footprints.reduce((n, f) => n + f.placed.length, 0);
const unplaced = footprints.flatMap((f) => f.unplaced);
const states = [...new Set(footprints.flatMap((f) => f.states))].sort();
const labels = regionLabels(footprints);
const groups = byRegion(footprints);

// The hover rules are emitted unscoped, in one inline block, because the
// "row hover lights its dots" rule has to name the conference on both sides
// of the selector and so is built per footprint from data, never written for
// any conference. Astro's scoped block would add an attribute to every
// compound of its own selectors, so a scoped "step back" rule would outrank
// the data-built one; keeping all three hover rules together and unscoped
// lets plain specificity order them (step back 0,4,1 < group hover 0,5,1 <
// row hover 0,6,1) with no !important. The key lands inside an attribute
// selector unescaped, so it is held to the shape the config keys take.
const KEY_SHAPE = /^[a-z0-9-]+$/;
for (const f of footprints) {
  if (!KEY_SHAPE.test(f.key)) {
    throw new Error(
      `Touchline: conference key "${f.key}" is not [a-z0-9-], and the map's hover rule cannot carry it`,
    );
  }
}
const hoverCss = [
  // Hover anywhere that selects: every dot steps back...
  ".fp-body:has(.fp-row:hover) .fp-dots circle,.fp-body:has(.fp-dots:hover) .fp-dots circle{fill:#c9c5ba}",
  // ...then the hovered group comes forward...
  ".fp-body:has(.fp-dots:hover) .fp-dots:hover circle{fill:var(--accent);stroke-width:2}",
  // ...or the hovered row's group does.
  ...footprints.map(
    (f) =>
      `.fp-body:has(.fp-row[data-k="${f.key}"]:hover) .fp-dots[data-k="${f.key}"] circle{fill:var(--accent);stroke-width:2}`,
  ),
].join("\n");
---

<section class="footprint">
  <div class="fp-head">
    <h2 class="fp-sechead">THE DATA FOOTPRINT</h2>
    <div class="grow"></div>
    <div class="fp-scope num">
      <span>{placedCount} PROGRAMMES · {states.length} STATES</span>
      <span class="chip chip-context">{columns.length} OF {divisionConferences} CONFERENCES</span>
    </div>
  </div>

  <div class="fp-body">
    <div class="fp-map">
      <svg
        class="fp-svg"
        viewBox={`${BASEMAP_VIEWBOX.x} ${BASEMAP_VIEWBOX.y} ${BASEMAP_VIEWBOX.w} ${BASEMAP_VIEWBOX.h}`}
        role="img"
        aria-label={`Map of the lower 48 United States. ${placedCount} dots mark the towns of the programmes Touchline collects, across ${states.length} states in ${spell(columns.length)} conferences, labelled by region.`}
      >
        <g class="fp-land">
          {STATE_OUTLINES.map((s) => <path d={s.d} />)}
        </g>
        {footprints.map((f) => (
          <g class="fp-dots" data-k={f.key}>
            {f.placed.map((p) => (
              <circle cx={p.at.x} cy={p.at.y} r="5">
                <title>{p.name} — {p.city} ({f.code})</title>
              </circle>
            ))}
          </g>
        ))}
        {labels.map((l) => (
          <text class="fp-region" x={l.x} y={l.y} text-anchor="middle">
            {l.region.name.toUpperCase()}<tspan class="fp-region-n" dx="6">{l.conferences} · {l.programmes}</tspan>
          </text>
        ))}
      </svg>
    </div>

    <div class="fp-key">
      <div class="fp-keyhead">
        <span>CONFERENCE</span>
        <span class="grow"></span>
        <span>FARTHEST APART</span>
      </div>
      {groups.map((g) => (
        <>
          <div class="fp-region-head">
            <span>{g.region.name}</span>
            <span class="fp-rn">{g.items.length} {g.items.length === 1 ? "CONFERENCE" : "CONFERENCES"}</span>
          </div>
          {g.items.map((f) => (
            <div class="fp-row" data-k={f.key}>
              <span class="fp-code num">{f.code}</span>
              <span class="fp-name">{f.name}</span>
              <span class="fp-where num">
                {f.placed.length} {f.placed.length === 1 ? "programme" : "programmes"}
                {f.states.length > 0 && <> · {f.states.join(", ")}</>}
              </span>
              {f.widestGap !== null && (
                <span class="fp-gap num">{f.widestGap}<span class="fp-unit"> mi</span></span>
              )}
            </div>
          ))}
        </>
      ))}
      {unplaced.length > 0 && (
        <p class="fp-unplaced">
          {unplaced.map((u) => u.name).join(", ")}{" "}
          {unplaced.length === 1 ? "has" : "have"} no town on file, and {unplaced.length === 1 ? "is" : "are"} not drawn.
        </p>
      )}
    </div>
  </div>

</section>

<style is:inline set:html={hoverCss}></style>

<style>
  /* No closing rule. The band is the last section on the national page and
     .site-footer draws its own border-top, so a border-bottom here put two
     hairlines 28px apart with nothing between them. The footer closes the
     page; the section above it does not close it a second time. */
  .footprint {
    padding: 26px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .fp-head { display: flex; align-items: baseline; gap: 12px; }
  .fp-sechead { margin: 0; font-size: 11px; letter-spacing: 0.2em; font-weight: 600; }
  .fp-scope {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--quiet);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .fp-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    gap: 48px;
    align-items: start;
  }
  .fp-map { min-width: 0; }
  .fp-svg { display: block; width: 100%; height: auto; }
  /* The basemap is drawn a step off the paper, close enough that the land is
     a ground and not a figure. Both values follow the paper down (tui-3bz):
     held where they were, the coastline all but merged with the page. */
  .fp-land path { fill: #e9e5da; stroke: #d5d0c3; stroke-width: 1; stroke-linejoin: round; }
  /* One ink for every dot: a dot says "a programme plays here" and nothing
     else. --muted-mark is the away pip's value, already a drawn mark here. */
  .fp-dots circle {
    fill: var(--muted-mark);
    stroke: var(--paper);
    stroke-width: 1.6;
    transition: fill 0.12s;
  }
  /* Region labels live on the map because a region is wide enough to own its
     ground; a conference was not. Same register as the key's region head.
     The paper-coloured stroke under the letters keeps a label legible where
     it crosses a coastline. */
  .fp-region {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.16em;
    font-weight: 600;
    fill: var(--ink-soft);
    text-transform: uppercase;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .fp-region-n {
    font-size: 10px;
    letter-spacing: 0.1em;
    font-weight: 400;
    fill: var(--quiet);
  }
  /* Hover is selection, and selection is purple: hover a key row or a dot
     group and that conference's dots come forward while the rest step back.
     Those rules are the inline block above, emitted from data. */

  .fp-key { display: flex; flex-direction: column; }
  .fp-keyhead {
    display: flex;
    align-items: baseline;
    padding-bottom: 8px;
    font-size: 10px;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--quiet);
  }
  .fp-region-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 14px 0 4px;
    font-size: 10px;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--ink-soft);
    text-transform: uppercase;
  }
  .fp-region-head .fp-rn { font-weight: 400; letter-spacing: 0.1em; color: var(--quiet); }
  .fp-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: "code name gap" "where where gap";
    align-items: baseline;
    column-gap: 9px;
    row-gap: 3px;
    padding: 9px 0;
    border-bottom: 1px solid var(--hairline-soft);
    cursor: default;
  }
  .fp-row:hover { background: var(--accent-wash-soft); }
  .fp-row:hover .fp-code { color: var(--accent); }
  .fp-code { grid-area: code; font-size: 12.5px; font-weight: 600; letter-spacing: 0.06em; }
  .fp-name {
    grid-area: name;
    font-size: 12px;
    color: var(--quiet);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .fp-where { grid-area: where; font-size: 11.5px; color: var(--quiet); }
  .fp-gap { grid-area: gap; font-size: 15px; font-weight: 600; align-self: center; }
  .fp-unit { font-size: 10.5px; font-weight: 400; color: var(--quiet); }
  .fp-unplaced { margin: 10px 0 0; font-size: 14px; color: var(--quiet); line-height: 1.5; }

  @media (max-width: 1180px) {
    .fp-body { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .fp-key { max-width: 560px; }
  }
  @media (max-width: 720px) {
    .fp-head { flex-wrap: wrap; gap: 6px 12px; }
    .fp-scope { flex-wrap: wrap; gap: 6px 10px; }
    /* The SVG scales down with the column, so the label type steps up to
       stay readable at phone width. */
    .fp-region { font-size: 14px; }
    .fp-region-n { font-size: 12px; }
  }
</style>
