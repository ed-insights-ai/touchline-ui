---
// The season in one line: one mark per playing date, its weight the day's
// matches.
//
// The honesty this band has to keep is filled-vs-played. Ink means the date is
// IN THE BOOKS — passed, in the sporting idiom — not that its matches were
// played, and not that anyone published a score. The masthead strip carries
// the played figure, so the colour never has to imply something it cannot
// know. A date whose final was never scored wears a mark like any other and a
// score-gap dot beneath the axis: the score is the gap, not the match. That is
// a different absence from the masthead's box score gap, where the result is
// held and only its detail is missing.
//
// League dates take the league colour whether or not they have been played:
// they answer a different question from "has this date passed".
import { monLong } from "../lib/format.ts";
import { type Season, seasonWindow } from "../lib/derive.ts";
import { spineOf } from "../lib/schedule.ts";

interface Props {
  season: Season;
}
const { season } = Astro.props as Props;

const spine = spineOf(season);

// Mark height grows with the day's match count, from the same step the pixel
// reference uses: a one-match date is 16px, each further match adds 6.
const heightOf = (count: number): number => 16 + 6 * (count - 1);

const monthDay = (iso: string): string => `${monLong(iso)} ${Number(iso.slice(8, 10))}`;
const leagueFlag = spine?.leagueOpensOn
  ? `LEAGUE OPENS ${monLong(spine.leagueOpensOn).slice(0, 3).toUpperCase()} ${Number(spine.leagueOpensOn.slice(8, 10))}`
  : null;
// The TODAY flag carries how far along the season is, in matchweeks — the one
// fact the retired SEASON STORY band held that this line did not (owner's
// ruling, 2026-09-01). A matchweek is a Monday-to-Sunday span with a match —
// the docket's week, so the flag and the strip count the same days.
const window = seasonWindow(season);
const todayFlag = window.weekIndex ? `TODAY · WEEK ${window.weekIndex} OF ${window.weekCount}` : "TODAY";
// With both flags on the line they can meet — today within a fortnight of the
// opener — so each takes its own row: the league above, TODAY nearest the marks.
const twoRows = spine !== null && spine.todayAt !== null && spine.leagueOpensAt !== null;

---

{spine && (
  <section class="spine">
    <div class="sp-head">
      <h2 class="sp-title">THE SEASON — IN ONE LINE</h2>
      <div class="grow"></div>
      <div class="sp-legend">
        <span class="sp-key"><i class="sp-sw sp-gone"></i>in the books</span>
        <span class="sp-key"><i class="sp-sw sp-come"></i>to come</span>
        <span class="sp-key"><i class="sp-sw sp-league"></i>league dates</span>
        <span class="sp-key"><i class="sp-dot"></i>score gap</span>
      </div>
    </div>

    <div class={twoRows ? "sp-plot sp-plot-two" : "sp-plot"}>
      {spine.leagueOpensAt !== null && spine.leagueOpensOn && (
        <>
          <div class="sp-flag sp-flag-league" style={`left: ${(spine.leagueOpensAt * 100).toFixed(3)}%; transform: translateX(-${(spine.leagueOpensAt * 100).toFixed(3)}%);`}>{leagueFlag}</div>
          <div class="sp-rule sp-rule-league" style={`left: ${(spine.leagueOpensAt * 100).toFixed(3)}%;`}></div>
        </>
      )}
      {spine.todayAt !== null && (
        <>
          <div class="sp-flag sp-flag-today" style={`left: ${(spine.todayAt * 100).toFixed(3)}%; transform: translateX(-${(spine.todayAt * 100).toFixed(3)}%);`}>{todayFlag}</div>
          <div class="sp-rule sp-rule-today" style={`left: ${(spine.todayAt * 100).toFixed(3)}%;`}></div>
        </>
      )}
      <div class="sp-marks">
        {spine.marks.map((m) => (
          <>
            <div
              class={`sp-mark sp-${m.tone}`}
              style={`left: ${(m.at * 100).toFixed(3)}%; height: ${heightOf(m.count)}px;`}
            >
              <span class="vh">{monthDay(m.date)} — {m.count} {m.count === 1 ? "match" : "matches"}</span>
            </div>
            {m.silence && (
              <div class="sp-silence" style={`left: ${(m.at * 100).toFixed(3)}%;`}></div>
            )}
          </>
        ))}
      </div>
      <div class="sp-axis"></div>
      <div class="sp-months">
        {spine.months.map((mo) => (
          <div class="sp-month" style={`left: ${(mo.at * 100).toFixed(3)}%; transform: translateX(-${(mo.at * 100).toFixed(3)}%);`}>{mo.label}</div>
        ))}
      </div>
    </div>

    {/* No caption beneath the line. There was one — four sentences of counts
        keying the marks — and it was retired on the owner's reading: the
        legend above keys the marks, TODAY and LEAGUE OPENS sit on the line
        itself, and a reader can see the shape without being told it. */}

  </section>
)}

<style>
  .spine {
    padding: 20px 0 18px;
    border-bottom: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sp-head { display: flex; align-items: baseline; gap: 16px; }
  .sp-title { margin: 0; font-size: 11px; letter-spacing: 0.2em; font-weight: 600; }
  .sp-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 11px;
    color: var(--quiet);
    letter-spacing: 0.06em;
  }
  .sp-key { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
  .sp-sw { width: 8px; height: 8px; border-radius: 1px; display: inline-block; }
  .sp-gone, .sp-sw.sp-gone { background: var(--ink); }
  .sp-come, .sp-sw.sp-come { background: var(--light-future); }
  .sp-league, .sp-sw.sp-league { background: var(--accent); }
  .sp-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--silence); display: inline-block; }

  /* The plot is a fixed-height stage; everything inside is placed by percent,
     so the whole band scales to whatever width it is given. */
  .sp-plot { position: relative; height: 104px; padding: 0 4px; }
  .sp-marks { position: absolute; left: 0; right: 0; bottom: 22px; height: 66px; }
  .sp-mark {
    position: absolute;
    bottom: 0;
    width: 3px;
    margin-left: -1.5px;
    border-radius: 1px;
  }
  .sp-mark.sp-gone { background: var(--ink); }
  .sp-mark.sp-come { background: var(--light-future); }
  .sp-mark.sp-league { background: var(--accent); }
  .sp-silence {
    position: absolute;
    /* .sp-marks ends exactly on the axis, so a negative offset hangs the dot
       beneath it — the axis stays the line between what is drawn and what is
       said about it. */
    bottom: -8px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--silence);
  }
  .sp-axis { position: absolute; left: 0; right: 0; bottom: 22px; height: 1px; background: var(--hairline); }
  .sp-rule { position: absolute; top: 14px; bottom: 22px; width: 1px; }
  .sp-rule-today { background: var(--ink); }
  .sp-rule-league { background: var(--accent); opacity: 0.35; }
  /* Flags and month labels are pulled back by a share of their own width equal
     to how far right they sit, so a label at the end of the season ends at the
     edge instead of running past it. The shift is set inline, per label. */
  .sp-flag {
    position: absolute;
    top: 0;
    font-size: 10px;
    letter-spacing: 0.16em;
    font-weight: 600;
    white-space: nowrap;
  }
  .sp-flag-today { color: var(--ink); }
  .sp-flag-league { color: var(--accent); }
  /* Two flags, two rows: the plot grows by one row and TODAY's flag and rule
     step down onto it, so the flags never overprint however close the dates. */
  .sp-plot-two { height: 118px; }
  .sp-plot-two .sp-flag-today { top: 14px; }
  .sp-plot-two .sp-rule-today { top: 28px; }
  .sp-months { position: absolute; left: 0; right: 0; bottom: 0; height: 12px; }
  .sp-month {
    position: absolute;
    font-size: 10px;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--quiet);
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    /* Nothing moves and no mark is dropped; only the labels give way, because
       they are the part that stops resolving at this width. */
    /* The marks keep their full scale here too: a nine-match date is 64px
       tall, and a shorter stage would run it up into the flags. */
    .sp-plot { height: 100px; }
    .sp-plot-two { height: 118px; }
    .sp-marks { height: 66px; }
    .sp-flag { font-size: 10px; letter-spacing: 0.1em; }
    .sp-month { font-size: 10px; letter-spacing: 0.1em; }
    .sp-legend { font-size: 10px; gap: 3px 10px; }
  }
</style>
